---
import { buildBeginYourQuestUrl } from "../lib/leads/leadIntakeContext";

export interface Props {
  brand?: string;
  collection?: string;
  reference?: string;
  headline?: string;
  description?: string;
}

const { brand, collection, reference, headline, description } =
  Astro.props as Props;

const contextParts = [
  brand,
  collection,
  reference ? `Ref. ${reference}` : undefined,
].filter(Boolean);

const watchContext =
  contextParts.length > 0 ? contextParts.join(" ") : "your next watch";

const resolvedHeadline =
  headline ??
  (contextParts.length > 0
    ? `Private brokerage for ${watchContext}`
    : "Private watch brokerage, guided by Quest Luxo");

const resolvedDescription =
  description ??
  (contextParts.length > 0
    ? `Request, sell, trade, value, or discuss ${watchContext} with a Quest Luxo broker.`
    : "Request, sell, trade, value, or discuss a luxury watch with a Quest Luxo broker.");

const buildHref = (intent: string): string =>
  buildBeginYourQuestUrl({ intent, brand, collection, reference });

const ctaOptions = [
  {
    label: "Request This Watch",
    description: `Start a discreet sourcing request for ${watchContext}.`,
    href: buildHref("request"),
  },
  {
    label: "Sell Your Watch",
    description: "Share the piece you are considering selling privately.",
    href: buildHref("sell"),
  },
  {
    label: "Trade Your Watch",
    description: "Explore trade paths against your next acquisition.",
    href: buildHref("trade"),
  },
  {
    label: "Get a Market Valuation",
    description: "Request a private read on current market positioning.",
    href: buildHref("valuation"),
  },
  {
    label: "Talk to a Quest Luxo Broker",
    description: "Open a direct brokerage conversation with the Quest Luxo team.",
    href: buildHref("broker"),
  },
];
---

<section class="brokerage-cta" aria-label="Quest Luxo brokerage options">
  <div class="brokerage-cta__inner">
    <div class="brokerage-cta__intro">
      <p class="eyebrow">Quest Luxo Brokerage</p>
      <h2>{resolvedHeadline}</h2>
      <p>{resolvedDescription}</p>
    </div>

    <div class="brokerage-cta__grid">
      {
        ctaOptions.map((option) => (
          <a class="brokerage-cta__card" href={option.href}>
            <span>{option.label}</span>
            <small>{option.description}</small>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .brokerage-cta {
    background: #07111f;
    color: #ffffff;
    padding: 72px 24px;
  }

  .brokerage-cta__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 34px;
    align-items: start;
  }

  .eyebrow {
    color: #d4b06a;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  h2 {
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1;
    margin: 0 0 20px;
  }

  .brokerage-cta__intro p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.7;
    margin: 0;
    max-width: 700px;
  }

  .brokerage-cta__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .brokerage-cta__card {
    min-height: 136px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.045);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 20px;
    text-decoration: none;
    border-radius: 8px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .brokerage-cta__card:hover,
  .brokerage-cta__card:focus-visible {
    background: rgba(255, 255, 255, 0.075);
    border-color: rgba(212, 176, 106, 0.56);
    transform: translateY(-2px);
    outline: none;
  }

  .brokerage-cta__card span {
    color: #d4b06a;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brokerage-cta__card small {
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    line-height: 1.55;
  }

  .brokerage-cta__card:last-child {
    grid-column: 1 / -1;
    min-height: 112px;
  }

  @media (max-width: 900px) {
    .brokerage-cta__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .brokerage-cta {
      padding: 56px 18px;
    }

    .brokerage-cta__grid {
      grid-template-columns: 1fr;
    }

    .brokerage-cta__card:last-child {
      grid-column: auto;
    }
  }
</style>
