---
interface FilterOption {
  label: string;
  value: string;
}

interface SortOption {
  label: string;
  value: string;
}

interface Props {
  totalCount: number;
  collectionName: string;
  searchPlaceholder?: string;
  filters?: FilterOption[];
  sorts?: SortOption[];
}

const {
  totalCount,
  collectionName,
  searchPlaceholder = "Search by reference, nickname, material, bezel, or market position...",
  filters = [
    { label: "All", value: "all" },
    { label: "Current", value: "current" },
    { label: "Discontinued", value: "discontinued" },
    { label: "Oystersteel", value: "oystersteel" },
    { label: "Precious Metal", value: "precious-metal" },
    { label: "Two-Tone", value: "two-tone" },
    { label: "Peak Demand", value: "peak-demand" },
  ],
  sorts = [
    { label: "Highest Quest Luxo Score", value: "score-desc" },
    { label: "Highest Collector Demand", value: "demand-desc" },
    { label: "Highest Liquidity", value: "liquidity-desc" },
    { label: "Reference A-Z", value: "reference-asc" },
  ],
} = Astro.props as Props;
---

<div class="directory-tools" data-collection-toolbar>
  <input
    class="search-input"
    type="search"
    placeholder={searchPlaceholder}
    aria-label={`Search ${collectionName} references`}
    data-directory-search
    data-analytics-event="collection_search"
  />

  <div class="tool-row">
    <p class="result-count" aria-live="polite" data-directory-results>
      Showing {totalCount} references
    </p>

    <label class="sort-label">
      Sort
      <select data-directory-sort data-analytics-event="collection_sort">
        {sorts.map((sort) => (
          <option value={sort.value}>{sort.label}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="filters" aria-label={`${collectionName} reference filters`}>
    {filters.map((filter, index) => (
      <button
        class:list={["filter-button", { active: index === 0 }]}
        type="button"
        data-directory-filter={filter.value}
        data-analytics-event="collection_filter"
        data-analytics-label={filter.value}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        {filter.label}
      </button>
    ))}
  </div>
</div>

<style>
  .directory-tools {
    max-width: 980px;
    margin: -24px auto 42px;
    display: grid;
    gap: 16px;
  }

  .search-input {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #e8e3d8;
    background: #faf9f7;
    color: #173a5e;
    padding: 16px 18px;
    font-size: 15px;
    outline: none;
  }

  .search-input:focus {
    border-color: #d4b06a;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(212, 176, 106, 0.18);
  }

  .tool-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .result-count {
    color: #6d7480;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    margin: 0;
  }

  .sort-label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #173a5e;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .sort-label select {
    border: 1px solid #e8e3d8;
    background: #faf9f7;
    color: #173a5e;
    padding: 11px 12px;
    font-weight: 800;
  }

  .filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-button {
    cursor: pointer;
    border: 1px solid #e8e3d8;
    background: #faf9f7;
    color: #173a5e;
    border-radius: 999px;
    padding: 11px 17px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    font-size: 11px;
  }

  .filter-button.active,
  .filter-button:hover,
  .filter-button:focus-visible {
    background: #173a5e;
    border-color: #173a5e;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .filters {
      justify-content: flex-start;
    }

    .tool-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .sort-label {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
