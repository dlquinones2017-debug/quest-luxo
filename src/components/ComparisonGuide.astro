---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrokerageCTA from "./BrokerageCTA.astro";
import {
  comparisonSectionOrder,
  type ComparisonGuide as ComparisonGuideModel,
} from "../types/comparisonGuide";

interface Props {
  guide: ComparisonGuideModel;
}

const { guide } = Astro.props as Props;
const [left, right] = guide.participants;
---

<BaseLayout
  title={guide.seoTitle}
  description={guide.seoDescription}
  canonicalUrl={guide.canonicalPath}
>
  <main class="comparison-guide">
    <header class="comparison-hero">
      <p class="eyebrow">Quest Luxo Comparison Guide</p>
      <h1>{guide.title}</h1>
      <p>{guide.description}</p>
      <div class="comparison-hero__links" aria-label="Compared watches">
        <a href={left.href}>{left.label}</a>
        <span aria-hidden="true">versus</span>
        <a href={right.href}>{right.label}</a>
      </div>
      <p class="reviewed">Reviewed {guide.reviewedAt}</p>
    </header>

    <nav class="comparison-index" aria-label="Comparison guide sections">
      {
        comparisonSectionOrder.map((section, index) => (
          <a href={`#${section.id}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {section.title}
          </a>
        ))
      }
    </nav>

    <div class="comparison-sections">
      {
        comparisonSectionOrder.map((section, index) => {
          const content = guide.sections[section.id];
          return (
            <section
              id={section.id}
              class="comparison-section"
              data-comparison-section={section.id}
            >
              <header>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h2>{section.title}</h2>
                <p>{content.summary}</p>
              </header>
              {(content.left || content.right) && (
                <div class="comparison-pair">
                  {content.left && (
                    <article>
                      <h3>{left.label}</h3>
                      <p>{content.left}</p>
                    </article>
                  )}
                  {content.right && (
                    <article>
                      <h3>{right.label}</h3>
                      <p>{content.right}</p>
                    </article>
                  )}
                </div>
              )}
            </section>
          );
        })
      }
    </div>

    <aside class="comparison-evidence" aria-label="Comparison evidence">
      <p class="eyebrow">Evidence Reviewed</p>
      <h2>Sources and review basis</h2>
      <p>
        Official specifications establish product facts. Dated market sources
        support directional liquidity and retention observations, not future
        performance or guaranteed sale timing.
      </p>
      <div>
        {
          guide.evidenceSources.map((source) => (
            <a href={source.url} target="_blank" rel="noreferrer">
              {source.label}
            </a>
          ))
        }
      </div>
    </aside>

    <BrokerageCTA
      brand={guide.leadContext.brand}
      collection={guide.leadContext.collection}
      headline={`Continue the ${guide.title} conversation`}
      description="Share your wrist, use case, timing, and ownership priorities with Quest Luxo for a balanced comparison-led brokerage conversation."
    />
  </main>
</BaseLayout>

<style>
  .comparison-guide{background:#07111f;color:#fff;min-height:100vh}.comparison-hero,.comparison-index,.comparison-sections,.comparison-evidence{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}.comparison-hero{padding-top:96px;padding-bottom:48px}.eyebrow{color:#d4b06a;font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;margin:0 0 14px}.comparison-hero h1{font-size:clamp(46px,7vw,90px);line-height:.96;max-width:1040px;margin:0 0 24px}.comparison-hero>p:not(.eyebrow,.reviewed),.comparison-evidence>p:not(.eyebrow){color:rgba(255,255,255,.72);font-size:18px;line-height:1.7;max-width:820px}.comparison-hero__links{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:30px 0 18px}.comparison-hero__links a,.comparison-index a,.comparison-evidence a{color:#fff;text-decoration:none}.comparison-hero__links a{border-bottom:1px solid #d4b06a;padding-bottom:4px;font-weight:800}.comparison-hero__links span,.reviewed{color:rgba(255,255,255,.46);font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.comparison-index{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;padding-bottom:72px}.comparison-index a{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);font-size:13px;font-weight:800;padding:14px}.comparison-index a:hover,.comparison-index a:focus-visible{border-color:rgba(212,176,106,.56);color:#d4b06a;outline:none}.comparison-index span{color:#d4b06a;margin-right:8px}.comparison-sections{padding-bottom:72px}.comparison-section{border-top:1px solid rgba(255,255,255,.12);padding:64px 0;scroll-margin-top:24px}.comparison-section>header{max-width:850px}.comparison-section>header>span{color:#d4b06a;font-size:12px;font-weight:900;letter-spacing:.12em}.comparison-section h2,.comparison-evidence h2{font-size:clamp(32px,5vw,54px);line-height:1;margin:12px 0 18px}.comparison-section>header>p{color:rgba(255,255,255,.7);font-size:18px;line-height:1.7;margin:0}.comparison-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:28px}.comparison-pair article{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.1);padding:24px}.comparison-pair h3{color:#d4b06a;font-size:14px;letter-spacing:.08em;margin:0 0 14px;text-transform:uppercase}.comparison-pair p{color:rgba(255,255,255,.78);line-height:1.7;margin:0}.comparison-evidence{padding-top:64px;padding-bottom:88px;border-top:1px solid rgba(255,255,255,.12)}.comparison-evidence>div{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:24px}.comparison-evidence a{border-bottom:1px solid rgba(212,176,106,.5);font-size:14px;font-weight:800;padding-bottom:4px}@media(max-width:760px){.comparison-hero{padding-top:64px}.comparison-index{grid-template-columns:1fr}.comparison-pair{grid-template-columns:1fr}.comparison-section{padding:48px 0}}
</style>
