---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuestLuxoCollectionHero from "./QuestLuxoCollectionHero.astro";
import QuestLuxoCollectionSignals from "./QuestLuxoCollectionSignals.astro";
import QuestLuxoIntelligence from "./QuestLuxoIntelligence.astro";
import QuestLuxoDirectoryToolbar from "./QuestLuxoDirectoryToolbar.astro";
import QuestLuxoReferenceGrid from "./QuestLuxoReferenceGrid.astro";
import PrivateSourcingCTA from "./PrivateSourcingCTA.astro";
import {
  buildCollectionSignals,
  buildCollectionSummary,
} from "../lib/intelligence/collectionFactory";
import { brandPath, collectionPath } from "../lib/routes/collectionRoutes";
import type { CollectionDefinition } from "../data/collectionRegistry";

interface Props {
  collection: CollectionDefinition;
}

const { collection } = Astro.props as Props;
const summary = buildCollectionSummary(collection);
const signals = buildCollectionSignals(collection);
const basePath = collectionPath(collection.brandSlug, collection.slug);
const description = collection.description;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${collection.brand} ${collection.name}`,
    description,
    url: new URL(basePath, Astro.site ?? Astro.url.origin).href,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: collection.assets.length,
      itemListElement: collection.assets.map((asset, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: `${collection.brand} ${asset.model} ${asset.reference}`,
        url: new URL(
          `${basePath}/${encodeURIComponent(asset.reference.toLowerCase())}`,
          Astro.site ?? Astro.url.origin
        ).href,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site ?? Astro.url.origin).href },
      { "@type": "ListItem", position: 2, name: collection.brand, item: new URL(brandPath(collection.brandSlug), Astro.site ?? Astro.url.origin).href },
      { "@type": "ListItem", position: 3, name: collection.name, item: new URL(basePath, Astro.site ?? Astro.url.origin).href },
    ],
  },
];
---

<BaseLayout
  title={`${collection.brand} ${collection.name} | Quest Luxo`}
  description={description}
  canonicalPath={basePath}
  structuredData={structuredData}
>
  <main id="main-content" data-collection-experience data-collection-slug={collection.slug}>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href={brandPath(collection.brandSlug)}>{collection.brand}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{collection.name}</span>
    </nav>

    <QuestLuxoCollectionHero
      eyebrow={`${collection.brand.toUpperCase()} COLLECTION INTELLIGENCE`}
      title={collection.name}
      description={collection.description}
      stats={[
        { value: summary.totalAssets, label: "Tracked References" },
        { value: summary.currentReferences, label: "Current Production" },
        { value: summary.discontinuedReferences, label: "Discontinued Icons" },
        { value: summary.peakDemandReferences, label: "Peak Demand Signals" },
      ]}
    />

    <QuestLuxoIntelligence
      title={collection.intelligenceTitle}
      paragraphs={collection.intelligenceParagraphs}
    />

    <QuestLuxoCollectionSignals
      title={`Quest Luxo ${collection.name} Intelligence`}
      description={collection.signalsDescription}
      signals={signals}
    />

    <section class="assets" aria-labelledby="collection-directory-title">
      <div class="heading">
        <p class="eyebrow">ASSET DIRECTORY</p>
        <h2 id="collection-directory-title">{collection.name} Reference Profiles</h2>
        <p>{collection.directoryDescription}</p>
      </div>

      <QuestLuxoDirectoryToolbar
        totalCount={collection.assets.length}
        collectionName={collection.name}
      />

      <QuestLuxoReferenceGrid
        assets={collection.assets}
        basePath={basePath}
        collectionName={collection.name}
      />
    </section>

    <PrivateSourcingCTA
      title={`Request Private ${collection.name} Sourcing`}
      text={collection.sourcingText}
      button="Begin Your Quest"
      href={`/contact?collection=${encodeURIComponent(`${collection.brand} ${collection.name}`)}`}
    />
  </main>
</BaseLayout>

<style>
  .breadcrumbs {
    max-width: 1180px;
    margin: 0 auto;
    padding: 26px 30px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #6d7480;
    font-size: 13px;
  }

  .breadcrumbs a {
    color: #173a5e;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #d4b06a;
  }

  .assets {
    background: #ffffff;
    padding: 90px 60px 120px;
  }

  .heading {
    text-align: center;
    margin: 0 auto 55px;
    max-width: 820px;
  }

  .eyebrow {
    color: #d4b06a;
    letter-spacing: 4px;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .heading h2 {
    color: #173a5e;
    font-size: clamp(34px, 5vw, 46px);
    line-height: 1.1;
    margin: 0 0 18px;
  }

  .heading p {
    color: #4e5661;
    line-height: 1.75;
    font-size: 17px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .breadcrumbs {
      padding-inline: 22px;
      overflow-x: auto;
      white-space: nowrap;
    }

    .assets {
      padding: 70px 22px;
    }
  }
</style>
