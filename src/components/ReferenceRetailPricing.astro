---
import type { QuestLuxoAsset } from "../types/questLuxo";
import { formatRetailPrice, formatRetailTaxBasis, getVerifiedRetailPrices, formatRetailPriceLabel } from "../lib/intelligence/watchRetailPricing";

interface Props { asset: QuestLuxoAsset; brand?: string; }
const { asset, brand } = Astro.props as Props;
const prices = getVerifiedRetailPrices(asset, brand);
---

<section class="retail-pricing" aria-label="Manufacturer retail price">
  <p class="eyebrow">Reference pricing</p>
  <h2>MSRP &amp; retail benchmarks</h2>
  {prices.length ? prices.map((price) => (
    <article>
      <p><strong>{formatRetailPriceLabel(price)} {formatRetailPrice(price)} {price.currency}</strong> · {price.market} · {formatRetailTaxBasis(price)}</p>
      <p>{price.configuration} · {price.manufacturerReference}</p>
      {price.sourceType === "authorized-retailer" && <p>Recommended retail price (RRP) explicitly published by an authorized retailer. Direct manufacturer price confirmation remains unavailable.</p>}
      {price.sourceType === "manufacturer-submission" && <p>Historical manufacturer competition-entry retail price published by GPHG. The competition year identifies this archived benchmark; an exact price-effective day is not stated.</p>}
      {price.configurationScope === "base-reference" && <p>Base-reference retail benchmark. The price of the pictured configuration is not fully verified.</p>}
      <p>{formatRetailPriceLabel(price)} checked {price.checkedAt}.
        {price.effectiveDate && ` Manufacturer effective date: ${price.effectiveDate}.`}
        {!price.effectiveDate && price.effectivePeriod && ` Manufacturer price period: ${price.effectivePeriod}; finer effective date not stated.`}
        <a href={price.sourceUrl} target="_blank" rel="noopener noreferrer external">{price.sourceName}</a>
      </p>
      {price.basis === "historical-list" && <p>Historical benchmark only. Current MSRP and market value remain unverified; this amount is excluded from current-budget matching.</p>}
      {price.basis === "current-list" && (price.currency !== "USD" || price.market !== "United States") && <p>International retail benchmark in the original currency. U.S. MSRP remains unverified; this amount is excluded from U.S. budget matching.</p>}
    </article>
  )) : <p>A verified MSRP is not available in our records for this exact configuration. Request private sourcing for a quote.</p>}
  <p class="note">MSRP means manufacturer’s suggested retail price. RRP means recommended retail price, as published by an authorized retailer. These are retail benchmarks. Availability and the price of a specific new or pre-owned watch require a sourcing quote.</p>
</section>

<style>
  .retail-pricing { max-width: 1120px; margin: 60px auto; padding: 28px; border: 1px solid #e8e3d8; background: #faf9f7; color: #173a5e; }
  .eyebrow { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; }
  h2 { font-size: clamp(26px, 4vw, 38px); margin: 0 0 20px; }
  p { line-height: 1.65; }
  article + article { border-top: 1px solid #e8e3d8; padding-top: 14px; }
  a { color: #173a5e; margin-left: 6px; text-underline-offset: 3px; }
  .note { color: #56616d; font-size: 13px; margin-bottom: 0; }
</style>
