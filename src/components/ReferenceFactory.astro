---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrokerageCTA from "./BrokerageCTA.astro";
import BrokerageIntelligenceSection from "./BrokerageIntelligenceSection.astro";
import ReferenceCard from "./ReferenceCard.astro";
import type { QuestLuxoAsset } from "../types/questLuxo";
import { normalizeReferenceSlug } from "../lib/factory/referenceGenerator";

interface Props {
  brand: string;
  collection: string;
  assets: QuestLuxoAsset[];
  basePath: string;
  showBrokerageCTA?: boolean;
  seoTitle?: string;
  seoDescription?: string;
  canonicalUrl?: string;
}

const {
  brand,
  collection,
  assets,
  basePath,
  showBrokerageCTA = false,
  seoTitle,
  seoDescription,
  canonicalUrl,
} = Astro.props as Props;
const reference = Astro.params.reference ?? "";

const asset = assets.find(
  (candidate) =>
    candidate.reference === reference ||
    normalizeReferenceSlug(candidate.reference) === reference
);

if (!asset) {
  throw new Error(
    `Reference ${reference} was not found in ${brand} ${collection}.`
  );
}

const configurations = asset.configurations ?? [];
const brokerageIntelligence = asset.brokerageIntelligence;
const brokerageIntelligenceItems = brokerageIntelligence
  ? [
      ...(brokerageIntelligence.history
        ? [{ title: "History", body: brokerageIntelligence.history }]
        : []),
      {
        title: "Reference Overview",
        body: brokerageIntelligence.overview,
      },
      ...(brokerageIntelligence.innovations
        ? [{ title: "Innovations", body: brokerageIntelligence.innovations }]
        : []),
      ...(brokerageIntelligence.collectorAppeal
        ? [{ title: "Collector Appeal", body: brokerageIntelligence.collectorAppeal }]
        : []),
      {
        title: "Configuration Summary",
        body: brokerageIntelligence.configurationSummary,
      },
      ...(brokerageIntelligence.complications
        ? [{ title: "Complications", body: brokerageIntelligence.complications }]
        : []),
      ...(brokerageIntelligence.buyingConsiderations
        ? [{ title: "Buying Considerations", body: brokerageIntelligence.buyingConsiderations }]
        : []),
      {
        title: "Liquidity Observations",
        label: brokerageIntelligence.liquidityBand,
        body: brokerageIntelligence.liquidityObservations,
      },
      {
        title: "Service Considerations",
        label: `${brokerageIntelligence.serviceExposure} exposure`,
        body: brokerageIntelligence.serviceConsiderations,
      },
      {
        title: "Condition Considerations",
        label: `${brokerageIntelligence.ownershipComplexity} ownership complexity`,
        body: brokerageIntelligence.conditionConsiderations,
      },
      ...(brokerageIntelligence.ownershipExperience
        ? [{ title: "Ownership Experience", body: brokerageIntelligence.ownershipExperience }]
        : []),
      {
        title: "Market Commentary",
        body: brokerageIntelligence.marketCommentary,
      },
      {
        title: "Brokerage Opportunities",
        body: brokerageIntelligence.brokerageOpportunities,
      },
      {
        title: "Buyer Guidance",
        body: brokerageIntelligence.buyerGuidance,
      },
      {
        title: "Seller Guidance",
        body: brokerageIntelligence.sellerGuidance,
      },
      ...(brokerageIntelligence.relatedCollections
        ? [{ title: "Related Collections", body: brokerageIntelligence.relatedCollections }]
        : []),
      {
        title: "Quest Luxo Perspective",
        body: brokerageIntelligence.perspective,
      },
    ]
  : [];
const pageTitle = seoTitle ?? `${brand} ${asset.reference} | Quest Luxo`;
---

<BaseLayout
  title={pageTitle}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
>
  <main class="reference-page">
    <section class="hero">
      <a href={basePath} class="back-link">
        &larr; Back to {collection}
      </a>

      <p class="eyebrow">{brand} {collection} Reference</p>
      <h1>{brand} {asset.reference}</h1>
      <p>{asset.questLuxoView}</p>
    </section>

    <section class="profile">
      <ReferenceCard
        asset={asset}
        href={basePath}
        showIntelligenceProfile={!brokerageIntelligence}
        showMissingImagePlaceholder={true}
        showMsrp={!brokerageIntelligence}
        linkLabel={`Back to ${collection}`}
      />

      <div class="details-panel">
        <p class="eyebrow">Asset Profile</p>
        <h2>{asset.model}</h2>

        <div class="specs">
          <p><strong>Brand</strong><span>{brand}</span></p>
          <p><strong>Collection</strong><span>{collection}</span></p>
          <p><strong>Reference</strong><span>{asset.reference}</span></p>
          <p><strong>Material</strong><span>{asset.material ?? "Research Pending"}</span></p>
          <p><strong>Bezel</strong><span>{asset.bezel ?? "Research Pending"}</span></p>
          <p><strong>Production</strong><span>{asset.productionStatus ?? "Research Pending"}</span></p>
          <p><strong>Liquidity</strong><span>{asset.liquidity ?? "Research Pending"}</span></p>
          <p><strong>Allocation</strong><span>{asset.allocationDifficulty ?? "Research Pending"}</span></p>
        </div>

        {configurations.length > 0 && (
          <div class="configurations">
            <h3>Known Configurations</h3>

            {configurations.map((configuration) => (
              <div>
                <strong>{configuration.nickname ?? "Configuration"}</strong>
                <span>
                  {[
                    configuration.caseSize,
                    configuration.movement,
                    configuration.bracelet,
                    configuration.dial,
                    configuration.waterResistance,
                  ]
                    .filter(Boolean)
                    .join(" \u00b7 ")}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    {
      asset.collectorNotes && (
        <section class="collector-notes">
          <p class="eyebrow">Collector Notes</p>
          <h2>What distinguishes this reference</h2>
          <p>{asset.collectorNotes}</p>
        </section>
      )
    }

    {
      brokerageIntelligence && (
        <BrokerageIntelligenceSection
          eyebrow="Priority Reference Intelligence"
          title={`${brand} ${asset.reference} Brokerage Intelligence`}
          intro="A decision-focused view of configuration, liquidity, ownership, and transaction considerations. Example-specific inspection remains essential."
          items={brokerageIntelligenceItems}
          reviewedAt={brokerageIntelligence.reviewedAt}
          evidenceSources={brokerageIntelligence.evidenceSources}
        />
      )
    }

    {
      showBrokerageCTA && (
        <BrokerageCTA
          brand={brand}
          collection={collection}
          reference={asset.reference}
          headline={`Looking for ${brand} ${asset.reference}?`}
          description={`Source, sell, trade, or value this ${brand} ${collection} ${asset.reference} with discreet guidance from Quest Luxo brokerage.`}
        />
      )
    }
  </main>
</BaseLayout>

<style>
  .reference-page {
    background: #07111f;
    color: #ffffff;
    min-height: 100vh;
  }

  .hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 80px 24px 40px;
  }

  .back-link {
    display: inline-block;
    color: #d4b06a;
    text-decoration: none;
    font-weight: 800;
    margin-bottom: 28px;
  }

  .eyebrow {
    color: #d4b06a;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  h1 {
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.95;
    margin: 0 0 24px;
  }

  h2 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1;
    margin: 0 0 24px;
  }

  h3 {
    color: #173a5e;
    margin: 0 0 16px;
  }

  .hero p {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.7;
  }

  .profile {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 24px 96px;
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .collector-notes {
    max-width: 1132px;
    margin: 0 auto 72px;
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.045);
  }

  .collector-notes p:not(.eyebrow) {
    max-width: 820px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.7;
  }

  .details-panel {
    background: #faf9f7;
    color: #173a5e;
    border: 1px solid #e8e3d8;
    padding: 32px;
  }

  .specs {
    display: grid;
    gap: 12px;
  }

  .specs p {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid #e8e3d8;
    padding-bottom: 10px;
    margin: 0;
  }

  .specs span {
    color: #4e5661;
    text-align: right;
  }

  .configurations {
    margin-top: 32px;
  }

  .configurations div {
    border: 1px solid #eee8dc;
    background: #ffffff;
    padding: 16px;
    margin-bottom: 10px;
  }

  .configurations strong {
    display: block;
    margin-bottom: 6px;
  }

  .configurations span {
    color: #4e5661;
  }

  @media (max-width: 900px) {
    .profile {
      grid-template-columns: 1fr;
    }
  }
</style>
