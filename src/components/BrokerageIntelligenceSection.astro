---
import type {
  BrokerageEvidenceSource,
  BrokerageIntelligenceItem,
} from "../types/brokerageIntelligence";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: readonly BrokerageIntelligenceItem[];
  reviewedAt?: string;
  evidenceSources?: readonly BrokerageEvidenceSource[];
}

const {
  eyebrow = "Brokerage Intelligence",
  title,
  intro,
  items,
  reviewedAt,
  evidenceSources = [],
} = Astro.props as Props;
---

<section class="brokerage-intelligence">
  <div class="brokerage-intelligence__inner">
    <header class="brokerage-intelligence__header">
      <p class="brokerage-intelligence__eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {intro && <p>{intro}</p>}
      {reviewedAt && (
        <p class="brokerage-intelligence__reviewed">Reviewed {reviewedAt}</p>
      )}
    </header>

    <div class="brokerage-intelligence__grid">
      {
        items.map((item) => (
          <article class="brokerage-intelligence__item">
            {item.label && <span>{item.label}</span>}
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>

    {
      evidenceSources.length > 0 && (
        <footer class="brokerage-intelligence__sources">
          <strong>Evidence reviewed</strong>
          <div>
            {evidenceSources.map((source) => (
              <a href={source.url} target="_blank" rel="noreferrer">
                {source.label}
              </a>
            ))}
          </div>
        </footer>
      )
    }
  </div>
</section>

<style>
  .brokerage-intelligence {
    background: #f5f2eb;
    color: #173a5e;
    padding: 76px 24px;
  }

  .brokerage-intelligence__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .brokerage-intelligence__header {
    max-width: 820px;
    margin-bottom: 34px;
  }

  .brokerage-intelligence__eyebrow {
    color: #9b722b;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  h2 {
    color: #173a5e;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1;
    margin: 0 0 18px;
  }

  .brokerage-intelligence__header > p:not(.brokerage-intelligence__eyebrow, .brokerage-intelligence__reviewed) {
    color: #4e5661;
    font-size: 18px;
    line-height: 1.7;
    margin: 0;
  }

  .brokerage-intelligence__reviewed {
    color: #6b737c;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 16px 0 0;
  }

  .brokerage-intelligence__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .brokerage-intelligence__item {
    background: #ffffff;
    border: 1px solid #e1dbcf;
    padding: 26px;
  }

  .brokerage-intelligence__item span {
    display: inline-block;
    color: #9b722b;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  h3 {
    color: #173a5e;
    font-size: 23px;
    line-height: 1.15;
    margin: 0 0 12px;
  }

  .brokerage-intelligence__item p {
    color: #4e5661;
    line-height: 1.7;
    margin: 0;
  }

  .brokerage-intelligence__sources {
    border-top: 1px solid #d9d1c3;
    margin-top: 28px;
    padding-top: 20px;
  }

  .brokerage-intelligence__sources strong {
    display: block;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .brokerage-intelligence__sources div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .brokerage-intelligence__sources a {
    color: #173a5e;
    font-size: 14px;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .brokerage-intelligence {
      padding: 58px 18px;
    }

    .brokerage-intelligence__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
