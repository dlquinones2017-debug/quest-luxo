---
import type { QuestLuxoAsset } from "../types/questLuxo";
import { watchPhotographs } from "../data/watch-photography";
import { approvedPhotograph } from "../lib/media/watchPhotography";
import { getVerifiedRetailPrices, getRetailPriceSummary, formatRetailPrice, formatRetailTaxBasis } from "../lib/intelligence/watchRetailPricing";
import { buildBeginYourQuestUrl } from "../lib/leads/leadIntakeContext";
interface Props {
  asset: QuestLuxoAsset; href: string; brand?: string; collection?: string;
  showIntelligenceProfile?: boolean; showMissingImagePlaceholder?: boolean;
  showMsrp?: boolean; linkLabel?: string;
}
const { asset, href, brand = asset.brand ?? "", collection = asset.collection ?? "", showIntelligenceProfile = true,
  showMissingImagePlaceholder = true, showMsrp = true, linkLabel = "View reference" } = Astro.props as Props;
const displayReference = asset.displayReference ?? asset.reference;
const configurations = asset.configurations ?? [];
const photograph = approvedPhotograph(asset, watchPhotographs);
const referenceSource = asset.specificationSources?.find(source => source.url.startsWith("https://"))?.url;
const primary = configurations.find(c => photograph && c.dial === photograph.configuration.dial && c.bracelet === photograph.configuration.bracelet) ?? configurations[0];
const prices = getVerifiedRetailPrices(asset, brand);
const retail = getRetailPriceSummary(prices);
const sourcingUrl = buildBeginYourQuestUrl({ intent: "request-this-watch", brand, collection, reference: asset.reference });
---
<article class="card">
  {(photograph || showMissingImagePlaceholder) && <div class="image-card">
    {photograph ? (
      <a href={href} aria-label={`Explore ${brand} ${displayReference}`}><img src={photograph.src} alt={photograph.alt} width="960" height="960" loading="lazy" decoding="async" /></a>
    ) : (
      <div class="pending-photo"><span>Authentic photography pending</span>{referenceSource && <a href={referenceSource} target="_blank" rel="noopener noreferrer nofollow">View reference source →</a>}</div>
    )}
  </div>}
  <div class="card-body">
    <p class="model">{brand} · {asset.model}</p>
    <h3><a href={href}>Ref. {displayReference}</a></h3>
    {primary?.nickname && primary.nickname !== displayReference && primary.nickname !== `${primary.dial} / ${primary.bracelet}` && <p class="nickname">{primary.nickname}</p>}
    <p class="configuration">{[primary?.caseSize, primary?.dial, primary?.bracelet].filter(Boolean).join(" · ")}</p>
    <div class="tags">{asset.productionStatus && <span>{asset.productionStatus}</span>}{asset.material && <span>{asset.material}</span>}</div>
    {showMsrp && <div class="retail">
      {retail ? <>
        <strong>{retail.price.basis === "historical-list" ? "Historical list" : "Published list"} {retail.hasRange ? "from " : ""}{formatRetailPrice(retail.price)}</strong>
        <span>{retail.price.currency} · {retail.price.market} · {formatRetailTaxBasis(retail.price)}</span>
        {retail.price.basis === "current-list" && (retail.price.currency !== "USD" || retail.price.market !== "United States") && <span>International list benchmark; U.S. list price unverified.</span>}
        {retail.price.basis === "historical-list" && <span>Manufacturer price period: {retail.price.effectiveDate ?? retail.price.effectivePeriod ?? "Date unconfirmed"}. Current list price unverified.</span>}
        {retail.price.configurationScope === "base-reference" && <span>Base-reference benchmark; pictured configuration not fully priced.</span>}
        <a href={retail.price.sourceUrl} target="_blank" rel="noopener noreferrer external">{retail.price.sourceName} · checked {retail.price.checkedAt}</a>
        <span>{prices.length > 1 ? "Configuration-specific prices in reference profile." : retail.price.configuration} List benchmark; sourcing quote confirmed separately.</span>
      </> : <span>List price unverified. Request a sourcing quote.</span>}
    </div>}
    <div class="actions"><a class="button" href={href}>{linkLabel}</a>{showMsrp && <a class="source-link" href={sourcingUrl}>Source this watch →</a>}</div>
    <details>
      <summary>Specifications &amp; advisory notes</summary>
      <dl>
        {primary?.movement && <><dt>Movement</dt><dd>{primary.movement}</dd></>}
        {primary?.waterResistance && <><dt>Water resistance</dt><dd>{primary.waterResistance}</dd></>}
        {asset.bezel && <><dt>Bezel</dt><dd>{asset.bezel}</dd></>}
        {asset.marketPosition && <><dt>Market position</dt><dd>{asset.marketPosition}</dd></>}
        {asset.liquidity && <><dt>Liquidity assessment</dt><dd>{asset.liquidity}</dd></>}
        {asset.allocationDifficulty && <><dt>Allocation assessment</dt><dd>{asset.allocationDifficulty}</dd></>}
      </dl>
      {configurations.length > 1 && <><h4>Documented configurations</h4><ul>{configurations.map(c => <li>{[c.nickname, c.dial, c.bracelet, c.caseSize].filter(Boolean).join(" · ")}</li>)}</ul></>}
      {showIntelligenceProfile && asset.questLuxoView && <p>{asset.questLuxoView}</p>}
      <p class="note">Advisory observations are qualitative. Availability, condition and transaction pricing require confirmation.</p>
    </details>
  </div>
</article>
<style>
.card{height:100%;background:#fff;color:#173a5e;border:1px solid #e8e3d8;overflow:hidden;display:flex;flex-direction:column}
.image-card{display:grid;place-items:center;aspect-ratio:1;background:#fff;overflow:hidden}.image-card>a{display:block;width:100%;height:100%}.image-card img{display:block;width:100%;height:100%;object-fit:contain}
.pending-photo{padding:24px;text-align:center;color:#596471;display:grid;gap:12px}.pending-photo a{color:#173a5e}.card-body{padding:22px;display:flex;flex-direction:column;gap:12px;flex:1;min-width:0}
p,h3,h4{margin:0}.model{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#596471;line-height:1.6}
h3{font-size:23px;overflow-wrap:anywhere}h3 a{color:inherit;text-decoration:none}.nickname{font-size:15px;font-weight:600}.configuration{font-size:13px;line-height:1.6;color:#596471}
.tags{display:flex;flex-wrap:wrap;gap:6px}.tags span{font-size:11px;padding:5px 8px;background:#f4f2ed}.retail{display:grid;gap:5px;padding:14px 0;border-top:1px solid #e8e3d8;font-size:12px;line-height:1.6}
.retail strong{font-size:16px}.retail span{color:#596471}.retail a,.source-link{color:#173a5e;text-underline-offset:3px}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:auto;font-size:13px}
.button{display:inline-flex;justify-content:center;padding:13px 16px;background:#173a5e;color:#fff;text-decoration:none;font-weight:600}
details{border-top:1px solid #e8e3d8;padding-top:14px;font-size:13px;line-height:1.7}summary{cursor:pointer;font-weight:600;min-height:32px}dl{display:grid;grid-template-columns:1fr 1fr;gap:8px}dt{font-weight:600}dd{margin:0;overflow-wrap:anywhere}
ul{padding-left:18px}.note{font-size:11px;color:#596471;margin-top:12px}a:focus-visible,summary:focus-visible{outline:3px solid #b68a40;outline-offset:3px}
</style>
