---
---

<header class="navbar">
  <a
    href="/"
    class="brand-logo"
    data-analytics-event="navigation"
    data-analytics-label="home"
  >
    <img
      src="/images/quest-luxo-logo.webp"
      alt="Quest Luxo"
      class="logo"
      width="160"
      height="160"
      decoding="async"
      fetchpriority="high"
    />
  </a>

  <nav aria-label="Primary navigation">
    <a href="/#collections" data-analytics-event="navigation" data-analytics-label="collections">
      Collections
    </a>
    <a href="/about" data-analytics-event="navigation" data-analytics-label="about">
      About
    </a>
    <a
      href="/transaction-standards"
      data-analytics-event="navigation"
      data-analytics-label="transaction-standards"
    >
      Standards
    </a>
    <a
      href="/contact"
      data-analytics-event="navigation"
      data-analytics-label="private-sourcing"
    >
      Private Sourcing
    </a>
  </nav>
</header>

<style>
  .navbar {
    padding: 24px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border-bottom: 1px solid #ececec;
  }

  .brand-logo {
    display: flex;
    align-items: center;
  }

  .logo {
    height: 60px;
    width: 60px;
    display: block;
  }

  .brand {
    font-family: Georgia, serif;
    font-size: 28px;
    color: #173a5e;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #1f1f1f;
    text-decoration: none;
    font-size: 15px;
  }

  nav a:hover {
    color: #76540f;
  }

  @media (max-width: 800px) {
    .navbar {
      padding: 22px;
      flex-direction: column;
      gap: 18px;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 16px;
    }
  }
</style>
