<style>
  .navbar {
    padding: 24px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border-bottom: 1px solid #ececec;
  }.brand-logo {
  display: flex;
  align-items: center;
}

.logo {
  height: 60px;
  width: auto;
  display: block;
}

  .brand {
    font-family: Georgia, serif;
    font-size: 28px;
    color: #173a5e;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #1f1f1f;
    text-decoration: none;
    font-size: 15px;
  }

  nav a:hover {
    color: #d4b06a;
  }

  @media (max-width: 800px) {
    .navbar {
      padding: 22px;
      flex-direction: column;
      gap: 18px;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }
