---
import { buildBeginYourQuestUrl } from "../lib/leads/leadIntakeContext";

const brands = [
  "Rolex",
  "Patek Philippe",
  "Audemars Piguet",
  "Richard Mille",
  "Vacheron Constantin",
  "F.P. Journe",
  "Cartier",
  "Omega",
  "Tudor",
  "Panerai",
  "Breitling",
  "IWC",
];

const privateSourcingHref = buildBeginYourQuestUrl({ intent: "request" });
const brokerContactHref = buildBeginYourQuestUrl({ intent: "broker" });
---

<header class="navbar">
  <a href="/" class="brand-logo">
  <img src="/images/quest-luxo-logo.png" alt="Quest Luxo" class="logo" />
</a>

  <nav>
    <a href="/collections">Collections</a>
    <a href={privateSourcingHref}>Private Sourcing</a>
    <a href="/#services">Services</a>
    <a href={brokerContactHref}>Contact</a>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 88px;
    padding: 14px clamp(22px, 5vw, 68px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid #e8e3d8;
    backdrop-filter: blur(14px);
  }

  .brand-logo {
    display: flex;
    align-items: center;
  }

  .logo {
    height: 58px;
    width: auto;
    display: block;
  }

  .brand {
    font-family: Georgia, serif;
    font-size: 28px;
    color: #173a5e;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    position: relative;
    color: #173a5e;
    text-decoration: none;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav a:hover,
  nav a:focus-visible {
    color: #d4b06a;
  }

  @media (max-width: 800px) {
    .navbar {
      position: relative;
      min-height: auto;
      padding: 14px 18px 12px;
      align-items: flex-start;
      gap: 12px;
      flex-direction: column;
    }

    nav {
      width: 100%;
      overflow-x: auto;
      justify-content: flex-start;
      gap: 22px;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav a {
      flex: 0 0 auto;
    }
  }
</style>
