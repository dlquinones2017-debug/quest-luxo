---
import { buildBeginYourQuestUrl } from "../lib/leads/leadIntakeContext";

const privateSourcingHref = buildBeginYourQuestUrl({ intent: "request" });
---

<section class="hero">
  <div class="content">
    <div class="copy">
      <p class="eyebrow">PRIVATE LUXURY TIMEPIECE ADVISORY</p>

      <h1>Exceptional watches.<br /><em>Precisely sourced.</em></h1>

      <p class="description">
        Discreet acquisition guidance, reference-level intelligence, and a
        trusted global network for collectors who value clarity and execution.
      </p>

      <div class="buttons">
        <a href={privateSourcingHref} class="primary">Begin Your Quest</a>
        <a href="/collections" class="secondary">Explore Collections</a>
      </div>

      <ul class="signals" aria-label="Quest Luxo service principles">
        <li>Private</li>
        <li>Reference-led</li>
        <li>Globally connected</li>
      </ul>
    </div>

    <div class="timepiece-art" aria-hidden="true">
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="dial">
        <span class="crown">QL</span>
        <span class="hand hand-hour"></span>
        <span class="hand hand-minute"></span>
        <span class="pivot"></span>
      </div>
      <p>Intelligence in every detail</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    padding: clamp(80px, 10vw, 148px) clamp(24px, 6vw, 84px);
    background:
      radial-gradient(circle at 78% 45%, rgba(212, 176, 106, 0.14), transparent 28%),
      linear-gradient(135deg, #07111f 0%, #0b1c2f 55%, #102f4d 100%);
    color: #ffffff;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 72px 72px;
    content: "";
    mask-image: linear-gradient(90deg, transparent, #000);
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, 0.88fr);
    gap: clamp(54px, 8vw, 120px);
    align-items: center;
  }

  .copy {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 28px;
    color: #d4b06a;
    letter-spacing: 0.28em;
    font-size: 12px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: clamp(58px, 7.2vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  h1 em {
    color: #d4b06a;
    font-weight: 400;
  }

  .description {
    max-width: 660px;
    margin: 34px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.75;
  }

  .buttons {
    margin-top: 42px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .primary,
  .secondary {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    border: 1px solid #d4b06a;
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .primary {
    background: #d4b06a;
    color: #07111f;
  }

  .secondary {
    color: #ffffff;
  }

  .primary:hover,
  .secondary:hover {
    transform: translateY(-2px);
  }

  .secondary:hover {
    background: #d4b06a;
    color: #07111f;
  }

  .signals {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin: 42px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.62);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    list-style: none;
    text-transform: uppercase;
  }

  .signals li::before {
    content: "◆";
    margin-right: 10px;
    color: #d4b06a;
    font-size: 7px;
  }

  .timepiece-art {
    position: relative;
    min-height: 430px;
    display: grid;
    place-items: center;
  }

  .dial,
  .orbit {
    position: absolute;
    border-radius: 50%;
  }

  .dial {
    width: min(30vw, 390px);
    aspect-ratio: 1;
    border: 1px solid rgba(212, 176, 106, 0.5);
    background:
      repeating-conic-gradient(from -1deg, rgba(212, 176, 106, 0.65) 0deg 0.75deg, transparent 0.75deg 30deg),
      radial-gradient(circle, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.01) 68%);
    box-shadow: 0 0 0 18px rgba(255, 255, 255, 0.025), 0 38px 90px rgba(0, 0, 0, 0.36);
  }

  .orbit {
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .orbit-one {
    width: min(36vw, 470px);
    aspect-ratio: 1;
  }

  .orbit-two {
    width: min(41vw, 540px);
    aspect-ratio: 1;
    border-style: dashed;
    opacity: 0.55;
  }

  .crown {
    position: absolute;
    top: 28%;
    width: 100%;
    color: rgba(212, 176, 106, 0.9);
    font-family: Georgia, serif;
    font-size: 18px;
    letter-spacing: 0.22em;
    text-align: center;
  }

  .hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 2px;
    background: #d4b06a;
    transform-origin: 50% 100%;
  }

  .hand-hour {
    height: 25%;
    transform: rotate(42deg);
  }

  .hand-minute {
    height: 35%;
    background: rgba(255, 255, 255, 0.82);
    transform: rotate(132deg);
  }

  .pivot {
    position: absolute;
    top: calc(50% - 5px);
    left: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border: 2px solid #d4b06a;
    border-radius: 50%;
    background: #07111f;
  }

  .timepiece-art p {
    align-self: end;
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: 88px;
    }

    .content {
      grid-template-columns: 1fr;
    }

    .timepiece-art {
      min-height: 390px;
    }

    .dial {
      width: min(72vw, 340px);
    }

    .orbit-one {
      width: min(82vw, 410px);
    }

    .orbit-two {
      width: min(92vw, 460px);
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding-inline: 22px;
    }

    h1 {
      font-size: clamp(48px, 15vw, 70px);
    }

    .buttons,
    .primary,
    .secondary {
      width: 100%;
    }

    .timepiece-art {
      min-height: 320px;
    }
  }
</style>
