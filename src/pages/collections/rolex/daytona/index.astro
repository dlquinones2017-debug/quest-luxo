---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import CollectionFactory from "../../../../components/CollectionFactory.astro";
import { rolexDaytonaAssets } from "../../../../data/rolex";
---

<BaseLayout title="Rolex Daytona | Quest Luxo">
