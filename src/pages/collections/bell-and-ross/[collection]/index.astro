---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BrokerageIntelligenceSection from "../../../../components/BrokerageIntelligenceSection.astro";
import BrokerageCTA from "../../../../components/BrokerageCTA.astro";
import ReferenceCard from "../../../../components/ReferenceCard.astro";
import { bellRossCollections, bellRossSources } from "../../../../data/bell-and-ross";
import { getFactoryReferencePath } from "../../../../lib/factory/brandFactory";
import { normalizeReferenceSlug } from "../../../../lib/factory/referenceGenerator";
export function getStaticPaths(){return bellRossCollections.map(c=>({params:{collection:c.slug},props:{collection:c}}));}
const {collection:c}=Astro.props;
const items=[
 {title:"Collection Overview",body:c.description},
 {title:"Market Position",body:c.configurations},
 {title:"Liquidity Guidance",label:"Insufficient evidence",body:"Recent completed sales and dealer bids have not been verified. Treat liquidity and sale time as unknown until the exact configuration and condition are matched."},
 {title:"Buyer Profile",body:c.buyer},
 {title:"Seller Profile",body:"Owners should prepare the complete reference, dated photographs, service records, accessories and target net proceeds. Document replacements and damage before valuation."},
 {title:"Ownership Considerations",body:c.ownership},
 {title:"Production Status",body:"The manufacturer pages for the two priority references are marked unavailable at review. This is not proof of discontinuation; production status requires verification."},
 {title:"Price and Investment Considerations",body:"Current price tiers remain unverified. Build a comparable set of completed sales and current dealer bids, adjusting for condition, service and completeness. No appreciation or resale timeline is assumed."},
 {title:"Brokerage Insight",body:"Separate reference validation from negotiation. Confirm acquisition cost, expected expenses and a defensible exit before defining offer authority."},
 {title:"Quest Luxo Perspective",body:"Buy for the square instrument-watch design and appropriate wrist fit. Configuration accuracy, documented condition and a conservative acquisition basis are the priorities."},
];
---
<BaseLayout title={"Bell & Ross "+c.name+" | Quest Luxo"} description={c.description}><main>
<section class="hero"><a class="back" href="/collections/bell-and-ross">← Bell & Ross</a><p class="eyebrow">Collection Intelligence</p><h1>Bell & Ross <em>{c.name}</em></h1><p class="lede">{c.description}</p><div class="facts"><span>{c.assets.length} priority reference</span><span>Exact-configuration review</span><span>Private brokerage</span></div></section>
<BrokerageIntelligenceSection eyebrow={c.name+" Intelligence"} title="Ownership and brokerage guidance" items={items} evidenceSources={bellRossSources} reviewedAt="September 7, 2026" />
<section class="directory"><p class="eyebrow">Reference dossier</p><h2>Priority reference</h2><p class="section-intro">Photography appears only after exact-reference, commercial-rights, and visual approval. The dossier remains available while that review is pending.</p>{c.assets.map(asset=><ReferenceCard asset={asset} href={getFactoryReferencePath("bell-and-ross",c.slug,normalizeReferenceSlug(asset.reference))} showIntelligenceProfile={false} showMsrp={false} showMissingImagePlaceholder={true} />)}</section>
<BrokerageCTA brand="Bell & Ross" collection={c.name} headline={"Discuss a "+c.name} description="Begin a sourcing, sale, trade or valuation conversation with collection context preserved." /></main></BaseLayout>
<style>
main{background:#07111f;color:#fff;min-height:100vh}.hero,.directory{max-width:1180px;margin:auto;padding:clamp(64px,9vw,120px) 24px}.hero{border-bottom:1px solid #ffffff1f}.back{display:inline-block;color:#d4b06a;text-decoration:none;margin-bottom:64px}.eyebrow{color:#d4b06a;font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.hero h1{font-size:clamp(52px,8vw,104px);line-height:.92;margin:18px 0 30px;max-width:920px}.hero h1 em{color:#d4b06a;font-weight:400}.lede,.section-intro{max-width:720px;line-height:1.75;color:#c7ced7;font-size:clamp(17px,2vw,20px)}.facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:40px}.facts span{border:1px solid #ffffff2e;padding:10px 14px;color:#e3e7eb;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.directory{max-width:820px}.directory h2{font-size:clamp(38px,5vw,60px);margin:12px 0 18px}.section-intro{font-size:16px;margin-bottom:36px}@media(max-width:640px){.back{margin-bottom:40px}.facts{display:grid}.hero,.directory{padding-left:20px;padding-right:20px}}
</style>
