---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../../components/BrokerageCTA.astro";
import BrokerageIntelligenceSection from "../../../components/BrokerageIntelligenceSection.astro";
import { ulysseNardinCollections } from "../../../data/ulysse-nardin";
import { getUlysseNardinReferencesForCollection } from "../../../data/ulysse-nardin-references";
import { ulysseNardinFactory } from "../../../lib/factory/ulysseNardinFactory";
import { createCollectionMetadata } from "../../../lib/factory/collectionGenerator";
import { buildReferencePath } from "../../../lib/factory/referenceGenerator";

export function getStaticPaths() {
  return ulysseNardinCollections.map((collection) => ({ params: { collection: collection.slug }, props: { collection } }));
}

const { collection } = Astro.props;
const factoryCollection = ulysseNardinFactory.collections.find((item) => item.slug === collection.slug);
if (!factoryCollection) throw new Error(`Ulysse Nardin collection registration missing for ${collection.slug}.`);
const metadata = createCollectionMetadata({ brand: ulysseNardinFactory, collection: factoryCollection });
const intelligence = collection.intelligence;
const references = getUlysseNardinReferencesForCollection(collection.slug);
const intelligenceItems = [
  { title: "History", body: intelligence.historicalOverview },
  { title: "Innovations", body: intelligence.technicalHighlights },
  { title: "Collector Appeal", body: intelligence.whyCollectorsBuy },
  { title: "Signature Design Language", body: intelligence.signatureDesignLanguage },
  { title: "Complications", body: intelligence.notableComplications },
  { title: "Market Positioning", body: intelligence.marketPositioning },
  { title: "Collector Profile", body: intelligence.collectorProfile },
  { title: "Buying Considerations", body: intelligence.buyingConsiderations },
  { title: "Ownership Experience", body: intelligence.ownershipExperience },
  { title: "Servicing Considerations", body: intelligence.servicingConsiderations },
  { title: "Liquidity Observations", body: intelligence.liquidityObservations },
  { title: "Brokerage Considerations", body: intelligence.brokerageConsiderations },
  { title: "Related Collections", body: intelligence.relatedCollections },
  { title: "Quest Luxo Perspective", body: intelligence.perspective },
];
---

<BaseLayout
  title={`Ulysse Nardin ${collection.name} | Quest Luxo`}
  description={collection.description}
>
  <main class="collection-page">
    <section class="hero">
      <a class="back-link" href="/collections/ulysse-nardin">← Back to Ulysse Nardin</a>
      <p class="eyebrow">Ulysse Nardin Brokerage Intelligence</p>
      <h1>Ulysse Nardin {collection.name}</h1>
      <p>{collection.description}</p>
    </section>

    <BrokerageIntelligenceSection
      eyebrow={`${collection.name} Intelligence`}
      title="Launch-quality collection guidance"
      intro="Collection identity is the starting point. Exact model, generation, complication, condition, completeness, service history, and fit determine the watch-level decision."
      items={intelligenceItems}
      reviewedAt="July 2026"
      evidenceSources={collection.evidenceSources}
    />

    <section class="models">
      <p class="eyebrow">Collection Coverage</p>
      <h2>Models included</h2>
      <div class="model-grid">
        {collection.models.map((model) => {
          const referenceAsset = references.find((asset) => asset.reference === model);

          return referenceAsset ? (
            <a
              class="model-card"
              href={buildReferencePath("ulysse-nardin", collection.slug, model)}
            >
              <span>{collection.category}</span>
              <h3>{model}</h3>
              <p>{referenceAsset.collectorNotes}</p>
              <strong>Explore Reference &rarr;</strong>
            </a>
          ) : (
            <article class="model-card">
              <span>{collection.category}</span>
              <h3>{model}</h3>
              <p>Included in the collection intelligence; a dedicated reference-family guide has not been published.</p>
            </article>
          );
        })}
      </div>
      <p class="route-note">Canonical collection route: {metadata.collectionPath}</p>
    </section>

    <BrokerageCTA
      brand="Ulysse Nardin"
      collection={collection.name}
      headline={`Considering an Ulysse Nardin ${collection.name}?`}
      description={`Source, sell, trade, value, or discuss an Ulysse Nardin ${collection.name} with collection context preserved for Quest Luxo brokerage.`}
    />
  </main>
</BaseLayout>

<style>
  .collection-page{background:#07111f;color:#fff;min-height:100vh}.hero,.models{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}.hero{padding-top:80px;padding-bottom:56px}.back-link{display:inline-block;color:#d4b06a;text-decoration:none;font-weight:800;margin-bottom:30px}.eyebrow{color:#d4b06a;font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin:0 0 14px}h1{font-size:clamp(48px,8vw,96px);line-height:.95;margin:0 0 24px}h2{font-size:clamp(34px,5vw,56px);line-height:1;margin:0 0 28px}.hero>p:not(.eyebrow),.model-card p,.route-note{max-width:780px;color:rgba(255,255,255,.72);font-size:18px;line-height:1.7}.models{padding-top:64px;padding-bottom:88px}.model-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.model-card{display:flex;flex-direction:column;min-height:220px;padding:24px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.045);color:#fff;text-decoration:none}.model-card:hover{border-color:#d4b06a}.model-card span,.model-card strong{color:#d4b06a;font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.model-card h3{font-size:28px;margin:24px 0 8px}.model-card strong{margin-top:auto}.route-note{font-size:13px;margin-top:24px}@media(max-width:700px){.model-grid{grid-template-columns:1fr}.hero{padding-top:64px}}
</style>
