---
import ReferenceFactory from "../../../../components/ReferenceFactory.astro";
import { cartierTankLaunchAssets } from "../../../../data/cartier-intelligence";
import { getExpansionReferences } from "../../../../data/reference-expansion";
import { normalizeReferenceSlug } from "../../../../lib/factory/referenceGenerator";
const assets = [...getExpansionReferences("cartier", "tank"), ...cartierTankLaunchAssets];
export function getStaticPaths() { return [...getExpansionReferences("cartier", "tank"), ...cartierTankLaunchAssets].map((asset) => ({ params: { reference: normalizeReferenceSlug(asset.reference) } })); }
---
<ReferenceFactory brand="Cartier" collection="Tank" assets={assets} basePath="/collections/cartier/tank" showBrokerageCTA={true} />
