---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../../components/BrokerageCTA.astro";
import BrokerageIntelligenceSection from "../../../components/BrokerageIntelligenceSection.astro";
import { cartierSantosBrokerageIntelligence, cartierSantosLaunchAssets } from "../../../data/cartier-intelligence";
import { normalizeReferenceSlug } from "../../../lib/factory/referenceGenerator";
import {
  cartierBrandFoundation,
  cartierSantosCollection,
  cartierSantosReferenceMetadata,
  cartierSantosReferenceFamilies,
  getCartierCollectionFoundation,
} from "../../../data/brands/cartier";
import type { FactoryBrand, FactoryCollection } from "../../../lib/factory/brandFactory";
import { createCollectionMetadata } from "../../../lib/factory/collectionGenerator";
import { watchPhotographs } from "../../../data/watch-photography";

const santosFactoryCollection = getCartierCollectionFoundation("santos");

if (!santosFactoryCollection) {
  throw new Error("Cartier Santos collection metadata is missing.");
}

const cartierFactory = {
  name: cartierBrandFoundation.name,
  slug: cartierBrandFoundation.slug,
  factoryLive: cartierBrandFoundation.factoryLive,
  launchPhase: cartierBrandFoundation.launchPhase,
  collections: cartierBrandFoundation.collections.map((collection) => ({
    ...collection,
  })),
} satisfies FactoryBrand;

const santosCollection = {
  ...santosFactoryCollection,
} satisfies FactoryCollection;

const collectionMetadata = createCollectionMetadata({
  brand: cartierFactory,
  collection: santosCollection,
  references: cartierSantosReferenceMetadata.map(
    (reference) => reference.reference
  ),
});

const intelligenceEntries = [
  {
    label: "Quest Luxo Overview",
    value: cartierSantosCollection.intelligence.questLuxoOverview,
  },
  {
    label: "Collector Profile",
    value: cartierSantosCollection.intelligence.collectorProfile,
  },
  {
    label: "Market Positioning",
    value: cartierSantosCollection.intelligence.marketPositioning,
  },
  {
    label: "Liquidity Assessment",
    value: cartierSantosCollection.intelligence.liquidityAssessment,
  },
  {
    label: "Demand Difficulty",
    value: cartierSantosCollection.intelligence.allocationDemandDifficulty,
  },
  {
    label: "Investment Considerations",
    value: cartierSantosCollection.intelligence.investmentConsiderations,
  },
  {
    label: "Ownership Experience",
    value: cartierSantosCollection.intelligence.ownershipExperience,
  },
  {
    label: "Buying Recommendations",
    value: cartierSantosCollection.intelligence.buyingRecommendations,
  },
];

const currentFamilyCount = cartierSantosReferenceFamilies.filter(
  (reference) => reference.productionStatus === "Current Production"
).length;
const placeholderFamilyCount = cartierSantosReferenceFamilies.filter(
  (reference) => reference.productionStatus === "Foundation Placeholder"
).length;

const referenceCards = cartierSantosReferenceFamilies.map((reference, index) => ({
  reference,
  metadata: cartierSantosReferenceMetadata[index],
}));
const standardIntelligence = cartierSantosBrokerageIntelligence;
const collectionPhotograph = watchPhotographs.find(
  (photograph) =>
    photograph.brand === "Cartier" &&
    photograph.collection === "Santos" &&
    photograph.collectionOnly &&
    photograph.websiteApproved &&
    photograph.authenticPhotography
);
const standardIntelligenceItems = [
  { title: "Collection Overview", body: standardIntelligence.overview }, { title: "Market Position", body: standardIntelligence.marketPosition },
  { title: "Liquidity Guidance", label: standardIntelligence.liquidityBand, body: standardIntelligence.liquidityGuidance }, { title: "Buyer Profile", body: standardIntelligence.buyerProfile },
  { title: "Seller Profile", body: standardIntelligence.sellerProfile }, { title: "Ownership Considerations", body: standardIntelligence.ownershipConsiderations },
  { title: "Brokerage Insight", body: standardIntelligence.brokerageInsight }, { title: "Market Commentary", body: standardIntelligence.marketCommentary },
  { title: "Quest Luxo Perspective", body: standardIntelligence.perspective },
];
---

<BaseLayout
  title="Cartier Santos Collection | Quest Luxo"
  description="Explore Cartier Santos collection intelligence, design heritage, liquidity, reference-family foundations, and Quest Luxo brokerage guidance."
  canonicalUrl="/collections/cartier/santos"
>
  <main class="collection-page">
    <section class="hero">
      <p class="eyebrow">Cartier Factory Launch</p>
      <h1>Cartier Santos</h1>
      <p>
        Quest Luxo Santos coverage launches Cartier with a collection-first
        foundation for design-led luxury, pilot-watch heritage, strong unisex
        demand, bracelet versatility, and private brokerage opportunity.
      </p>
      {collectionPhotograph && <figure class="collection-photograph">
        <img src={collectionPhotograph.src} alt={collectionPhotograph.alt} width="1200" height="1637" loading="eager" />
        <figcaption>
          Cartier Santos collection imagery — not an exact reference listing. {collectionPhotograph.attribution}
          <a href={collectionPhotograph.sourceUrl} rel="license external">Source</a> ·
          <a href={collectionPhotograph.licenseUrl} rel="license external">{collectionPhotograph.licenseLabel}</a>
        </figcaption>
      </figure>}
    </section>

    <BrokerageIntelligenceSection eyebrow="Santos Brokerage Intelligence" title="Collection-level brokerage guidance" intro="The existing Santos family foundation remains intact; this launch layer adds reference-specific buyer, seller, ownership, liquidity, and market guidance." items={standardIntelligenceItems} reviewedAt={standardIntelligence.reviewedAt} evidenceSources={standardIntelligence.evidenceSources} />

    <section class="directory">
      <div class="section-header"><p class="eyebrow">Priority References</p><h2>Santos launch set</h2></div>
      <div class="reference-grid">{cartierSantosLaunchAssets.map((asset) => <article class="reference-card"><div class="card-top"><span>{asset.reference}</span><strong>Priority</strong></div><h3>{asset.model}</h3><p class="configuration">{asset.marketPosition}</p><dl class="specs"><div><dt>Liquidity</dt><dd>{asset.liquidity}</dd></div><div><dt>Production</dt><dd>{asset.productionStatus}</dd></div></dl><p class="view">{asset.questLuxoView}</p><a class="reference-link" href={`/collections/cartier/santos/${normalizeReferenceSlug(asset.reference)}`}>View Brokerage Intelligence</a></article>)}</div>
    </section>

    <section class="signals" aria-label="Santos launch signals">
      <div>
        <strong>{collectionMetadata.assetCount}</strong>
        <span>Reference Families</span>
      </div>

      <div>
        <strong>{cartierSantosCollection.originalLaunchYear}</strong>
        <span>Original Launch</span>
      </div>

      <div>
        <strong>{cartierSantosCollection.modernLaunchReferenceEra}</strong>
        <span>Modern Era</span>
      </div>

      <div>
        <strong>{currentFamilyCount}</strong>
        <span>Current Families</span>
      </div>

      <div>
        <strong>On</strong>
        <span>Family Pages</span>
      </div>
    </section>

    <section class="overview">
      <div>
        <p class="eyebrow">Launch Slice</p>
        <h2>Santos opens the Cartier path</h2>
      </div>

      <p>
        This first public Cartier collection page exposes Santos collection
        intelligence with family-level reference pages. Individual
        configuration pages remain intentionally dormant, and non-Santos Cartier
        collections stay reserved for later factory expansion.
      </p>
    </section>

    <section class="positioning" aria-label="Santos positioning">
      <div class="section-header">
        <p class="eyebrow">Collection Positioning</p>
        <h2>{cartierSantosCollection.category}</h2>
      </div>

      <div class="positioning-grid">
        {cartierSantosCollection.positioning.map((signal) => <span>{signal}</span>)}
      </div>
    </section>

    <section class="intelligence" aria-label="Santos collection intelligence">
      <div class="section-header">
        <p class="eyebrow">Quest Luxo Intelligence</p>
        <h2>Santos buying context</h2>
      </div>

      <div class="intelligence-grid">
        {
          intelligenceEntries.map((entry) => (
            <article>
              <h3>{entry.label}</h3>
              <p>{entry.value}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="directory">
      <div class="section-header">
        <p class="eyebrow">Reference Directory</p>
        <h2>Santos Foundation Families</h2>
      </div>

      <div class="reference-grid">
        {
          referenceCards.map(({ reference, metadata }) => (
            <article
              class="reference-card"
              aria-label={`${reference.model} preview`}
            >
              <div class="card-top">
                <span>{reference.caseProfile}</span>
                <strong>{reference.productionStatus}</strong>
              </div>

              <h3>{reference.model}</h3>
              <p class="configuration">{reference.collectorAppeal}</p>

              <dl class="specs">
                <div>
                  <dt>Target Buyer</dt>
                  <dd>{reference.targetBuyer}</dd>
                </div>
                <div>
                  <dt>Market Position</dt>
                  <dd>{reference.marketPositioning}</dd>
                </div>
                <div>
                  <dt>Brokerage Notes</dt>
                  <dd>{reference.brokerageNotes}</dd>
                </div>
                <div>
                  <dt>Sourcing</dt>
                  <dd>{reference.sourcingConsiderations}</dd>
                </div>
              </dl>

              <p class="view">{reference.intelligenceSummary}</p>

              <a
                class="reference-link"
                href={metadata?.referencePath ?? collectionMetadata.collectionPath}
              >
                View reference family
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <BrokerageCTA
      brand="Cartier"
      collection="Santos"
      headline="Looking for your next Santos?"
      description="Source, sell, trade, or value a Cartier Santos with discreet guidance from Quest Luxo brokerage."
    />
  </main>
</BaseLayout>

<style>
  .collection-page {
    background: #07111f;
    color: #ffffff;
    min-height: 100vh;
  }

  .hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 96px 24px 48px;
  }

  .eyebrow {
    color: #d4b06a;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  h1 {
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.95;
    margin: 0 0 24px;
  }

  h2 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1;
    margin: 0;
  }

  .hero p,
  .overview p {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.7;
  }

  .collection-photograph {
    max-width: 480px;
    margin: 32px 0 0;
  }

  .collection-photograph img {
    display: block;
    width: 100%;
    height: auto;
    background: #ffffff;
  }

  .collection-photograph figcaption {
    margin-top: 9px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 11px;
    line-height: 1.5;
  }

  .collection-photograph a {
    color: #d4b06a;
    margin-left: 4px;
  }

  .signals {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 32px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }

  .signals div {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
    padding: 20px;
  }

  .signals strong {
    display: block;
    color: #d4b06a;
    font-size: 32px;
    margin-bottom: 8px;
  }

  .signals span {
    display: block;
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .overview,
  .positioning,
  .intelligence,
  .directory {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    padding-top: 20px;
    padding-bottom: 36px;
  }

  .positioning,
  .intelligence {
    padding-top: 32px;
    padding-bottom: 36px;
  }

  .directory {
    padding-top: 32px;
    padding-bottom: 92px;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .positioning-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .positioning-grid span {
    border: 1px solid rgba(212, 176, 106, 0.34);
    background: rgba(212, 176, 106, 0.08);
    color: #d4b06a;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.11em;
    padding: 12px 14px;
    text-transform: uppercase;
  }

  .intelligence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .intelligence-grid article,
  .reference-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
    padding: 22px;
  }

  .intelligence-grid h3,
  .reference-card h3 {
    font-size: 26px;
    line-height: 1.08;
    margin: 0 0 12px;
  }

  .intelligence-grid p {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
    margin: 0;
  }

  .reference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .reference-card {
    display: flex;
    flex-direction: column;
    min-height: 620px;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 20px;
  }

  .card-top span {
    color: #d4b06a;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .card-top strong {
    border: 1px solid rgba(212, 176, 106, 0.42);
    color: #d4b06a;
    padding: 8px 10px;
    text-align: center;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .configuration {
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.55;
    margin: 0 0 22px;
  }

  .specs {
    display: grid;
    gap: 14px;
    margin: 0 0 22px;
  }

  .specs div {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 12px;
  }

  dt {
    color: rgba(255, 255, 255, 0.48);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  dd {
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
    margin: 0;
  }

  .view {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
    margin: 0 0 24px;
  }

  .reference-link {
    display: block;
    margin-top: auto;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.62);
    padding: 13px 14px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .reference-link:hover,
  .reference-link:focus-visible {
    border-color: rgba(212, 176, 106, 0.56);
    color: #d4b06a;
    outline: none;
  }

  @media (max-width: 1060px) {
    .reference-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .signals,
    .intelligence-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .overview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .signals,
    .intelligence-grid,
    .reference-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 64px;
    }
  }
</style>
