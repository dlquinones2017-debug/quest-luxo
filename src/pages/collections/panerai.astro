---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../components/BrokerageCTA.astro";
import { paneraiFactory } from "../../lib/factory/paneraiFactory";
import { buildBeginYourQuestUrl } from "../../lib/leads/leadIntakeContext";

const beginPaneraiQuestUrl = buildBeginYourQuestUrl({ intent: "broker", brand: "Panerai" });
---

<BaseLayout title="Panerai | Quest Luxo">
  <main class="brand-page">
    <section class="hero">
      <p class="eyebrow">Panerai Factory</p>
      <h1>Panerai</h1>
      <p>Collection-level brokerage intelligence for Panerai, beginning with the purpose-built Submersible family.</p>
      <div class="actions">
        <a href={beginPaneraiQuestUrl} class="primary">Begin Your Panerai Quest</a>
        <a href="/collections/panerai/submersible" class="secondary">Explore Submersible</a>
      </div>
    </section>

    <section class="collections">
      <p class="eyebrow">Collection Guide</p>
      <h2>Launch coverage</h2>
      <div class="grid">
        {paneraiFactory.collections.map((collection) => (
          <a href={`/collections/panerai/${collection.slug}`} class="card">
            <span>{collection.category}</span>
            <h3>{collection.name}</h3>
            <p>{collection.description}</p>
            <strong>Explore Collection →</strong>
          </a>
        ))}
      </div>
    </section>

    <BrokerageCTA brand="Panerai" headline="Begin a Panerai conversation" description="Request, sell, trade, value, or discuss a Panerai with collection context preserved for the Quest Luxo brokerage team." />
  </main>
</BaseLayout>

<style>
  .brand-page{background:#07111f;color:#fff;min-height:100vh}.hero,.collections{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}.hero{padding-top:96px;padding-bottom:56px}.eyebrow{color:#d4b06a;font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin:0 0 14px}h1{font-size:clamp(54px,9vw,112px);line-height:.92;margin:0 0 28px}h2{font-size:clamp(34px,5vw,56px);margin:0 0 28px}.hero>p:not(.eyebrow),.card p{color:rgba(255,255,255,.72);font-size:18px;line-height:1.7;max-width:780px}.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}.primary,.secondary{padding:15px 22px;text-decoration:none;font-weight:800}.primary{background:#d4b06a;color:#07111f}.secondary{border:1px solid rgba(255,255,255,.18);color:#fff}.collections{padding-top:64px;padding-bottom:88px}.grid{display:grid;grid-template-columns:minmax(0,560px);gap:16px}.card{display:flex;flex-direction:column;min-height:260px;padding:24px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#fff;text-decoration:none}.card>span,.card>strong{color:#d4b06a;font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.card h3{font-size:32px;margin:28px 0 8px}.card strong{margin-top:auto}@media(max-width:640px){.hero{padding-top:64px}}
</style>
