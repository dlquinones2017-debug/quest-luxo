---
import ReferenceFactory from "../../../../components/ReferenceFactory.astro";
import { iwcPortugieserLaunchAssets } from "../../../../data/iwc-intelligence";
import { normalizeReferenceSlug } from "../../../../lib/factory/referenceGenerator";
export function getStaticPaths() { return iwcPortugieserLaunchAssets.map((asset) => ({ params: { reference: normalizeReferenceSlug(asset.reference) } })); }
---
<ReferenceFactory brand="IWC" collection="Portugieser" assets={iwcPortugieserLaunchAssets} basePath="/collections/iwc/portugieser" showBrokerageCTA={true} />
