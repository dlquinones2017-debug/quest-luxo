---
import ReferenceFactory from "../../../../components/ReferenceFactory.astro";
import { breitlingNavitimerLaunchAssets } from "../../../../data/breitling-intelligence";
import { normalizeReferenceSlug } from "../../../../lib/factory/referenceGenerator";
export function getStaticPaths() { return breitlingNavitimerLaunchAssets.map((asset) => ({ params: { reference: normalizeReferenceSlug(asset.reference) } })); }
---
<ReferenceFactory brand="Breitling" collection="Navitimer" assets={breitlingNavitimerLaunchAssets} basePath="/collections/breitling/navitimer" showBrokerageCTA={true} />
