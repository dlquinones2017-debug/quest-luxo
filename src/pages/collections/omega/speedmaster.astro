---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../../components/BrokerageCTA.astro";
import BrokerageIntelligenceSection from "../../../components/BrokerageIntelligenceSection.astro";
import { isOmegaPriorityReference, omegaSpeedmasterIntelligence, omegaSpeedmasterLaunchAssets } from "../../../data/omega-intelligence";
import { getOmegaCollectionFactory, omegaFactory } from "../../../lib/factory/omegaFactory";
import { createCollectionMetadata } from "../../../lib/factory/collectionGenerator";
import { listReferenceMetadataFromAssets } from "../../../lib/factory/referenceGenerator";
import { watchPhotographs } from "../../../data/watch-photography";
import { approvedPhotograph } from "../../../lib/media/watchPhotography";

const collection = getOmegaCollectionFactory("speedmaster");
if (!collection) throw new Error("Omega Speedmaster factory metadata is missing.");
const metadata = createCollectionMetadata({ brand: omegaFactory, collection, references: omegaSpeedmasterLaunchAssets.map((asset) => asset.reference) });
const references = listReferenceMetadataFromAssets({ brand: "Omega", brandSlug: "omega", collection: "Speedmaster", collectionSlug: "speedmaster", assets: omegaSpeedmasterLaunchAssets, basePath: metadata.collectionPath });
const cards = omegaSpeedmasterLaunchAssets.map((asset) => ({ asset, configuration: asset.configurations?.[0], priority: isOmegaPriorityReference(asset), metadata: references.find((entry) => entry.reference === asset.reference), photograph: approvedPhotograph(asset, watchPhotographs) }));
const currentCount = omegaSpeedmasterLaunchAssets.filter((asset) => asset.productionStatus?.includes("Current")).length;
const discontinuedCount = omegaSpeedmasterLaunchAssets.filter((asset) => asset.productionStatus?.includes("Discontinued")).length;
const intelligenceItems = [
  { title:"Collection Overview",body:omegaSpeedmasterIntelligence.overview },{ title:"Market Position",body:omegaSpeedmasterIntelligence.marketPosition },
  { title:"Liquidity Guidance",label:omegaSpeedmasterIntelligence.liquidityBand,body:omegaSpeedmasterIntelligence.liquidityGuidance },{ title:"Buyer Profile",body:omegaSpeedmasterIntelligence.buyerProfile },
  { title:"Seller Profile",body:omegaSpeedmasterIntelligence.sellerProfile },{ title:"Ownership Considerations",body:omegaSpeedmasterIntelligence.ownershipConsiderations },
  { title:"Brokerage Insight",body:omegaSpeedmasterIntelligence.brokerageInsight },{ title:"Market Commentary",body:omegaSpeedmasterIntelligence.marketCommentary },
  { title:"Quest Luxo Perspective",body:omegaSpeedmasterIntelligence.perspective },
];
---

<BaseLayout title="Omega Speedmaster | Quest Luxo">
  <main class="collection-page">
    <section class="hero"><p class="eyebrow">Omega Brokerage Intelligence</p><h1>Omega Speedmaster</h1><p>Generation-specific guidance across seven Moonwatch and collector configurations, with complete intelligence for 3570.50 and 310.30.42.50.01.001.</p></section>
    <section class="signals" aria-label="Speedmaster launch signals">
      <div><strong>{metadata.assetCount}</strong><span>References Covered</span></div><div><strong>{currentCount}</strong><span>Current Production</span></div><div><strong>{discontinuedCount}</strong><span>Discontinued</span></div><div><strong>2</strong><span>Priority References</span></div><div><strong>{omegaSpeedmasterIntelligence.reviewedAt}</strong><span>Market Review</span></div>
    </section>
    <BrokerageIntelligenceSection eyebrow="Speedmaster Intelligence" title="Collection-level brokerage guidance" intro="Moonwatch heritage establishes context; generation, crystal, movement, configuration, condition, and service determine the watch-level decision." items={intelligenceItems} reviewedAt={omegaSpeedmasterIntelligence.reviewedAt} evidenceSources={omegaSpeedmasterIntelligence.evidenceSources} />
    <section class="directory">
      <div class="section-header"><p class="eyebrow">Reference Directory</p><h2>Speedmaster launch set</h2><p>Priority references open complete intelligence pages. Supporting configurations remain collection-level guidance.</p></div>
      <div class="reference-grid">
        {cards.map(({asset,configuration,priority,metadata:referenceMetadata,photograph}) => {
          const content = <><div class="card-top"><span>{asset.reference}</span><strong>{priority?"Priority":"Covered"}</strong></div>{photograph && <figure class="watch-photograph"><img src={photograph.src} alt={photograph.alt} width="960" height="960" loading="lazy" /><figcaption>{photograph.attribution} <a href={photograph.sourceUrl} rel="license external">Source</a> · <a href="https://creativecommons.org/licenses/by/2.0/" rel="license external">CC BY 2.0</a></figcaption></figure>}<h3>{asset.model}</h3><p class="configuration">{configuration?.nickname??"Speedmaster"} · {configuration?.dial??"Configuration-specific"}</p><dl class="specs"><div><dt>Production</dt><dd>{asset.productionStatus}</dd></div><div><dt>Market Position</dt><dd>{asset.marketPosition}</dd></div><div><dt>Liquidity</dt><dd>{asset.liquidity}</dd></div></dl><p class="view">{asset.questLuxoView}</p><span class="card-action">{priority?"View Brokerage Intelligence":"Collection Guidance Available"}</span></>;
          return priority&&referenceMetadata?<a href={referenceMetadata.referencePath} class="reference-card active-card">{content}</a>:<article class="reference-card">{content}</article>;
        })}
      </div>
    </section>
    <BrokerageCTA brand="Omega" collection="Speedmaster" headline="Looking for your next Speedmaster?" description="Source, sell, trade, or value a Speedmaster with generation-specific guidance from Quest Luxo brokerage." />
  </main>
</BaseLayout>

<style>
  .collection-page{background:#07111f;color:#fff;min-height:100vh}.hero,.signals,.directory{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}.hero{padding-top:96px;padding-bottom:48px}.eyebrow{color:#d4b06a;font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin:0 0 14px}h1{font-size:clamp(48px,8vw,96px);line-height:.95;margin:0 0 24px}h2{font-size:clamp(32px,5vw,56px);line-height:1;margin:0 0 18px}.hero p:not(.eyebrow),.section-header p{max-width:760px;color:rgba(255,255,255,.72);font-size:18px;line-height:1.7}.signals{padding-bottom:44px;display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.signals div,.reference-card{border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.045)}.signals div{padding:20px}.signals strong{display:block;color:#d4b06a;font-size:26px;margin-bottom:8px}.signals span{color:rgba(255,255,255,.62);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.directory{padding-top:64px;padding-bottom:92px}.section-header{margin-bottom:32px}.reference-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.reference-card{display:flex;flex-direction:column;min-height:500px;padding:22px;color:#fff;text-decoration:none}.active-card:hover{border-color:#d4b06a}.card-top{display:flex;justify-content:space-between;gap:14px;margin-bottom:20px;color:#d4b06a;font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.watch-photograph{margin:0 0 18px}.watch-photograph img{display:block;width:100%;height:auto;background:#fff}.watch-photograph figcaption{margin-top:8px;color:rgba(255,255,255,.62);font-size:11px;line-height:1.5}.watch-photograph a{color:#d4b06a}.reference-card h3{font-size:26px;line-height:1.08;margin:0 0 12px}.configuration,.view,dd{color:rgba(255,255,255,.7);line-height:1.6}.specs{display:grid;gap:14px;margin:16px 0 22px}.specs div{border-top:1px solid rgba(255,255,255,.1);padding-top:12px}dt{color:rgba(255,255,255,.48);font-size:11px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;margin-bottom:6px}dd{margin:0}.card-action{margin-top:auto;border:1px solid rgba(255,255,255,.14);padding:13px 14px;text-align:center;font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}@media(max-width:1000px){.reference-grid{grid-template-columns:repeat(2,1fr)}.signals{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.reference-grid,.signals{grid-template-columns:1fr}.hero{padding-top:64px}}
</style>
