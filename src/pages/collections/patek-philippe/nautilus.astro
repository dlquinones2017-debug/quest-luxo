---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../../components/BrokerageCTA.astro";
import BrokerageIntelligenceSection from "../../../components/BrokerageIntelligenceSection.astro";
import {
  isPatekPhilippePriorityReference,
  patekPhilippeNautilusIntelligence,
  patekPhilippeNautilusLaunchAssets,
} from "../../../data/patek-philippe-intelligence";
import {
  getPatekPhilippeCollectionFactory,
  patekPhilippeFactory,
} from "../../../lib/factory/patekPhilippeFactory";
import { createCollectionMetadata } from "../../../lib/factory/collectionGenerator";
import { listReferenceMetadataFromAssets } from "../../../lib/factory/referenceGenerator";

const nautilusCollection = getPatekPhilippeCollectionFactory("nautilus");

if (!nautilusCollection) {
  throw new Error("Patek Philippe Nautilus factory metadata is missing.");
}

const collectionMetadata = createCollectionMetadata({
  brand: patekPhilippeFactory,
  collection: nautilusCollection,
  references: patekPhilippeNautilusLaunchAssets.map((asset) => asset.reference),
});
const referenceMetadata = listReferenceMetadataFromAssets({
  brand: patekPhilippeFactory.name,
  brandSlug: patekPhilippeFactory.slug,
  collection: nautilusCollection.name,
  collectionSlug: nautilusCollection.slug,
  assets: patekPhilippeNautilusLaunchAssets,
  basePath: collectionMetadata.collectionPath,
});
const referenceCards = patekPhilippeNautilusLaunchAssets.map((asset) => ({
  asset,
  metadata: referenceMetadata.find((entry) => entry.reference === asset.reference),
  configuration: asset.configurations?.[0],
  priority: isPatekPhilippePriorityReference(asset),
}));
const currentCount = patekPhilippeNautilusLaunchAssets.filter((asset) =>
  asset.productionStatus?.includes("Current")
).length;
const discontinuedCount = patekPhilippeNautilusLaunchAssets.filter((asset) =>
  asset.productionStatus?.includes("Discontinued")
).length;
const intelligenceItems = [
  { title: "Collection Overview", body: patekPhilippeNautilusIntelligence.overview },
  { title: "Market Position", body: patekPhilippeNautilusIntelligence.marketPosition },
  { title: "Liquidity Guidance", label: patekPhilippeNautilusIntelligence.liquidityBand, body: patekPhilippeNautilusIntelligence.liquidityGuidance },
  { title: "Buyer Profile", body: patekPhilippeNautilusIntelligence.buyerProfile },
  { title: "Seller Profile", body: patekPhilippeNautilusIntelligence.sellerProfile },
  { title: "Ownership Considerations", body: patekPhilippeNautilusIntelligence.ownershipConsiderations },
  { title: "Brokerage Insight", body: patekPhilippeNautilusIntelligence.brokerageInsight },
  { title: "Market Commentary", body: patekPhilippeNautilusIntelligence.marketCommentary },
  { title: "Quest Luxo Perspective", body: patekPhilippeNautilusIntelligence.perspective },
];
---

<BaseLayout title="Patek Philippe Nautilus | Quest Luxo">
  <main class="collection-page">
    <section class="hero">
      <p class="eyebrow">Patek Philippe Brokerage Intelligence</p>
      <h1>Patek Philippe Nautilus</h1>
      <p>
        Reference-specific guidance across six modern Nautilus configurations,
        with complete launch intelligence for the 5711/1A and 5811/1G.
      </p>
    </section>

    <section class="signals" aria-label="Nautilus launch signals">
      <div><strong>{collectionMetadata.assetCount}</strong><span>References Covered</span></div>
      <div><strong>{currentCount}</strong><span>Current Production</span></div>
      <div><strong>{discontinuedCount}</strong><span>Discontinued</span></div>
      <div><strong>2</strong><span>Priority References</span></div>
      <div><strong>{patekPhilippeNautilusIntelligence.reviewedAt}</strong><span>Market Review</span></div>
    </section>

    <BrokerageIntelligenceSection
      eyebrow="Nautilus Intelligence"
      title="Collection-level brokerage guidance"
      intro="The collection name establishes context; the reference, metal, complication, condition, and documentation determine the transaction."
      items={intelligenceItems}
      reviewedAt={patekPhilippeNautilusIntelligence.reviewedAt}
      evidenceSources={patekPhilippeNautilusIntelligence.evidenceSources}
    />

    <section class="directory">
      <div class="section-header">
        <p class="eyebrow">Reference Directory</p>
        <h2>Nautilus launch set</h2>
        <p>Priority references open complete intelligence pages. Supporting references remain collection-level guidance only.</p>
      </div>

      <div class="reference-grid">
        {
          referenceCards.map(({ asset, configuration, metadata, priority }) => {
            const content = (
              <>
                <div class="card-top"><span>{asset.reference}</span><strong>{priority ? "Priority" : "Covered"}</strong></div>
                <h3>{asset.model}</h3>
                <p class="configuration">{configuration?.nickname ?? "Nautilus"} · {configuration?.dial ?? "Configuration-specific"}</p>
                <dl class="specs">
                  <div><dt>Production</dt><dd>{asset.productionStatus}</dd></div>
                  <div><dt>Market Position</dt><dd>{asset.marketPosition}</dd></div>
                  <div><dt>Liquidity</dt><dd>{asset.liquidity}</dd></div>
                </dl>
                <p class="view">{asset.questLuxoView}</p>
                <span class="card-action">{priority ? "View Brokerage Intelligence" : "Collection Guidance Available"}</span>
              </>
            );

            return priority && metadata ? (
              <a href={metadata.referencePath} class="reference-card active-card">{content}</a>
            ) : (
              <article class="reference-card">{content}</article>
            );
          })
        }
      </div>
    </section>

    <BrokerageCTA
      brand="Patek Philippe"
      collection="Nautilus"
      headline="Looking for your next Nautilus?"
      description="Source, sell, trade, or value a Nautilus with discreet, reference-specific guidance from Quest Luxo brokerage."
    />
  </main>
</BaseLayout>

<style>
  .collection-page { background:#07111f; color:#fff; min-height:100vh; }
  .hero,.signals,.directory { max-width:1180px; margin:0 auto; padding-left:24px; padding-right:24px; }
  .hero { padding-top:96px; padding-bottom:48px; }
  .eyebrow { color:#d4b06a; font-size:13px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; margin:0 0 14px; }
  h1 { font-size:clamp(48px,8vw,96px); line-height:.95; margin:0 0 24px; }
  h2 { font-size:clamp(32px,5vw,56px); line-height:1; margin:0 0 18px; }
  .hero p:not(.eyebrow),.section-header p { max-width:760px; color:rgba(255,255,255,.72); font-size:18px; line-height:1.7; }
  .signals { padding-bottom:44px; display:grid; grid-template-columns:repeat(5,1fr); gap:14px; }
  .signals div,.reference-card { border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.045); }
  .signals div { padding:20px; }
  .signals strong { display:block; color:#d4b06a; font-size:26px; margin-bottom:8px; }
  .signals span { color:rgba(255,255,255,.62); font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .directory { padding-top:64px; padding-bottom:92px; }
  .section-header { margin-bottom:32px; }
  .reference-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
  .reference-card { display:flex; flex-direction:column; min-height:500px; padding:22px; color:#fff; text-decoration:none; }
  .active-card:hover { border-color:#d4b06a; }
  .card-top { display:flex; justify-content:space-between; gap:14px; margin-bottom:20px; color:#d4b06a; font-size:12px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
  .reference-card h3 { font-size:26px; line-height:1.08; margin:0 0 12px; }
  .configuration,.view,dd { color:rgba(255,255,255,.7); line-height:1.6; }
  .specs { display:grid; gap:14px; margin:16px 0 22px; }
  .specs div { border-top:1px solid rgba(255,255,255,.1); padding-top:12px; }
  dt { color:rgba(255,255,255,.48); font-size:11px; font-weight:900; letter-spacing:.13em; text-transform:uppercase; margin-bottom:6px; }
  dd { margin:0; }
  .card-action { margin-top:auto; border:1px solid rgba(255,255,255,.14); padding:13px 14px; text-align:center; font-size:11px; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  @media(max-width:1000px){.reference-grid{grid-template-columns:repeat(2,1fr)}.signals{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.reference-grid,.signals{grid-template-columns:1fr}.hero{padding-top:64px}}
</style>
