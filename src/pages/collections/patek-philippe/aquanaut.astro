---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../../components/BrokerageCTA.astro";
import BrokerageIntelligenceSection from "../../../components/BrokerageIntelligenceSection.astro";
import {
  patekPhilippeAquanautIntelligence,
  patekPhilippeAquanautLaunchAssets,
} from "../../../data/patek-philippe-intelligence";
import { buildReferencePath } from "../../../lib/factory/referenceGenerator";

const asset = patekPhilippeAquanautLaunchAssets[0];

if (!asset) {
  throw new Error("Patek Philippe Aquanaut launch asset is missing.");
}

const referencePath = buildReferencePath("patek-philippe", "aquanaut", asset.reference);
const intelligenceItems = [
  { title: "Collection Overview", body: patekPhilippeAquanautIntelligence.overview },
  { title: "Market Position", body: patekPhilippeAquanautIntelligence.marketPosition },
  { title: "Liquidity Guidance", label: patekPhilippeAquanautIntelligence.liquidityBand, body: patekPhilippeAquanautIntelligence.liquidityGuidance },
  { title: "Buyer Profile", body: patekPhilippeAquanautIntelligence.buyerProfile },
  { title: "Seller Profile", body: patekPhilippeAquanautIntelligence.sellerProfile },
  { title: "Ownership Considerations", body: patekPhilippeAquanautIntelligence.ownershipConsiderations },
  { title: "Brokerage Insight", body: patekPhilippeAquanautIntelligence.brokerageInsight },
  { title: "Market Commentary", body: patekPhilippeAquanautIntelligence.marketCommentary },
  { title: "Quest Luxo Perspective", body: patekPhilippeAquanautIntelligence.perspective },
];
---

<BaseLayout title="Patek Philippe Aquanaut | Quest Luxo">
  <main class="collection-page">
    <section class="hero">
      <p class="eyebrow">Patek Philippe Brokerage Intelligence</p>
      <h1>Patek Philippe Aquanaut</h1>
      <p>Focused launch coverage for the steel 5167A and its configuration, ownership, and transaction decisions.</p>
    </section>

    <BrokerageIntelligenceSection
      eyebrow="Aquanaut Intelligence"
      title="Focused collection guidance"
      intro="This launch slice is deliberately limited to the 5167A; conclusions should not be transferred to other Aquanaut materials or complications."
      items={intelligenceItems}
      reviewedAt={patekPhilippeAquanautIntelligence.reviewedAt}
      evidenceSources={patekPhilippeAquanautIntelligence.evidenceSources}
    />

    <section class="priority-reference">
      <p class="eyebrow">Priority Reference</p>
      <a href={referencePath} class="reference-card">
        <span>Current Production · High Liquidity</span>
        <h2>Patek Philippe 5167A</h2>
        <p>{asset.questLuxoView}</p>
        <strong>View Brokerage Intelligence</strong>
      </a>
    </section>

    <BrokerageCTA
      brand="Patek Philippe"
      collection="Aquanaut"
      headline="Looking for a Patek Philippe Aquanaut?"
      description="Source, sell, trade, or value an Aquanaut with exact context preserved for Quest Luxo brokerage."
    />
  </main>
</BaseLayout>

<style>
  .collection-page { background:#07111f; color:#fff; min-height:100vh; }
  .hero,.priority-reference { max-width:1180px; margin:0 auto; padding-left:24px; padding-right:24px; }
  .hero { padding-top:96px; padding-bottom:56px; }
  .eyebrow { color:#d4b06a; font-size:13px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; margin:0 0 14px; }
  h1 { font-size:clamp(48px,8vw,96px); line-height:.95; margin:0 0 24px; }
  h2 { font-size:clamp(34px,5vw,56px); margin:14px 0 18px; }
  .hero p:not(.eyebrow),.reference-card p { max-width:760px; color:rgba(255,255,255,.72); font-size:18px; line-height:1.7; }
  .priority-reference { padding-top:64px; padding-bottom:92px; }
  .reference-card { display:block; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.05); color:#fff; padding:28px; text-decoration:none; }
  .reference-card:hover { border-color:#d4b06a; }
  .reference-card > span,.reference-card > strong { color:#d4b06a; font-size:12px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
  @media(max-width:640px){.hero{padding-top:64px}}
</style>
