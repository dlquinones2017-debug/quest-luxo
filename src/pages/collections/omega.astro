---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrokerageCTA from "../../components/BrokerageCTA.astro";
import BrokerageIntelligenceSection from "../../components/BrokerageIntelligenceSection.astro";
import { omegaBrandIntelligence, omegaCollectionSummaries } from "../../data/omega-intelligence";
import { brands } from "../../data/brands";
import { omegaFactory } from "../../lib/factory/omegaFactory";
import { buildBeginYourQuestUrl } from "../../lib/leads/leadIntakeContext";

const brand = brands.find((item) => item.slug === omegaFactory.slug);
if (!brand) throw new Error("Omega brand metadata is missing.");

const liveCollectionSlugs = new Set(["speedmaster", "seamaster", "planet-ocean", "aqua-terra"]);
const liveCollections = omegaFactory.collections.filter((collection) => liveCollectionSlugs.has(collection.slug));
const comingSoonCollections = omegaFactory.collections.filter((collection) => !liveCollectionSlugs.has(collection.slug));
const beginOmegaQuestUrl = buildBeginYourQuestUrl({ intent: "broker", brand: "Omega" });
const brandIntelligenceItems = [
  { title: "Brokerage Positioning", body: omegaBrandIntelligence.brokeragePositioning },
  { title: "Brand Overview", body: omegaBrandIntelligence.overview },
  { title: "Quest Luxo Perspective", body: omegaBrandIntelligence.perspective },
];
---

<BaseLayout title="Omega | Quest Luxo">
  <main class="brand-page">
    <section class="hero">
      <p class="eyebrow">Omega Factory</p>
      <h1>Omega</h1>
      <p>Reference-led brokerage intelligence for Speedmaster and Seamaster Diver 300M, with controlled coverage before wider Omega factory activation.</p>
      <div class="actions">
        <a href={beginOmegaQuestUrl} class="primary">Begin Your Omega Quest</a>
        <a href="/collections/omega/speedmaster" class="secondary">Explore Speedmaster</a>
      </div>
    </section>

    <BrokerageIntelligenceSection
      eyebrow="Omega Intelligence"
      title="A reference-specific framework for Omega decisions"
      intro="Quest Luxo separates collection heritage from the generation, configuration, condition, service, and market realities of a specific watch."
      items={brandIntelligenceItems}
      evidenceSources={omegaBrandIntelligence.evidenceSources}
    />

    <section class="summary-panel">
      <p class="eyebrow">Quest Luxo Summary</p>
      <h2>{brand.tagline}</h2>
      <p>{brand.description}</p>
      <div class="meta">
        <span>Founded {brand.founded}</span><span>{liveCollections.length} Covered Collections</span><span>{comingSoonCollections.length} Coming Soon</span><span>Launch Phase {brand.launchPhase}</span>
      </div>
    </section>

    <section class="collections">
      <div class="section-header"><p class="eyebrow">Collection Summaries</p><h2>Launch coverage</h2></div>
      <div class="grid">
        {liveCollections.map((collection) => (
          <a href={`/collections/omega/${collection.slug}`} class="card active-card">
            <div class="top"><span>{collection.category}</span><strong>Covered</strong></div>
            <h3>{collection.name}</h3>
            <p class="tagline">{collection.tagline}</p>
            <p>{omegaCollectionSummaries[collection.slug as keyof typeof omegaCollectionSummaries] ?? collection.description}</p>
            <div class="meta-row"><span>{collection.slug === "seamaster" ? 1 : collection.assetCount ?? 0} References</span><span>Explore Collection</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="collections coming-soon">
      <div class="section-header"><p class="eyebrow">Coming Soon Collections</p><h2>Omega factory pipeline</h2></div>
      <div class="grid">
        {comingSoonCollections.map((collection) => (
          <article class="card muted-card">
            <div class="top"><span>{collection.category}</span><strong>Coming Soon</strong></div>
            <h3>{collection.name}</h3><p class="tagline">{collection.tagline}</p><p>{collection.description}</p>
            <div class="meta-row"><span>Not Activated</span><span>Factory Scaffold</span></div>
          </article>
        ))}
      </div>
    </section>

    <BrokerageCTA brand="Omega" headline="Begin an Omega conversation" description="Request, sell, trade, value, or discuss an Omega with context preserved for the Quest Luxo brokerage team." />
  </main>
</BaseLayout>

<style>
  .brand-page{background:#07111f;color:#fff;min-height:100vh}.hero,.summary-panel,.collections{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}.hero{padding-top:96px;padding-bottom:56px}.eyebrow{color:#d4b06a;font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin:0 0 14px}h1{font-size:clamp(54px,9vw,112px);line-height:.92;margin:0 0 28px}h2{font-size:clamp(34px,5vw,56px);line-height:1;margin:0 0 20px}.hero>p:not(.eyebrow),.summary-panel>p:not(.eyebrow),.card p{color:rgba(255,255,255,.72);line-height:1.7}.hero>p:not(.eyebrow){max-width:780px;font-size:20px}.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}.primary,.secondary{padding:15px 22px;text-decoration:none;font-weight:800}.primary{background:#d4b06a;color:#07111f}.secondary{border:1px solid rgba(255,255,255,.18);color:#fff}.summary-panel{padding-top:64px;padding-bottom:64px}.meta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.meta span{background:#173a5e;padding:10px 12px;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.collections{padding-top:36px;padding-bottom:72px}.section-header{margin-bottom:30px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card{display:flex;flex-direction:column;min-height:300px;padding:24px;border:1px solid rgba(255,255,255,.12);color:#fff;text-decoration:none}.active-card{background:rgba(255,255,255,.05)}.muted-card{background:rgba(255,255,255,.025)}.top,.meta-row{display:flex;justify-content:space-between;gap:14px}.top{color:#d4b06a;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.card h3{font-size:30px;margin:28px 0 8px}.tagline{font-weight:800}.meta-row{margin-top:auto;padding-top:22px;color:rgba(255,255,255,.62);font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}@media(max-width:760px){.grid{grid-template-columns:1fr}.hero{padding-top:64px}}
</style>
