---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PrivateSourcingCTA from "../../components/PrivateSourcingCTA.astro";
import { brands } from "../../data/brands";
import { getCollectionsForBrand } from "../../data/collectionRegistry";
import { collectionPath } from "../../lib/routes/collectionRoutes";

export function getStaticPaths() {
  return brands
    .map((brand) => ({ brand, collections: getCollectionsForBrand(brand.slug) }))
    .filter(({ collections }) => collections.length > 0)
    .map(({ brand, collections }) => ({
      params: { brand: brand.slug },
      props: { brand, collections },
    }));
}

const { brand, collections } = Astro.props;
---

<BaseLayout
  title={`${brand.name} Watch Collections | Quest Luxo`}
  description={`Explore Quest Luxo reference intelligence and private sourcing coverage for ${brand.name}.`}
  canonicalPath={`/collections/${brand.slug}`}
>
  <main class="brand-page" id="main-content">
    <section class="hero">
      <p class="eyebrow">QUEST LUXO WATCH HOUSE</p>
      <h1>{brand.name}</h1>
      <p>{brand.description}</p>
      <div class="meta">
        <span>Founded {brand.founded}</span>
        <span>{collections.length} {collections.length === 1 ? "Collection" : "Collections"}</span>
        <span>Private Sourcing Available</span>
      </div>
    </section>

    <section class="collections" aria-labelledby="brand-collections-title">
      <div class="section-header">
        <p class="eyebrow">REFERENCE INTELLIGENCE</p>
        <h2 id="brand-collections-title">{brand.name} Collections</h2>
        <p>
          Each collection uses the shared Quest Luxo architecture for reference profiles,
          configuration intelligence, verified photography, and private sourcing.
        </p>
      </div>

      <div class="grid">
        {collections.map((collection) => (
          <a class="card" href={collectionPath(collection.brandSlug, collection.slug)}>
            <span>{collection.assets.length} {collection.assets.length === 1 ? "reference" : "references"}</span>
            <h3>{collection.name}</h3>
            <p>{collection.description}</p>
            <strong>Explore Collection →</strong>
          </a>
        ))}
      </div>
    </section>

    <PrivateSourcingCTA
      title={`Request Private ${brand.name} Sourcing`}
      text={`Tell Quest Luxo the exact ${brand.name} reference or configuration you want. We will qualify the mandate before sourcing.`}
      button="Begin Your Quest"
      href={`/contact?brand=${encodeURIComponent(brand.name)}`}
    />
  </main>
</BaseLayout>

<style>
  .brand-page{background:#07111f;color:#fff;min-height:100vh}
  .hero,.collections{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}
  .hero{padding-top:96px;padding-bottom:64px}
  .eyebrow{color:#f0d7a0;font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin:0 0 14px}
  h1{font-size:clamp(54px,9vw,112px);line-height:.92;margin:0 0 28px}
  h2{font-size:clamp(34px,5vw,56px);line-height:1;margin:0 0 18px}
  .hero>p,.section-header>p:not(.eyebrow),.card p{color:rgba(255,255,255,.78);font-size:18px;line-height:1.7;max-width:820px}
  .meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px}
  .meta span{border:1px solid rgba(255,255,255,.2);padding:10px 12px;font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .collections{padding-top:56px;padding-bottom:96px}
  .section-header{margin-bottom:30px}
  .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .card{display:flex;flex-direction:column;min-height:300px;padding:26px;border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.05);color:#fff;text-decoration:none}
  .card>span,.card>strong{color:#f0d7a0;font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  .card h3{font-size:32px;margin:28px 0 10px}
  .card strong{margin-top:auto}
  .card:hover,.card:focus-visible{border-color:#f0d7a0}
  @media(max-width:700px){.grid{grid-template-columns:1fr}.hero{padding-top:64px}}
</style>
