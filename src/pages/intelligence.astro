---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBeginYourQuestUrl } from "../lib/leads/leadIntakeContext";
import { getAskQuestLuxoCatalog } from "../lib/intelligence/askQuestLuxo";
import { approvedPhotograph } from "../lib/media/watchPhotography";
import { watchPhotographs } from "../data/watch-photography";

const sourcingHref = buildBeginYourQuestUrl({ intent: "request" });
const catalog = getAskQuestLuxoCatalog();
const brands = [...new Set(catalog.map(record => record.brand))].sort();
const photos = Object.fromEntries(catalog.flatMap(record => {
  const photo = approvedPhotograph(record.asset, watchPhotographs);
  return photo ? [[record.id, { src: photo.src, alt: photo.alt }]] : [];
}));
---

<BaseLayout
  title="Watch Intelligence | Quest Luxo"
  description="Search the Quest Luxo watch catalog by budget, use case, style, collection role, wrist preference, and brand."
  canonicalPath="/intelligence"
>
  <main id="main-content" class="intelligence-page">
    <section class="hero">
      <p class="eyebrow">Quest Luxo Intelligence</p>
      <h1>Describe the watch you actually want.</h1>
      <p class="lede">
        Search the Quest Luxo catalog in plain language. Start with a budget, intended role,
        style, wrist preference, brand, collection, or a combination of them.
      </p>

      <p class="benchmark-note">Budget matches use verified U.S. manufacturer list prices. Actual new or pre-owned sourcing prices and availability require a broker quote.</p>
      <form class="query-form" id="ask-form">
        <label for="ask-query">What are you looking for?</label>
        <div class="query-row">
          <input
            id="ask-query"
            name="query"
            type="text"
            value=""
            autocomplete="off"
            placeholder="Example: I want a networking watch that is not a Rolex, for a large wrist, on a strap"
          />
          <button type="submit">Search</button>
        </div>
      </form>
      <div class="browse-controls">
        <label>Brand <select id="browse-brand"><option value="">All brands</option>{brands.map(brand => <option value={brand}>{brand}</option>)}</select></label>
        <label>Feature <select id="browse-tag"><option value="">All features</option><option value="blue">Blue dial</option><option value="green">Green dial</option><option value="black">Black dial</option><option value="white">White dial</option><option value="rubber-strap">Rubber strap</option><option value="gmt">GMT / world time</option><option value="two-tone">Two-tone</option><option value="precious-metal">All precious metal</option></select></label>
        <button type="button" id="clear-search">Clear filters</button>
      </div>

      <label class="unknown-price-option"><input id="include-unknown-price" type="checkbox" /> For budget searches, include references awaiting price verification</label>

      <div class="presets" aria-label="Suggested searches">
        <button type="button" data-query="best watches under $5000">Under $5,000</button>
        <button type="button" data-query="best watches under $25000">Under $25,000</button>
        <button type="button" data-query="dressy watches">Dress watches</button>
        <button type="button" data-query="collectors watches">Collector watches</button>
        <button type="button" data-query="dive watches">Dive watches</button>
        <button type="button" data-query="starter watches">Starter watches</button>
        <button
          type="button"
          data-query="I want to buy a watch for networking that is not a Rolex. I have a large wrist and prefer it be on a strap"
        >
          Networking, large wrist, strap, no Rolex
        </button>
        <button
          type="button"
          data-query="I have $50,000. What is your recommended collection for all roles?"
        >
          Build around $50,000
        </button>
      </div>
    </section>

    <section class="results-panel" aria-live="polite" aria-labelledby="results-title">
      <div class="results-heading">
        <div>
          <p class="eyebrow">Advisory Search</p>
          <h2 id="results-title">Recommendations</h2>
        </div>
        <p id="count-output" class="count">Searching catalog...</p>
      </div>

      <p id="summary" class="summary-text">
        Search the live Quest Luxo catalog to generate reference-level starting points.
      </p>

      <div id="recommendations-output" class="recommendations"></div>
      <button type="button" id="show-more" hidden>Show more references</button>
      <noscript><p>Enable JavaScript for personalized search, or <a href="/collections">browse the watch collections</a>.</p></noscript>

      <p class="disclaimer">
        Budget filtering uses verified current U.S. manufacturer list prices, rather than market asking prices or historical/international benchmarks.
        References awaiting price verification are excluded from budget matches unless you include them above.
        Recommendations are based on currently modeled Quest Luxo catalog data. Price, availability,
        condition, fit, service history, and secondary-market evidence require transaction-level verification.
        Multi-watch collection searches are advisory starting points and do not yet allocate a total budget across the results.
      </p>
    </section>

    <section class="private-sourcing">
      <div>
        <p class="eyebrow">Need a human recommendation?</p>
        <h2>Turn the search into a sourcing mandate.</h2>
        <p>
          Tell Quest Luxo what you are trying to accomplish and we will qualify the request before sourcing.
        </p>
      </div>
      <a href={sourcingHref}>Begin Your Quest</a>
    </section>
  </main>
</BaseLayout>
<script is:inline id="catalog-photographs" type="application/json" set:html={JSON.stringify(photos).replace(/</g, "\\u003c")} />

<script>
  import { askQuestLuxo } from "../lib/intelligence/askQuestLuxo";
  import { getVerifiedRetailPrices, getRetailPriceSummary, formatRetailPrice, formatRetailTaxBasis } from "../lib/intelligence/watchRetailPricing";
  import { buildBeginYourQuestUrl } from "../lib/leads/leadIntakeContext";

  const form = document.querySelector<HTMLFormElement>("#ask-form");
  const input = document.querySelector<HTMLInputElement>("#ask-query");
  const includeUnknownPrice = document.querySelector<HTMLInputElement>("#include-unknown-price");
  const summary = document.querySelector<HTMLElement>("#summary");
  const countOutput = document.querySelector<HTMLElement>("#count-output");
  const recommendationsOutput = document.querySelector<HTMLElement>("#recommendations-output");
  const presetButtons = document.querySelectorAll<HTMLButtonElement>("[data-query]");
  const brandFilter = document.querySelector<HTMLSelectElement>("#browse-brand");
  const tagFilter = document.querySelector<HTMLSelectElement>("#browse-tag");
  const showMore = document.querySelector<HTMLButtonElement>("#show-more");
  const photos: Record<string, { src: string; alt: string }> = JSON.parse(document.querySelector("#catalog-photographs")?.textContent ?? "{}");
  let resultLimit = 8;

  const currencyFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  });

  function formatCurrency(value: number | null): string {
    return value === null ? "Price research pending" : currencyFormatter.format(value);
  }

  function renderQuery(query: string) {
    const answer = askQuestLuxo({
      query,
      maxResults: resultLimit,
      browse: { brand: brandFilter?.value, tag: tagFilter?.value },
      includeUnknownPrice: includeUnknownPrice?.checked ?? false,
    });

    if (summary) summary.textContent = answer.summary;
    if (showMore) showMore.hidden = answer.rankedResults.length >= answer.totalMatches;
    if (countOutput) {
      countOutput.textContent = `Showing ${answer.recommendations.length} of ${answer.totalMatches} matches`;
    }

    if (!recommendationsOutput) return;
    recommendationsOutput.replaceChildren();

    if (answer.rankedResults.length === 0) {
      const empty = document.createElement("div");
      empty.className = "empty";
      const title = document.createElement("h3");
      title.textContent = answer.emptyState?.title ?? "No exact matches yet.";
      const copy = document.createElement("p");
      copy.textContent =
        answer.emptyState?.guidance.join(" ") ??
        "Try broadening the budget, brand, collection, or use-case language.";
      empty.append(title, copy);
      recommendationsOutput.append(empty);
      return;
    }

    answer.rankedResults.forEach((result) => {
      const recommendation = result.recommendation;
      const item = document.createElement("article");
      item.className = "recommendation";
      const photo = photos[result.record.id];
      if (photo) {
        const image = document.createElement("img");
        image.src = photo.src; image.alt = photo.alt; image.width = 240; image.height = 240; image.loading = "lazy";
        image.className = "recommendation-photo";
        item.append(image);
      }

      const top = document.createElement("div");
      top.className = "recommendation-top";

      const identity = document.createElement("div");
      const brand = document.createElement("p");
      brand.className = "brand";
      brand.textContent = recommendation.brand;
      const heading = document.createElement("h3");
      heading.textContent = recommendation.model;
      const ref = document.createElement("p");
      ref.className = "reference";
      ref.textContent = `Ref. ${recommendation.reference}`;
      identity.append(brand, heading, ref);

      const price = document.createElement("p");
      price.className = "price";
      price.textContent = recommendation.estimatedPrice === null
        ? "Current U.S. price unverified"
        : `Published MSRP from ${formatCurrency(recommendation.estimatedPrice)}`;
      top.append(identity, price);

      const details = document.createElement("div");
      details.className = "details";

      const position = document.createElement("span");
      position.textContent = recommendation.marketPosition;
      details.append(position);

      recommendation.reasons.slice(0, 2).forEach((reason) => {
        const badge = document.createElement("span");
        badge.textContent = reason;
        details.append(badge);
      });

      item.append(top, details);

      const retailPrices = getVerifiedRetailPrices(recommendation.asset, recommendation.brand);
      const retailPrice = retailPrices.find((entry) => entry.amount === recommendation.estimatedPrice && entry.currency === "USD" && entry.basis === "current-list" && entry.configurationScope !== "base-reference")
        ?? getRetailPriceSummary(retailPrices)?.price;
      if (retailPrice) {
        if (recommendation.estimatedPrice === null) {
          const label = retailPrice.basis === "historical-list" ? "Historical list" : "Published list";
          const period = retailPrice.effectiveDate ?? retailPrice.effectivePeriod;
          price.textContent = `${label}: ${formatRetailPrice(retailPrice)} ${retailPrice.currency}${period ? ` (${period})` : ""}. Current U.S. benchmark unverified.`;
        }
        const source = document.createElement("a");
        source.href = retailPrice.sourceUrl;
        source.target = "_blank";
        source.rel = "noopener noreferrer external";
        source.textContent = `${retailPrice.configuration}${retailPrice.configurationScope === "base-reference" ? " · Base-reference benchmark; pictured configuration not fully priced" : ""} · ${retailPrice.sourceName} · checked ${retailPrice.checkedAt} · ${retailPrice.market}; ${formatRetailTaxBasis(retailPrice)}`;
        source.className = "retail-source";
        item.append(source);
      }

      if (result.record.url) {
        const link = document.createElement("a");
        link.href = result.record.url;
        link.textContent = "View reference";
        link.className = "reference-link";
        item.append(link);
      }
      const sourceLink = document.createElement("a");
      sourceLink.href = buildBeginYourQuestUrl({ intent: "request-this-watch", brand: result.record.brand, collection: result.record.collection, reference: result.record.asset.displayReference ?? result.record.reference });
      sourceLink.textContent = "Begin Your Quest →";
      sourceLink.className = "reference-link sourcing-link";
      item.append(sourceLink);

      recommendationsOutput.append(item);
    });
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    resultLimit = 8;
    renderQuery(input?.value.trim() || "watches");
  });

  const refresh = () => { resultLimit = 8; renderQuery(input?.value.trim() || "watches"); };
  includeUnknownPrice?.addEventListener("change", refresh);
  brandFilter?.addEventListener("change", refresh);
  tagFilter?.addEventListener("change", refresh);
  showMore?.addEventListener("click", () => { resultLimit += 8; renderQuery(input?.value.trim() || "watches"); });
  document.querySelector("#clear-search")?.addEventListener("click", () => {
    if (input) input.value = "";
    if (brandFilter) brandFilter.value = "";
    if (tagFilter) tagFilter.value = "";
    if (includeUnknownPrice) includeUnknownPrice.checked = false;
    refresh();
  });

  presetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const query = button.dataset.query ?? "";
      if (input) input.value = query;
      resultLimit = 8;
      renderQuery(query);
    });
  });

  renderQuery(input?.value.trim() || "watches");
</script>

<style>
  .benchmark-note{font-size:14px;line-height:1.6;color:#596471;max-width:800px}
  .browse-controls{display:flex;flex-wrap:wrap;align-items:end;gap:16px;margin:20px 0}.browse-controls label{display:grid;gap:8px;font-size:14px}.browse-controls select,.browse-controls button,#show-more{padding:12px;border:1px solid #c8c2b8;background:#fff;color:#173a5e;font:inherit;min-height:44px;max-width:100%}
  :global(.recommendation-photo){display:block;width:180px;height:180px;object-fit:contain;background:#fff;margin-bottom:18px}
  :global(.sourcing-link){margin-left:16px}
  .intelligence-page {
    background: #faf9f7;
    color: #07111f;
  }

  .hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 28px 42px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #8a682b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 860px;
    margin-bottom: 18px;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 0.98;
  }

  .lede {
    max-width: 780px;
    margin-bottom: 30px;
    color: #52606f;
    font-size: 18px;
    line-height: 1.7;
  }

  .query-form {
    margin-bottom: 18px;
  }

  .unknown-price-option { display: flex; align-items: center; gap: 10px; font-size: 14px; margin-bottom: 18px; }
  .unknown-price-option input { width: 18px; height: 18px; min-height: 0; }
  .recommendations :global(.retail-source) { display: block; color: #52606f; font-size: 12px; margin-bottom: 18px; text-underline-offset: 3px; }

  label {
    display: block;
    margin-bottom: 9px;
    font-weight: 800;
  }

  .query-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  input,
  button {
    min-height: 50px;
    border: 1px solid #d9d2c5;
    border-radius: 0;
    font: inherit;
  }

  input {
    padding: 0 16px;
    background: #ffffff;
    color: #07111f;
  }

  button {
    cursor: pointer;
    padding: 0 20px;
    background: #07111f;
    color: #ffffff;
    font-weight: 800;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .presets button {
    min-height: 40px;
    background: #ffffff;
    color: #173a5e;
    font-size: 13px;
  }

  .results-panel {
    max-width: 1180px;
    margin: 0 auto;
    padding: 30px 28px 64px;
  }

  .results-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    border-bottom: 1px solid #e8e3d8;
    padding-bottom: 18px;
  }

  .results-heading h2 {
    margin-bottom: 0;
    font-size: 36px;
  }

  .count {
    margin-bottom: 4px;
    color: #52606f;
    font-weight: 800;
  }

  .summary-text {
    max-width: 900px;
    margin: 24px 0;
    color: #38495b;
    font-size: 17px;
    line-height: 1.65;
  }

  .recommendations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .recommendations :global(.recommendation),
  .recommendations :global(.empty) {
    border: 1px solid #e0d9cc;
    background: #ffffff;
    padding: 22px;
  }

  .recommendations :global(.recommendation-top) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }

  .recommendations :global(.brand) {
    margin-bottom: 5px;
    color: #8a682b;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recommendations :global(.recommendation h3) {
    margin-bottom: 5px;
    font-size: 23px;
  }

  .recommendations :global(.reference) {
    margin-bottom: 0;
    color: #66727f;
    font-size: 14px;
  }

  .recommendations :global(.price) {
    margin-bottom: 0;
    color: #173a5e;
    font-weight: 800;
    white-space: normal;
  }

  .recommendations :global(.details) {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 18px 0;
  }

  .recommendations :global(.details span) {
    border: 1px solid #e1d8c6;
    padding: 7px 9px;
    color: #52606f;
    font-size: 12px;
  }

  .recommendations :global(.reference-link) {
    color: #173a5e;
    font-weight: 800;
    text-underline-offset: 4px;
  }

  .disclaimer {
    max-width: 900px;
    margin: 24px 0 0;
    color: #6d7781;
    font-size: 13px;
    line-height: 1.65;
  }

  .private-sourcing {
    display: flex;
    justify-content: space-between;
    gap: 36px;
    align-items: center;
    padding: 46px max(28px, calc((100vw - 1124px) / 2));
    background: #07111f;
    color: #ffffff;
  }

  .private-sourcing h2 {
    margin-bottom: 10px;
    font-size: 34px;
  }

  .private-sourcing p:not(.eyebrow) {
    max-width: 720px;
    margin-bottom: 0;
    color: #c5ced7;
    line-height: 1.65;
  }

  .private-sourcing a {
    flex: 0 0 auto;
    padding: 15px 20px;
    background: #ffffff;
    color: #07111f;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .query-row,
    .recommendations {
      grid-template-columns: 1fr;
    }

    .results-heading,
    .recommendations :global(.recommendation-top),
    .private-sourcing {
      align-items: flex-start;
      flex-direction: column;
    }

    .query-row button {
      width: 100%;
    }
  }
</style>
