---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  createMarketOpportunityScore,
  getMarketOpportunityRoadmap,
} from "../../lib/market/marketOpportunityRoadmap";

export const prerender = false;

if (import.meta.env.PROD) {
  return Astro.redirect("/", 302);
}

const marketOpportunityCards = getMarketOpportunityRoadmap().map(
  (opportunity) => ({
    opportunity,
    opportunityScore: createMarketOpportunityScore(opportunity),
  })
);

const formatSignal = (signal: string) =>
  signal
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
---

<BaseLayout title="Ask Quest Luxo Developer Playground">
  <main class="dev-playground">
    <section class="workspace">
      <div class="header">
        <p class="eyebrow">Developer Only</p>
        <h1>Ask Quest Luxo Playground</h1>
      </div>

      <form class="query-form" id="ask-form">
        <label for="ask-query">Query</label>
        <div class="query-row">
          <input
            id="ask-query"
            name="query"
            type="text"
            value="watches under $25000"
            autocomplete="off"
          />
          <button type="submit">Ask</button>
        </div>
      </form>

      <div class="presets" aria-label="Preset queries">
        <button type="button" data-query="watches under $25000">
          Watches under $25,000
        </button>
        <button type="button" data-query="Rolex under $15000">
          Rolex under $15,000
        </button>
        <button type="button" data-query="best investment watches">
          Best investment watches
        </button>
        <button type="button" data-query="blue dial Rolex">
          Blue dial Rolex
        </button>
        <button type="button" data-query="daily watch">Daily watch</button>
        <button type="button" data-query="sports watch">Sports watch</button>
      </div>

      <section class="results-panel" aria-live="polite">
        <div>
          <p class="eyebrow">Summary</p>
          <p id="summary" class="summary-text">Run a query to inspect results.</p>
        </div>

        <div class="details-grid">
          <div class="panel">
            <h2>Parsed Intent</h2>
            <pre id="intent-output">{}</pre>
          </div>

          <div class="panel">
            <h2>Recommendations</h2>
            <p id="count-output" class="count">0 recommendations</p>
            <div id="recommendations-output" class="recommendations"></div>
          </div>
        </div>
      </section>

      <section class="market-roadmap" aria-labelledby="market-roadmap-title">
        <div class="section-header">
          <p class="eyebrow">Internal Roadmap</p>
          <h2 id="market-roadmap-title">Market Opportunity Roadmap</h2>
          <p>
            Static brokerage expansion signals for reviewing future brand and
            collection opportunities.
          </p>
        </div>

        <div class="roadmap-grid">
          {
            marketOpportunityCards.map(({ opportunity, opportunityScore }) => (
              <article
                class:list={[
                  "roadmap-card",
                  opportunity.priority === "high" && "is-high-priority",
                  opportunityScore.tier === "urgent" && "is-high-score",
                ]}
              >
                <div class="roadmap-card-header">
                  <div>
                    <p class="eyebrow">{opportunity.brand}</p>
                    <h3>{opportunity.collection}</h3>
                  </div>
                  <span
                    class:list={[
                      "signal-badge",
                      `signal-${opportunity.priority}`,
                    ]}
                  >
                    {formatSignal(opportunity.priority)} Priority
                  </span>
                </div>

                <div class="score-panel">
                  <div>
                    <span>Opportunity Score</span>
                    <strong>{opportunityScore.score}/100</strong>
                  </div>
                  <span
                    class:list={[
                      "tier-badge",
                      `tier-${opportunityScore.tier}`,
                    ]}
                  >
                    {formatSignal(opportunityScore.tier)}
                  </span>
                </div>

                <dl class="roadmap-signals">
                  <div>
                    <dt>Brokerage Momentum</dt>
                    <dd>{formatSignal(opportunity.brokerageMomentum)}</dd>
                  </div>
                  <div>
                    <dt>Search Demand</dt>
                    <dd>{formatSignal(opportunity.searchDemand)}</dd>
                  </div>
                  <div>
                    <dt>Average Ticket</dt>
                    <dd>{formatSignal(opportunity.averageTicketPotential)}</dd>
                  </div>
                  <div>
                    <dt>Dealer Network</dt>
                    <dd>{formatSignal(opportunity.dealerNetworkSignal)}</dd>
                  </div>
                </dl>

                <div class="roadmap-copy">
                  <div>
                    <h4>Rationale</h4>
                    <p>{opportunity.rationale}</p>
                  </div>
                  <div>
                    <h4>Recommended Next Action</h4>
                    <p>{opportunity.recommendedNextAction}</p>
                  </div>
                  <div class="roadmap-reasons">
                    <h4>Score Reasons</h4>
                    <ul>
                      {opportunityScore.reasons.map((reason) => (
                        <li>{reason}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </section>
  </main>
</BaseLayout>

<script>
  import { askQuestLuxo } from "../../lib/intelligence/askQuestLuxo";

  const form = document.querySelector<HTMLFormElement>("#ask-form");
  const input = document.querySelector<HTMLInputElement>("#ask-query");
  const summary = document.querySelector<HTMLElement>("#summary");
  const intentOutput = document.querySelector<HTMLElement>("#intent-output");
  const countOutput = document.querySelector<HTMLElement>("#count-output");
  const recommendationsOutput = document.querySelector<HTMLElement>(
    "#recommendations-output"
  );
  const presetButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-query]"
  );

  const currencyFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  });

  function formatCurrency(value: number | null): string {
    return value === null ? "Research pending" : currencyFormatter.format(value);
  }

  function renderQuery(query: string) {
    const answer = askQuestLuxo({
      query,
      maxResults: 6,
    });

    if (summary) {
      summary.textContent = answer.summary;
    }

    if (intentOutput) {
      intentOutput.textContent = JSON.stringify(answer.intent, null, 2);
    }

    if (countOutput) {
      countOutput.textContent = `${answer.recommendations.length} recommendation${
        answer.recommendations.length === 1 ? "" : "s"
      }`;
    }

    if (!recommendationsOutput) {
      return;
    }

    recommendationsOutput.replaceChildren();

    if (answer.recommendations.length === 0) {
      const empty = document.createElement("p");
      empty.className = "empty";
      empty.textContent =
        answer.emptyState?.guidance.join(" ") ??
        "No matching recommendations were found.";
      recommendationsOutput.append(empty);
      return;
    }

    answer.recommendations.forEach((recommendation) => {
      const item = document.createElement("article");
      item.className = "recommendation";

      const heading = document.createElement("h3");
      heading.textContent = `${recommendation.brand} ${recommendation.reference}`;

      const model = document.createElement("p");
      model.className = "model";
      model.textContent = recommendation.model;

      const details = document.createElement("dl");
      details.innerHTML = `
        <div>
          <dt>Investment score</dt>
          <dd>${recommendation.scores.investmentScore}</dd>
        </div>
        <div>
          <dt>Liquidity</dt>
          <dd>${recommendation.asset.liquidity ?? recommendation.scores.liquidityScore}</dd>
        </div>
        <div>
          <dt>Estimated MSRP</dt>
          <dd>${formatCurrency(recommendation.estimatedPrice)}</dd>
        </div>
      `;

      item.append(heading, model, details);
      recommendationsOutput.append(item);
    });
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    renderQuery(input?.value.trim() || "watches under $25000");
  });

  presetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const query = button.dataset.query ?? "";

      if (input) {
        input.value = query;
      }

      renderQuery(query);
    });
  });

  renderQuery(input?.value.trim() || "watches under $25000");
</script>

<style>
  .dev-playground {
    min-height: 100vh;
    background: #f5f3ef;
    color: #132338;
  }

  .workspace {
    max-width: 1180px;
    margin: 0 auto;
    padding: 48px 24px 72px;
  }

  .header {
    margin-bottom: 28px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #9a7633;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    font-size: 40px;
    line-height: 1.05;
  }

  h2 {
    margin-bottom: 14px;
    font-size: 18px;
  }

  h3 {
    margin-bottom: 4px;
    font-size: 18px;
  }

  .query-form {
    margin-bottom: 18px;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-weight: 800;
  }

  .query-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  input,
  button {
    min-height: 44px;
    border: 1px solid #d8d0c3;
    font: inherit;
  }

  input {
    padding: 0 14px;
    background: #ffffff;
    color: #132338;
  }

  button {
    cursor: pointer;
    background: #132338;
    color: #ffffff;
    font-weight: 800;
    padding: 0 18px;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }

  .presets button {
    min-height: 38px;
    background: #ffffff;
    color: #132338;
  }

  .results-panel {
    display: grid;
    gap: 20px;
    margin-bottom: 34px;
  }

  .summary-text {
    margin-bottom: 0;
    font-size: 18px;
    line-height: 1.55;
  }

  .details-grid {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .panel {
    border: 1px solid #d8d0c3;
    background: #ffffff;
    padding: 20px;
  }

  pre {
    overflow: auto;
    margin: 0;
    color: #24364b;
    font-size: 13px;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .count {
    margin-bottom: 14px;
    color: #536171;
    font-weight: 800;
  }

  .recommendations {
    display: grid;
    gap: 12px;
  }

  .recommendation {
    border: 1px solid #e4ded4;
    padding: 14px;
  }

  .model {
    margin-bottom: 12px;
    color: #536171;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }

  dt {
    color: #6b7480;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  dd {
    margin: 4px 0 0;
    font-weight: 800;
  }

  .empty {
    margin: 0;
    color: #536171;
    line-height: 1.6;
  }

  .market-roadmap {
    display: grid;
    gap: 18px;
  }

  .section-header {
    max-width: 760px;
  }

  .section-header h2 {
    margin-bottom: 8px;
    font-size: 26px;
  }

  .section-header p:last-child {
    margin-bottom: 0;
    color: #536171;
    line-height: 1.6;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .roadmap-card {
    border: 1px solid #d8d0c3;
    background: #ffffff;
    padding: 18px;
  }

  .roadmap-card.is-high-priority {
    border-color: #b89145;
    box-shadow: inset 4px 0 0 #b89145;
  }

  .roadmap-card.is-high-score {
    background: linear-gradient(180deg, #fffaf0 0%, #ffffff 42%);
  }

  .roadmap-card-header {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .roadmap-card-header h3 {
    margin-bottom: 0;
  }

  .signal-badge {
    align-self: flex-start;
    border: 1px solid #d8d0c3;
    color: #24364b;
    font-size: 12px;
    font-weight: 900;
    padding: 7px 10px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .signal-high {
    border-color: #b89145;
    background: #f5ead6;
    color: #7b581c;
  }

  .signal-medium {
    background: #f6f3ee;
  }

  .signal-low {
    background: #eef1f3;
    color: #536171;
  }

  .score-panel {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    border: 1px solid #e4ded4;
    background: #fbfaf7;
    margin-bottom: 16px;
    padding: 12px;
  }

  .score-panel span {
    display: block;
    color: #6b7480;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .score-panel strong {
    display: block;
    margin-top: 4px;
    color: #132338;
    font-size: 28px;
    line-height: 1;
  }

  .tier-badge {
    border: 1px solid #d8d0c3;
    color: #24364b;
    font-size: 12px;
    font-weight: 900;
    padding: 7px 10px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tier-urgent {
    border-color: #b89145;
    background: #132338;
    color: #ffffff;
  }

  .tier-strong {
    border-color: #b89145;
    background: #f5ead6;
    color: #7b581c;
  }

  .tier-emerging {
    background: #f6f3ee;
  }

  .tier-watchlist {
    background: #eef1f3;
    color: #536171;
  }

  .roadmap-signals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .roadmap-signals div {
    border-top: 1px solid #e4ded4;
    padding-top: 10px;
  }

  .roadmap-copy {
    display: grid;
    gap: 12px;
  }

  h4 {
    margin: 0 0 6px;
    color: #132338;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .roadmap-copy p {
    margin-bottom: 0;
    color: #536171;
    line-height: 1.6;
  }

  .roadmap-reasons ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 18px;
    color: #536171;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .query-row,
    .details-grid,
    dl,
    .roadmap-grid,
    .roadmap-signals {
      grid-template-columns: 1fr;
    }

    .roadmap-card-header {
      display: grid;
    }

    .score-panel {
      align-items: flex-start;
      display: grid;
    }
  }
</style>
