---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Begin Your Quest | Quest Luxo"
  description="Begin a private luxury timepiece sourcing conversation with Quest Luxo."
  canonicalPath="/contact"
>
  <main id="main-content">
    <section class="contact">
      <p class="eyebrow">PRIVATE CLIENT ADVISORY</p>
      <h1>Begin Your Quest</h1>
      <p class="intro" data-contact-intro>
        Start a private conversation with Quest Luxo about the timepiece or
        collection you are seeking.
      </p>
      <p class="response-standard">
        A Quest Luxo advisor reviews each complete inquiry and responds within
        one business day.
      </p>

      <form data-lead-form novalidate>
        <input type="hidden" name="formStartedAt" data-form-started />
        <label class="honeypot" aria-hidden="true" hidden>
          Website
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <div class="form-grid">
          <label>
            Full name <span aria-hidden="true">*</span>
            <input
              name="name"
              type="text"
              autocomplete="name"
              maxlength="120"
              required
            />
          </label>
          <label>
            Email <span aria-hidden="true">*</span>
            <input
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
            />
          </label>
          <label>
            Phone
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </label>
          <label>
            Desired watch
            <input name="desiredWatch" type="text" maxlength="240" />
          </label>
          <label>
            Budget range
            <select name="budget">
              <option value="">Select a range</option>
              <option>Under $10,000</option>
              <option>$10,000–$25,000</option>
              <option>$25,000–$50,000</option>
              <option>$50,000–$100,000</option>
              <option>$100,000+</option>
              <option>Prefer not to say</option>
            </select>
          </label>
          <label>
            Timeline
            <select name="timeline">
              <option value="">Select timing</option>
              <option>Immediately</option>
              <option>Within 30 days</option>
              <option>1–3 months</option>
              <option>3–6 months</option>
              <option>Researching</option>
            </select>
          </label>
        </div>

        <label>
          Inquiry details <span aria-hidden="true">*</span>
          <textarea name="message" maxlength="2000" required></textarea>
        </label>

        <p class="privacy-notice">
          By submitting, you ask Quest Luxo to contact you about this inquiry
          and acknowledge our <a href="/privacy">Privacy Policy</a> and
          <a href="/terms">Terms of Use</a>.
        </p>
        <p
          class="form-status"
          data-form-status
          role="status"
          aria-live="polite"
        ></p>
        <button type="submit" data-submit>Begin My Quest</button>
      </form>

      <p class="direct-contact">
        Prefer email?
        <a
          href="mailto:contact@questluxo.com?subject=Quest%20Luxo%20private%20sourcing%20inquiry"
          data-contact-link
        >contact@questluxo.com</a>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const requestedCollection = params.get("collection");
  const intro = document.querySelector<HTMLElement>("[data-contact-intro]");
  const contactLink =
    document.querySelector<HTMLAnchorElement>("[data-contact-link]");
  const form = document.querySelector<HTMLFormElement>("[data-lead-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");
  const submit = document.querySelector<HTMLButtonElement>("[data-submit]");
  const started =
    document.querySelector<HTMLInputElement>("[data-form-started]");

  if (requestedCollection) {
    if (intro) {
      intro.textContent = `Start a private conversation about ${requestedCollection}.`;
    }
    if (contactLink) {
      const subject = encodeURIComponent(
        `Quest Luxo inquiry: ${requestedCollection}`
      );
      contactLink.href = `mailto:contact@questluxo.com?subject=${subject}`;
    }
  }

  if (started) started.value = String(Date.now());

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    status?.classList.remove("error", "success");
    if (status) status.textContent = "";

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    const payload = {
      ...data,
      intent: params.get("intent") ?? "private-sourcing",
      brand: params.get("brand") ?? "",
      collection: requestedCollection ?? "",
      reference: params.get("reference") ?? "",
      source: "contact",
    };

    if (submit) {
      submit.disabled = true;
      submit.textContent = "Submitting…";
    }

    try {
      const response = await fetch("/api/leads/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok || result.success !== true) {
        throw new Error(result.error || "Unable to submit your inquiry.");
      }
      if (status) {
        status.textContent = result.message;
        status.classList.add("success");
      }
      form.reset();
      if (started) started.value = String(Date.now());
    } catch (error) {
      if (status) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Unable to submit. Please email contact@questluxo.com.";
        status.classList.add("error");
      }
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = "Begin My Quest";
      }
    }
  });
</script>

<style>
  .contact {
    min-height: 62vh;
    padding: 104px 30px;
    text-align: center;
    background:
      linear-gradient(rgba(250, 249, 247, 0.94), rgba(250, 249, 247, 0.94)),
      radial-gradient(circle at top, rgba(212, 176, 106, 0.2), transparent 42%);
  }

  .eyebrow {
    color: #8a682b;
    letter-spacing: 4px;
    font-size: 12px;
    font-weight: 800;
  }

  h1 {
    color: #173a5e;
    font-size: clamp(48px, 8vw, 76px);
    margin: 20px 0 24px;
  }

  .intro {
    max-width: 720px;
    margin: 0 auto;
    color: #43515f;
    font-size: 20px;
    line-height: 1.8;
  }

  .response-standard {
    color: #3f4e5c;
    margin: 18px auto 0;
  }

  form {
    display: grid;
    gap: 20px;
    max-width: 820px;
    margin: 42px auto 0;
    padding: 34px;
    text-align: left;
    background: #ffffff;
    border: 1px solid #ded7ca;
    box-shadow: 0 18px 50px rgba(23, 58, 94, 0.08);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  label {
    display: grid;
    gap: 8px;
    color: #173a5e;
    font-weight: 800;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 13px;
    border: 1px solid #a9b1b8;
    border-radius: 4px;
    color: #17283a;
    background: #ffffff;
    font: inherit;
  }

  textarea {
    min-height: 140px;
    resize: vertical;
  }

  .honeypot {
    display: none;
  }

  .privacy-notice,
  .form-status,
  .direct-contact {
    color: #43515f;
    font-size: 14px;
    line-height: 1.65;
  }

  .privacy-notice a,
  .direct-contact a {
    color: #173a5e;
  }

  .form-status {
    min-height: 24px;
    margin: 0;
  }

  .form-status.error {
    color: #8c251b;
  }

  .form-status.success {
    color: #245d31;
  }

  button {
    min-height: 50px;
    border: 0;
    border-radius: 4px;
    color: #ffffff;
    background: #173a5e;
    font-weight: 900;
    cursor: pointer;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .direct-contact {
    margin-top: 22px;
  }

  @media (max-width: 700px) {
    .form-grid {
      grid-template-columns: 1fr;
    }

    form {
      padding: 24px 20px;
    }
  }
</style>
