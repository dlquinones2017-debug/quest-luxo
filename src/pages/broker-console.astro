---
import BaseLayout from "../layouts/BaseLayout.astro";
import { validateBrokerConsoleAccess } from "../lib/broker/brokerAuth";

const brokerAuth = validateBrokerConsoleAccess(Astro.request);
const isBrokerConsoleLocked = !brokerAuth.allowed;
---

<BaseLayout title="Broker Console MVP | Quest Luxo">
  <main
    class="console-page"
    data-broker-console
    data-broker-auth-configured={brokerAuth.configured ? "true" : "false"}
    data-broker-auth-allowed={brokerAuth.allowed ? "true" : "false"}
  >
    <section class="console-shell">
      <header class="console-header">
        <div>
          <p class="eyebrow">Internal Console</p>
          <h1>Broker Leads</h1>
          <p>
            Private lead desk for locally persisted Begin Your Quest submissions.
          </p>
        </div>

        <div class="summary-card" aria-live="polite">
          <span data-lead-count>0</span>
          <p>Saved Leads</p>
        </div>
      </header>

      <section
        class="state-panel state-panel--locked"
        data-locked-state
        hidden={!isBrokerConsoleLocked}
      >
        <p class="eyebrow">Locked</p>
        <h2>Broker Console access key required.</h2>
        <p data-locked-message>
          Open this internal console with a valid access key in the URL.
        </p>
      </section>

      <section
        class="state-panel"
        data-loading-state
        aria-live="polite"
        hidden={isBrokerConsoleLocked}
      >
        <p class="eyebrow">Loading</p>
        <h2>Reading lead submissions...</h2>
      </section>

      <section class="state-panel" data-empty-state hidden>
        <p class="eyebrow">Empty</p>
        <h2>No saved leads yet.</h2>
        <p>New valid brokerage submissions will appear here after they are saved.</p>
      </section>

      <section class="state-panel state-panel--error" data-error-state hidden>
        <p class="eyebrow">Error</p>
        <h2>Unable to load broker leads.</h2>
        <p data-error-message>
          Refresh the console or check the server logs for the broker leads API.
        </p>
      </section>

      <section
        class="brokerage-economics-anchor"
        data-brokerage-economics-anchor
        hidden={isBrokerConsoleLocked}
      ></section>

      <section class="lead-board" data-lead-board hidden>
        <div class="board-heading">
          <p class="eyebrow">Newest First</p>
          <h2>Persisted Leads</h2>
        </div>

        <section class="metrics-panel" aria-label="Brokerage pipeline metrics">
          <div class="metrics-group">
            <div class="metrics-heading">
              <p class="eyebrow">All Leads</p>
              <h3>Pipeline Totals</h3>
            </div>

            <div class="metrics-grid">
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="total">0</span>
                <p>Total</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="new">0</span>
                <p>New</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="contacted">0</span>
                <p>Contacted</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="sourcing">0</span>
                <p>Sourcing</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="offer-sent">0</span>
                <p>Offer Sent</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="closed">0</span>
                <p>Closed</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="all" data-metric-count="lost">0</span>
                <p>Lost</p>
              </div>
              <div class="metric-card metric-card--delivery">
                <span data-metric-scope="all" data-metric-count="email-sent">0</span>
                <p>Email Sent</p>
              </div>
              <div class="metric-card metric-card--delivery">
                <span data-metric-scope="all" data-metric-count="email-skipped">0</span>
                <p>Email Skipped</p>
              </div>
              <div class="metric-card metric-card--delivery">
                <span data-metric-scope="all" data-metric-count="email-failed">0</span>
                <p>Email Failed</p>
              </div>
            </div>
          </div>

          <div class="metrics-group">
            <div class="metrics-heading">
              <p class="eyebrow">Filtered Results</p>
              <h3>Current View</h3>
            </div>

            <div class="metrics-grid">
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="total">0</span>
                <p>Total</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="new">0</span>
                <p>New</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="contacted">0</span>
                <p>Contacted</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="sourcing">0</span>
                <p>Sourcing</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="offer-sent">0</span>
                <p>Offer Sent</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="closed">0</span>
                <p>Closed</p>
              </div>
              <div class="metric-card">
                <span data-metric-scope="filtered" data-metric-count="lost">0</span>
                <p>Lost</p>
              </div>
              <div class="metric-card metric-card--delivery">
                <span data-metric-scope="filtered" data-metric-count="email-sent">0</span>
                <p>Email Sent</p>
              </div>
              <div class="metric-card metric-card--delivery">
                <span data-metric-scope="filtered" data-metric-count="email-skipped">0</span>
                <p>Email Skipped</p>
              </div>
              <div class="metric-card metric-card--delivery">
                <span data-metric-scope="filtered" data-metric-count="email-failed">0</span>
                <p>Email Failed</p>
              </div>
            </div>
          </div>
        </section>

        <section
          class="economics-coverage"
          aria-label="Economics coverage summary"
        >
          <div class="metrics-heading">
            <div>
              <p class="eyebrow">Latest Saved Analysis</p>
              <h3>Economics Coverage</h3>
            </div>
          </div>

          <div class="economics-coverage-grid">
            <div class="metric-card">
              <span data-economics-coverage-count="total">0</span>
              <p>Total Leads</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="current-risk-guidance">0</span>
              <p>Current Risk Guidance</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="not-analyzed">0</span>
              <p>Not Analyzed</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="legacy-analysis">0</span>
              <p>Legacy Analysis</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="protected">0</span>
              <p>Protected</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="exposed">0</span>
              <p>Exposed</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="fragile">0</span>
              <p>Fragile</p>
            </div>
            <div class="metric-card">
              <span data-economics-coverage-count="unprofitable">0</span>
              <p>Unprofitable</p>
            </div>
            <div class="metric-card metric-card--delivery">
              <span data-economics-coverage-count="model-cautions">0</span>
              <p>Model Cautions</p>
            </div>
          </div>
        </section>

        <div class="console-tools">
          <div class="lead-stats" aria-label="Lead summary counts">
            <div class="lead-stat">
              <span data-summary-count="total">0</span>
              <p>Total</p>
            </div>
            <div class="lead-stat">
              <span data-summary-count="new">0</span>
              <p>New</p>
            </div>
            <div class="lead-stat">
              <span data-summary-count="contacted">0</span>
              <p>Contacted</p>
            </div>
            <div class="lead-stat">
              <span data-summary-count="sourcing">0</span>
              <p>Sourcing</p>
            </div>
            <div class="lead-stat">
              <span data-summary-count="closed">0</span>
              <p>Closed</p>
            </div>
            <div class="lead-stat">
              <span data-summary-count="lost">0</span>
              <p>Lost</p>
            </div>
          </div>

          <div class="filter-controls">
            <label>
              Status
              <select data-status-filter>
                <option value="all">All</option>
                <option value="new">New</option>
                <option value="contacted">Contacted</option>
                <option value="sourcing">Sourcing</option>
                <option value="offer-sent">Offer Sent</option>
                <option value="closed">Closed</option>
                <option value="lost">Lost</option>
              </select>
            </label>

            <label>
              Economics
              <select data-economics-filter>
                <option value="all">All Economics</option>
                <option value="not-analyzed">Not Analyzed</option>
                <option value="legacy-analysis">Legacy Analysis</option>
                <option value="protected">Protected</option>
                <option value="exposed">Exposed</option>
                <option value="fragile">Fragile</option>
                <option value="unprofitable">Unprofitable</option>
                <option value="incomplete">Incomplete</option>
                <option value="model-caution">Model Caution</option>
              </select>
            </label>

            <label>
              Sort
              <select data-economics-sort>
                <option value="current">Current / Default Lead Order</option>
                <option value="needs-analysis-first">Needs Analysis First</option>
                <option value="highest-base-profit">Highest Base Profit</option>
                <option value="lowest-base-profit">Lowest Base Profit</option>
                <option value="highest-roi">Highest ROI</option>
                <option value="lowest-roi">Lowest ROI</option>
                <option value="most-recently-analyzed">Most Recently Analyzed</option>
                <option value="least-recently-analyzed">Least Recently Analyzed</option>
              </select>
            </label>

            <label>
              Search
              <input
                type="search"
                data-search-filter
                placeholder="Name, email, watch, message, notes, or tags"
                autocomplete="off"
              />
            </label>
          </div>

          <div class="export-controls">
            <button type="button" data-export-csv disabled>Export CSV</button>
            <p data-export-message>No filtered leads available to export.</p>
          </div>
        </div>

        <section class="filter-empty" data-filter-empty hidden>
          <p class="eyebrow">No Matches</p>
          <h3>No leads match those filters.</h3>
          <p>Adjust the status, economics, or search filters to widen the view.</p>
        </section>

        <div class="lead-list" data-lead-list></div>
      </section>
    </section>
  </main>
</BaseLayout>

<script>
  import { createBrokerLeadIntelligence } from "../lib/broker/brokerLeadIntelligence";
  import { createBrokerLeadScore } from "../lib/broker/brokerLeadScore";
  import {
    buildBrokerageEconomics,
    type BrokerageEconomics,
    type BrokerageEconomicsInput,
  } from "../lib/brokerage/brokerageEconomics";
  import { buildBrokerageEconomicsRiskAnalysis } from "../lib/brokerage/brokerageEconomicsRisk";
  import { createLeadEconomicsWorkspaceInput } from "../lib/brokerage/leadEconomicsWorkspace";
  import type { BrokerageEconomicsSnapshot } from "../lib/brokerage/brokerageEconomicsSnapshot";
  import {
    createEconomicsCoverageCounts,
    createLeadEconomicsQueueView,
    deriveLatestLeadEconomicsSummary,
    isLeadEconomicsFilter,
    isLeadEconomicsSort,
    replaceLeadEconomicsQueueRecord,
    type LeadEconomicsFilter,
    type LeadEconomicsSort,
    type LeadEconomicsSummary,
  } from "../lib/brokerage/leadEconomicsSummary";
  import {
    formatBrokerageCurrency,
    formatBrokeragePercent,
    getBrokerageRecommendationLabel,
    getServiceExposureLabel,
    getBrokerageValueTone,
    normalizeBrokerageNumericInputValue,
  } from "../lib/brokerage/brokerageEconomicsUi";

  interface LeadEmailDeliveryResult {
    readonly status?: string;
    readonly configured?: boolean;
    readonly reason?: string;
    readonly providerStatus?: number;
  }

  type LeadStatus =
    | "new"
    | "contacted"
    | "sourcing"
    | "offer-sent"
    | "closed"
    | "lost";
  type StatusFilter = LeadStatus | "all";
  type MetricScope = "all" | "filtered";
  type PipelineMetricKey =
    | "total"
    | LeadStatus
    | "email-sent"
    | "email-skipped"
    | "email-failed";
  type PipelineMetricCounts = Record<PipelineMetricKey, number>;
  type BrokerageEconomicsMoneyInputName = Exclude<
    keyof BrokerageEconomicsInput,
    "reference"
  >;
  type BrokerageEconomicsOutputName = keyof Pick<
    BrokerageEconomics,
    | "grossProfit"
    | "expectedExpenses"
    | "netProfit"
    | "capitalRequired"
    | "roiPercent"
    | "riskPenalty"
    | "riskAdjustedProfit"
    | "recommendation"
  >;

  interface BrokerageEconomicsWorkspaceController {
    loadLead(record: LeadSubmissionRecord): void;
    reset(): void;
  }

  interface LeadCapturePayload {
    readonly name?: string | null;
    readonly email?: string | null;
    readonly phone?: string | null;
    readonly intent?: string | null;
    readonly brand?: string | null;
    readonly collection?: string | null;
    readonly reference?: string | null;
    readonly desiredWatch?: string | null;
    readonly budget?: string | null;
    readonly timeline?: string | null;
    readonly message?: string | null;
    readonly source?: string | null;
    readonly createdAt?: string | null;
  }

  interface LeadSubmissionRecord {
    readonly id?: string;
    readonly status?: LeadStatus;
    readonly notes?: string | null;
    readonly notesUpdatedAt?: string | null;
    readonly tags?: readonly string[] | null;
    readonly tagsUpdatedAt?: string | null;
    readonly economicsSnapshots?: readonly BrokerageEconomicsSnapshot[] | null;
    readonly payload?: LeadCapturePayload;
    readonly savedAt?: string;
    readonly emailDelivery?: LeadEmailDeliveryResult;
  }

  const brokerConsole = document.querySelector<HTMLElement>(
    "[data-broker-console]"
  );
  const loadingState = document.querySelector<HTMLElement>(
    "[data-loading-state]"
  );
  const lockedState = document.querySelector<HTMLElement>(
    "[data-locked-state]"
  );
  const lockedMessage = document.querySelector<HTMLElement>(
    "[data-locked-message]"
  );
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  const errorState = document.querySelector<HTMLElement>("[data-error-state]");
  const errorMessage = document.querySelector<HTMLElement>(
    "[data-error-message]"
  );
  const leadBoard = document.querySelector<HTMLElement>("[data-lead-board]");
  const leadList = document.querySelector<HTMLElement>("[data-lead-list]");
  const leadCount = document.querySelector<HTMLElement>("[data-lead-count]");
  const statusFilter = document.querySelector<HTMLSelectElement>(
    "[data-status-filter]"
  );
  const searchFilter = document.querySelector<HTMLInputElement>(
    "[data-search-filter]"
  );
  const economicsFilter = document.querySelector<HTMLSelectElement>(
    "[data-economics-filter]"
  );
  const economicsSort = document.querySelector<HTMLSelectElement>(
    "[data-economics-sort]"
  );
  const exportCsvButton = document.querySelector<HTMLButtonElement>(
    "[data-export-csv]"
  );
  const exportMessage = document.querySelector<HTMLElement>(
    "[data-export-message]"
  );
  const filterEmpty = document.querySelector<HTMLElement>(
    "[data-filter-empty]"
  );
  const brokerageEconomicsAnchor = document.querySelector<HTMLElement>(
    "[data-brokerage-economics-anchor]"
  );
  const summaryCountTargets =
    document.querySelectorAll<HTMLElement>("[data-summary-count]");
  const metricCountTargets =
    document.querySelectorAll<HTMLElement>("[data-metric-count]");
  const economicsCoverageCountTargets =
    document.querySelectorAll<HTMLElement>("[data-economics-coverage-count]");
  const brokerAuthConfigured =
    brokerConsole?.dataset.brokerAuthConfigured === "true";
  const brokerAuthAllowed = brokerConsole?.dataset.brokerAuthAllowed === "true";
  const activeBrokerConsoleKey =
    new URLSearchParams(window.location.search).get("key")?.trim() ?? "";
  let allLeadRecords: LeadSubmissionRecord[] = [];
  let activeStatusFilter: StatusFilter = "all";
  let activeSearchQuery = "";
  let activeEconomicsFilter: LeadEconomicsFilter = "all";
  let activeEconomicsSort: LeadEconomicsSort = "current";
  let brokerageEconomicsWorkspaceController:
    | BrokerageEconomicsWorkspaceController
    | null = null;

  const dateFormatter = new Intl.DateTimeFormat("en-US", {
    dateStyle: "medium",
    timeStyle: "short",
  });

  const leadStatusOptions: readonly {
    readonly value: LeadStatus;
    readonly label: string;
  }[] = [
    { value: "new", label: "New" },
    { value: "contacted", label: "Contacted" },
    { value: "sourcing", label: "Sourcing" },
    { value: "offer-sent", label: "Offer Sent" },
    { value: "closed", label: "Closed" },
    { value: "lost", label: "Lost" },
  ];
  const suggestedLeadTags = [
    "VIP",
    "Hot Lead",
    "Needs Follow-Up",
    "Sourcing Active",
    "Price Sensitive",
    "Repeat Client",
  ] as const;
  const economicsSnapshotNoteMaxLength = 1000;
  const brokerageEconomicsMoneyInputs: readonly {
    readonly name: BrokerageEconomicsMoneyInputName;
    readonly label: string;
  }[] = [
    { name: "purchasePrice", label: "Purchase price" },
    { name: "estimatedMarketValue", label: "Estimated market value" },
    { name: "estimatedServiceCost", label: "Estimated service cost" },
    { name: "estimatedPolishCost", label: "Estimated polishing cost" },
    { name: "estimatedShippingCost", label: "Estimated shipping cost" },
    { name: "estimatedInsuranceCost", label: "Estimated insurance cost" },
    { name: "estimatedSellingFees", label: "Estimated selling fees" },
  ];
  const brokerageEconomicsOutputFields: readonly {
    readonly name: BrokerageEconomicsOutputName;
    readonly label: string;
    readonly format: "currency" | "percent" | "recommendation";
  }[] = [
    { name: "grossProfit", label: "Gross profit", format: "currency" },
    { name: "expectedExpenses", label: "Expected expenses", format: "currency" },
    { name: "netProfit", label: "Net profit", format: "currency" },
    { name: "capitalRequired", label: "Capital required", format: "currency" },
    { name: "roiPercent", label: "ROI percentage", format: "percent" },
    { name: "riskPenalty", label: "Risk penalty", format: "currency" },
    {
      name: "riskAdjustedProfit",
      label: "Risk-adjusted profit",
      format: "currency",
    },
    { name: "recommendation", label: "Recommendation", format: "recommendation" },
  ];

  const setVisible = (element: HTMLElement | null, isVisible: boolean): void => {
    if (element) element.hidden = !isVisible;
  };

  const isRecord = (value: unknown): value is Record<string, unknown> =>
    typeof value === "object" && value !== null && !Array.isArray(value);

  const normalizeLeadStatus = (status?: string | null): LeadStatus =>
    leadStatusOptions.some((option) => option.value === status)
      ? (status as LeadStatus)
      : "new";

  const normalizeStatusFilter = (status?: string | null): StatusFilter =>
    status === "all" ? "all" : normalizeLeadStatus(status);

  const getStatusLabel = (status?: string | null): string => {
    const normalizedStatus = normalizeLeadStatus(status);

    return (
      leadStatusOptions.find((option) => option.value === normalizedStatus)
        ?.label ?? "New"
    );
  };

  const buildBrokerApiUrl = (path: string): string => {
    if (!activeBrokerConsoleKey) return path;

    const url = new URL(path, window.location.origin);

    url.searchParams.set("key", activeBrokerConsoleKey);

    return `${url.pathname}${url.search}`;
  };

  const createBrokerApiHeaders = (
    headers: Record<string, string>
  ): Record<string, string> =>
    activeBrokerConsoleKey
      ? {
          ...headers,
          "x-broker-console-key": activeBrokerConsoleKey,
        }
      : headers;

  const cleanValue = (value?: string | number | boolean | null): string => {
    if (value === null || value === undefined) return "Not provided";

    const normalized = String(value).trim();

    return normalized ? normalized : "Not provided";
  };

  const formatLeadIntent = (intent?: string | null): string => {
    switch (intent) {
      case "request-this-watch":
        return "Request This Watch";
      case "sell-your-watch":
        return "Sell Your Watch";
      case "trade-your-watch":
        return "Trade Your Watch";
      case "market-valuation":
        return "Market Valuation";
      case "talk-to-broker":
        return "Talk to a Broker";
      default:
        return cleanValue(intent);
    }
  };

  const formatDate = (value?: string): string => {
    if (!value) return "Not provided";

    const date = new Date(value);

    return Number.isNaN(date.getTime()) ? cleanValue(value) : dateFormatter.format(date);
  };

  const getSavedAtTime = (record: LeadSubmissionRecord): number => {
    const savedAt = record.savedAt ? Date.parse(record.savedAt) : 0;

    return Number.isFinite(savedAt) ? savedAt : 0;
  };

  const getSortedLeadRecords = (
    records: readonly LeadSubmissionRecord[]
  ): LeadSubmissionRecord[] =>
    [...records].sort((a, b) => getSavedAtTime(b) - getSavedAtTime(a));

  const getRawValue = (value?: string | number | boolean | null): string =>
    value === null || value === undefined ? "" : String(value).trim();

  const normalizeTagList = (
    tags?: readonly string[] | null
  ): readonly string[] => {
    if (!Array.isArray(tags)) return [];

    const seenTags = new Set<string>();
    const normalizedTags: string[] = [];

    tags.forEach((tag) => {
      const normalizedTag = getRawValue(tag);
      const normalizedKey = normalizedTag.toLowerCase();

      if (!normalizedTag || seenTags.has(normalizedKey)) return;

      seenTags.add(normalizedKey);
      normalizedTags.push(normalizedTag);
    });

    return normalizedTags;
  };

  const getActiveQueueViewOptions = () => ({
    statusFilter: activeStatusFilter,
    searchQuery: activeSearchQuery,
    economicsFilter: activeEconomicsFilter,
    economicsSort: activeEconomicsSort,
  });

  const matchesActiveFilters = (record: LeadSubmissionRecord): boolean =>
    createLeadEconomicsQueueView([record], getActiveQueueViewOptions()).length >
    0;

  const getFilteredSortedRecords = (): LeadSubmissionRecord[] =>
    createLeadEconomicsQueueView(
      allLeadRecords,
      getActiveQueueViewOptions()
    );

  const replaceLeadRecord = (updatedLead: LeadSubmissionRecord): void => {
    if (!updatedLead.id) return;

    allLeadRecords = replaceLeadEconomicsQueueRecord(
      allLeadRecords,
      updatedLead
    );
  };

  const updateSummaryCounts = (records: readonly LeadSubmissionRecord[]): void => {
    const counts: Record<StatusFilter, number> = {
      all: records.length,
      new: 0,
      contacted: 0,
      sourcing: 0,
      "offer-sent": 0,
      closed: 0,
      lost: 0,
    };

    records.forEach((record) => {
      counts[normalizeLeadStatus(record.status)] += 1;
    });

    summaryCountTargets.forEach((target) => {
      const countKey = target.dataset.summaryCount;

      if (countKey === "total") {
        target.textContent = String(counts.all);
        return;
      }

      if (countKey && countKey in counts) {
        target.textContent = String(counts[countKey as StatusFilter]);
      }
    });
  };

  const createEmptyPipelineMetrics = (): PipelineMetricCounts => ({
    total: 0,
    new: 0,
    contacted: 0,
    sourcing: 0,
    "offer-sent": 0,
    closed: 0,
    lost: 0,
    "email-sent": 0,
    "email-skipped": 0,
    "email-failed": 0,
  });

  const getEmailDeliveryMetricKey = (
    emailDelivery?: LeadEmailDeliveryResult
  ): PipelineMetricKey | null => {
    switch (emailDelivery?.status) {
      case "sent":
        return "email-sent";
      case "skipped":
        return "email-skipped";
      case "failed":
        return "email-failed";
      default:
        return null;
    }
  };

  const createPipelineMetrics = (
    records: readonly LeadSubmissionRecord[]
  ): PipelineMetricCounts => {
    const counts = createEmptyPipelineMetrics();

    counts.total = records.length;

    records.forEach((record) => {
      counts[normalizeLeadStatus(record.status)] += 1;

      const emailDeliveryKey = getEmailDeliveryMetricKey(record.emailDelivery);

      if (emailDeliveryKey) counts[emailDeliveryKey] += 1;
    });

    return counts;
  };

  const updateExportState = (
    filteredRecords: readonly LeadSubmissionRecord[]
  ): void => {
    if (exportCsvButton) {
      exportCsvButton.disabled = filteredRecords.length === 0;
    }

    if (exportMessage) {
      exportMessage.textContent =
        filteredRecords.length === 0
          ? "No filtered leads available to export."
          : `Ready to export ${filteredRecords.length} filtered lead${
              filteredRecords.length === 1 ? "" : "s"
            }.`;
    }
  };

  const updatePipelineMetrics = (
    allRecords: readonly LeadSubmissionRecord[],
    filteredRecords: readonly LeadSubmissionRecord[]
  ): void => {
    const countsByScope: Record<MetricScope, PipelineMetricCounts> = {
      all: createPipelineMetrics(allRecords),
      filtered: createPipelineMetrics(filteredRecords),
    };

    metricCountTargets.forEach((target) => {
      const metricScope = target.dataset.metricScope;
      const metricKey = target.dataset.metricCount;

      if (
        (metricScope === "all" || metricScope === "filtered") &&
        metricKey &&
        metricKey in countsByScope[metricScope]
      ) {
        target.textContent = String(
          countsByScope[metricScope][metricKey as PipelineMetricKey]
        );
      }
    });
  };

  const updateEconomicsCoverage = (
    records: readonly LeadSubmissionRecord[]
  ): void => {
    const counts = createEconomicsCoverageCounts(records);
    const values: Readonly<Record<string, number>> = {
      total: counts.total,
      "current-risk-guidance": counts.currentRiskGuidance,
      "not-analyzed": counts.notAnalyzed,
      "legacy-analysis": counts.legacyAnalysis,
      protected: counts.protected,
      exposed: counts.exposed,
      fragile: counts.fragile,
      unprofitable: counts.unprofitable,
      "model-cautions": counts.modelCautions,
    };

    economicsCoverageCountTargets.forEach((target) => {
      const countKey = target.dataset.economicsCoverageCount;

      if (countKey && countKey in values) {
        target.textContent = String(values[countKey]);
      }
    });
  };

  const updateDashboardMetrics = (
    filteredRecords = getFilteredSortedRecords()
  ): void => {
    if (leadCount) leadCount.textContent = String(allLeadRecords.length);
    updateSummaryCounts(allLeadRecords);
    updatePipelineMetrics(allLeadRecords, filteredRecords);
    updateEconomicsCoverage(allLeadRecords);
    updateExportState(filteredRecords);
