  const getEmailStatusText = (
    emailDelivery?: LeadEmailDeliveryResult
  ): string => {
    if (!emailDelivery?.status) return "Not provided";

    const parts = [
      emailDelivery.status,
      emailDelivery.configured === false ? "local skip" : undefined,
      emailDelivery.providerStatus
        ? `provider ${emailDelivery.providerStatus}`
        : undefined,
    ].filter(Boolean);

    return parts.join(" - ");
  };

  const getWatchInterest = (payload: LeadCapturePayload): string => {
    const desiredWatch = getRawValue(payload.desiredWatch);

    if (desiredWatch) return desiredWatch;

    const watchParts = [
      payload.brand,
      payload.collection,
      payload.reference,
    ]
      .map(getRawValue)
      .filter(Boolean);

    return watchParts.length > 0 ? watchParts.join(" ") : "Not provided";
  };

  const getLeadGreetingName = (payload: LeadCapturePayload): string => {
    const name = getRawValue(payload.name);

    return name ? name.split(/\s+/)[0] : "there";
  };

  const normalizePhoneHrefValue = (phone?: string | null): string => {
    const rawPhone = getRawValue(phone);
    const digits = rawPhone.replace(/\D/g, "");

    if (!digits) return "";

    return rawPhone.trim().startsWith("+") ? `+${digits}` : digits;
  };

  const createLeadEmailSubject = (payload: LeadCapturePayload): string => {
    const watchInterest = getWatchInterest(payload);

    return watchInterest === "Not provided"
      ? "Quest Luxo | Your watch request"
      : `Quest Luxo | ${watchInterest}`;
  };

  const createLeadEmailBody = (payload: LeadCapturePayload): string => {
    const watchInterest = getWatchInterest(payload);
    const watchLine =
      watchInterest === "Not provided" ? "" : ` about ${watchInterest}`;

    return [
      `Hello ${getLeadGreetingName(payload)},`,
      "",
      `Thank you for beginning your Quest Luxo conversation${watchLine}. I reviewed your request and would be glad to help with sourcing, selling, trading, or market guidance.`,
      "",
      "What is the best time to connect?",
      "",
      "Best,",
      "Quest Luxo",
    ].join("\n");
  };

