  const csvHeaders = [
    "id",
    "status",
    "score",
    "tier",
    "name",
    "email",
    "phone",
    "brand",
    "collection",
    "reference",
    "desiredWatch",
    "budget",
    "timeline",
    "message",
    "notes",
    "tags",
    "source",
    "createdAt",
    "savedAt",
    "emailDeliveryStatus",
  ] as const;

  const escapeCsvValue = (value?: string | number | boolean | null): string => {
    const normalized =
      value === null || value === undefined ? "" : String(value);

    return /[",\r\n]/.test(normalized)
      ? `"${normalized.replace(/"/g, '""')}"`
      : normalized;
  };

  const getCsvRows = (
    records: readonly LeadSubmissionRecord[]
  ): readonly string[][] =>
    records.map((record) => {
      const payload = record.payload ?? {};
      const leadScore = createBrokerLeadScore(record);

      return [
        getRawValue(record.id),
        normalizeLeadStatus(record.status),
        String(leadScore.score),
        leadScore.tier,
        getRawValue(payload.name),
        getRawValue(payload.email),
        getRawValue(payload.phone),
        getRawValue(payload.brand),
        getRawValue(payload.collection),
        getRawValue(payload.reference),
        getRawValue(payload.desiredWatch),
        getRawValue(payload.budget),
        getRawValue(payload.timeline),
        getRawValue(payload.message),
        getRawValue(record.notes),
        normalizeTagList(record.tags).join("; "),
        getRawValue(payload.source),
        getRawValue(payload.createdAt),
        getRawValue(record.savedAt),
        getRawValue(record.emailDelivery?.status),
      ];
    });

  const createLeadsCsv = (
    records: readonly LeadSubmissionRecord[]
  ): string => {
    const rows = [csvHeaders, ...getCsvRows(records)];

    return rows
      .map((row) => row.map((value) => escapeCsvValue(value)).join(","))
      .join("\r\n");
  };

  const getCsvExportFilename = (): string => {
    const today = new Date().toISOString().slice(0, 10);

    return `quest-luxo-leads-${today}.csv`;
  };

  const exportFilteredLeadsCsv = (): void => {
    const filteredRecords = getFilteredSortedRecords();

    if (filteredRecords.length === 0) {
      updateExportState(filteredRecords);
      return;
    }

    const blob = new Blob([createLeadsCsv(filteredRecords)], {
      type: "text/csv;charset=utf-8",
    });
    const downloadUrl = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = downloadUrl;
    link.download = getCsvExportFilename();
    document.body.append(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(downloadUrl);

    if (exportMessage) {
      exportMessage.textContent = `Exported ${filteredRecords.length} filtered lead${
        filteredRecords.length === 1 ? "" : "s"
      }.`;
    }
  };

