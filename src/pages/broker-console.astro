  const createStatusControl = (record: LeadSubmissionRecord) => {
    const control = document.createElement("div");
    const label = document.createElement("label");
    const select = document.createElement("select");
    const feedback = document.createElement("p");
    let currentStatus = normalizeLeadStatus(record.status);

    control.className = "status-control";
    label.textContent = "Lead Status";
    feedback.className = "status-feedback";
    feedback.setAttribute("aria-live", "polite");

    leadStatusOptions.forEach((option) => {
      const item = document.createElement("option");

      item.value = option.value;
      item.textContent = option.label;
      select.append(item);
    });

    select.value = currentStatus;

    if (!record.id) {
      select.disabled = true;
      feedback.textContent = "Missing lead id.";
      feedback.dataset.state = "error";
    }

    select.addEventListener("change", async () => {
      if (!record.id) return;

      const nextStatus = normalizeLeadStatus(select.value);

      if (nextStatus === currentStatus) return;

      select.disabled = true;
      feedback.textContent = "Updating status...";
      feedback.dataset.state = "updating";

      try {
        const updatedLead = await updateLeadStatus(record.id, nextStatus);

        currentStatus = normalizeLeadStatus(updatedLead.status);
        select.value = currentStatus;
        replaceLeadRecord(updatedLead);
        updateLeadScoreDisplay(control.closest(".lead-card"), updatedLead);
        updateDashboardMetrics();
        feedback.textContent = `Status updated to ${getStatusLabel(
          currentStatus
        )}.`;
        feedback.dataset.state = "success";

        if (!matchesActiveFilters(updatedLead)) {
          applyFilters();
        }
      } catch (error) {
        select.value = currentStatus;
        feedback.textContent =
          error instanceof Error
            ? error.message
            : "Unable to update lead status.";
        feedback.dataset.state = "error";
      } finally {
        select.disabled = false;
      }
    });

    label.append(select);
    control.append(label, feedback);

    return control;
  };

  const createNotesControl = (record: LeadSubmissionRecord) => {
    const control = document.createElement("div");
    const label = document.createElement("label");
    const textarea = document.createElement("textarea");
    const actions = document.createElement("div");
    const saveButton = document.createElement("button");
    const feedback = document.createElement("p");
    let currentNotes = typeof record.notes === "string" ? record.notes : "";

    control.className = "notes-control";
    label.textContent = "Broker Notes";
    textarea.value = currentNotes;
    textarea.rows = 4;
    textarea.placeholder = "Add private broker notes for this lead.";
    saveButton.type = "button";
    saveButton.textContent = "Save Notes";
    feedback.className = "notes-feedback";
    feedback.setAttribute("aria-live", "polite");

    if (record.notesUpdatedAt) {
      feedback.textContent = `Last saved ${formatDate(record.notesUpdatedAt)}.`;
    }

    if (!record.id) {
      textarea.disabled = true;
      saveButton.disabled = true;
      feedback.textContent = "Missing lead id.";
      feedback.dataset.state = "error";
    }

    saveButton.addEventListener("click", async () => {
      if (!record.id) return;

      textarea.disabled = true;
      saveButton.disabled = true;
      feedback.textContent = "Saving notes...";
      feedback.dataset.state = "saving";

      try {
        const updatedLead = await updateLeadNotes(record.id, textarea.value);

        currentNotes =
          typeof updatedLead.notes === "string" ? updatedLead.notes : "";
        textarea.value = currentNotes;
        replaceLeadRecord(updatedLead);
        feedback.textContent = updatedLead.notesUpdatedAt
          ? `Notes saved ${formatDate(updatedLead.notesUpdatedAt)}.`
          : "Notes saved.";
        feedback.dataset.state = "success";

        if (activeSearchQuery && !matchesActiveFilters(updatedLead)) {
          applyFilters();
        }
      } catch (error) {
        textarea.value = currentNotes;
        feedback.textContent =
          error instanceof Error
            ? error.message
            : "Unable to save lead notes.";
        feedback.dataset.state = "error";
      } finally {
        textarea.disabled = false;
        saveButton.disabled = false;
      }
    });

    label.append(textarea);
    actions.className = "notes-actions";
    actions.append(saveButton, feedback);
    control.append(label, actions);

    return control;
  };

  const createTagsControl = (record: LeadSubmissionRecord) => {
    const control = document.createElement("div");
    const heading = document.createElement("div");
    const label = document.createElement("span");
    const currentTagsList = document.createElement("div");
    const suggestedTagsList = document.createElement("div");
    const addRow = document.createElement("div");
    const tagInput = document.createElement("input");
    const addButton = document.createElement("button");
    const feedback = document.createElement("p");
    let currentTags = [...normalizeTagList(record.tags)];

    control.className = "tags-control";
    heading.className = "tags-heading";
    label.textContent = "Lead Tags";
    currentTagsList.className = "current-tags-list";
    suggestedTagsList.className = "suggested-tags-list";
    addRow.className = "tags-add-row";
    tagInput.type = "text";
    tagInput.placeholder = "Add custom tag";
    addButton.type = "button";
    addButton.textContent = "Add Tag";
    feedback.className = "tags-feedback";
    feedback.setAttribute("aria-live", "polite");

    if (record.tagsUpdatedAt) {
      feedback.textContent = `Last saved ${formatDate(record.tagsUpdatedAt)}.`;
    }

    const setSavingState = (isSaving: boolean): void => {
      tagInput.disabled = isSaving || !record.id;
      addButton.disabled = isSaving || !record.id;
      suggestedTagsList
        .querySelectorAll<HTMLButtonElement>("button")
        .forEach((button) => {
          button.disabled = isSaving || !record.id;
        });
      currentTagsList
        .querySelectorAll<HTMLButtonElement>("button")
        .forEach((button) => {
          button.disabled = isSaving || !record.id;
        });
    };

    const renderCurrentTags = (): void => {
      currentTagsList.replaceChildren();

      if (currentTags.length === 0) {
        const emptyTags = document.createElement("p");

        emptyTags.className = "tags-empty";
        emptyTags.textContent = "No tags yet.";
        currentTagsList.append(emptyTags);
        return;
      }

      currentTags.forEach((tag) => {
        const tagButton = document.createElement("button");

        tagButton.type = "button";
        tagButton.textContent = `${tag} x`;
        tagButton.addEventListener("click", () => {
          saveTags(currentTags.filter((currentTag) => currentTag !== tag));
        });
        currentTagsList.append(tagButton);
      });
    };

    const saveTags = async (nextTags: readonly string[]): Promise<void> => {
      if (!record.id) return;

      setSavingState(true);
      feedback.textContent = "Saving tags...";
      feedback.dataset.state = "saving";

      try {
        const updatedLead = await updateLeadTags(record.id, nextTags);

        currentTags = [...normalizeTagList(updatedLead.tags)];
        replaceLeadRecord(updatedLead);
        renderCurrentTags();
        updateLeadScoreDisplay(control.closest(".lead-card"), updatedLead);
        feedback.textContent = updatedLead.tagsUpdatedAt
          ? `Tags saved ${formatDate(updatedLead.tagsUpdatedAt)}.`
          : "Tags saved.";
        feedback.dataset.state = "success";

        if (!matchesActiveFilters(updatedLead)) {
          applyFilters();
        } else {
          updateDashboardMetrics();
        }
      } catch (error) {
        feedback.textContent =
          error instanceof Error
            ? error.message
            : "Unable to save lead tags.";
        feedback.dataset.state = "error";
      } finally {
        setSavingState(false);
      }
    };

    const addTag = (tag: string): void => {
      const normalizedTag = getRawValue(tag);

      if (!normalizedTag) return;

      const nextTags = normalizeTagList([...currentTags, normalizedTag]);

      tagInput.value = "";
      saveTags(nextTags);
    };

    suggestedLeadTags.forEach((tag) => {
      const tagButton = document.createElement("button");

      tagButton.type = "button";
      tagButton.textContent = tag;
      tagButton.addEventListener("click", () => addTag(tag));
      suggestedTagsList.append(tagButton);
    });

    addButton.addEventListener("click", () => addTag(tagInput.value));
    tagInput.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;

      event.preventDefault();
      addTag(tagInput.value);
    });

    if (!record.id) {
      feedback.textContent = "Missing lead id.";
      feedback.dataset.state = "error";
    }

    heading.append(label);
    addRow.append(tagInput, addButton);
    renderCurrentTags();
    setSavingState(false);
    control.append(
      heading,
      currentTagsList,
      suggestedTagsList,
      addRow,
      feedback
    );

    return control;
  };

  const getEconomicsSnapshots = (
    record: LeadSubmissionRecord
  ): readonly BrokerageEconomicsSnapshot[] =>
    Array.isArray(record.economicsSnapshots) ? record.economicsSnapshots : [];

  const getSnapshotTime = (snapshot: BrokerageEconomicsSnapshot): number => {
    const createdAt = Date.parse(snapshot.createdAt);

    return Number.isFinite(createdAt) ? createdAt : 0;
  };

  const createEconomicsHistoryMetric = (label: string, value: string) => {
    const metric = document.createElement("div");
    const labelElement = document.createElement("span");
    const valueElement = document.createElement("strong");

    metric.className = "economics-history-metric";
    labelElement.textContent = label;
    valueElement.textContent = value;
    metric.append(labelElement, valueElement);

    return metric;
  };

  const createEconomicsHistoryPanel = (record: LeadSubmissionRecord) => {
    const panel = document.createElement("section");
    const heading = document.createElement("div");
    const eyebrow = document.createElement("p");
    const title = document.createElement("h4");
    const list = document.createElement("div");
    const snapshots = [...getEconomicsSnapshots(record)].sort(
      (a, b) => getSnapshotTime(b) - getSnapshotTime(a)
    );

    panel.className = "economics-history-panel";
    heading.className = "economics-history-heading";
    eyebrow.className = "eyebrow";
    eyebrow.textContent = "Economics History";
    title.textContent = "Saved Snapshots";
    list.className = "economics-history-list";

    if (snapshots.length === 0) {
      const emptyMessage = document.createElement("p");

      emptyMessage.className = "economics-history-empty";
      emptyMessage.textContent = "No economics snapshots saved for this lead yet.";
      list.append(emptyMessage);
    }

    snapshots.forEach((snapshot) => {
      const item = document.createElement("article");
      const itemHeading = document.createElement("div");
      const savedAt = document.createElement("strong");
      const recommendation = document.createElement("span");
      const metrics = document.createElement("div");
      const riskHistory = document.createElement("section");

      item.className = "economics-history-card";
      itemHeading.className = "economics-history-card-heading";
      savedAt.textContent = formatDate(snapshot.createdAt);
      recommendation.className = "economics-history-recommendation";
      recommendation.dataset.recommendation = snapshot.recommendation;
      recommendation.textContent = getBrokerageRecommendationLabel(
        snapshot.recommendation
      );
      metrics.className = "economics-history-grid";
      metrics.append(
        createEconomicsHistoryMetric("Reference", cleanValue(snapshot.reference)),
        createEconomicsHistoryMetric(
          "Purchase Price",
          formatBrokerageCurrency(snapshot.purchasePrice)
        ),
        createEconomicsHistoryMetric(
          "Market Value",
          formatBrokerageCurrency(snapshot.estimatedMarketValue)
        ),
        createEconomicsHistoryMetric(
          "Expected Expenses",
          formatBrokerageCurrency(snapshot.expectedExpenses)
        ),
        createEconomicsHistoryMetric(
          "Net Profit",
          formatBrokerageCurrency(snapshot.netProfit)
        ),
        createEconomicsHistoryMetric("ROI", formatBrokeragePercent(snapshot.roiPercent)),
        createEconomicsHistoryMetric(
          "Risk-Adjusted Profit",
          formatBrokerageCurrency(snapshot.riskAdjustedProfit)
        )
      );

      riskHistory.className = "economics-history-risk";
      riskHistory.dataset.snapshotRiskView = "";

      if (snapshot.riskAnalysis) {
        const riskHeading = document.createElement("div");
        const riskTitle = document.createElement("strong");
        const classification = document.createElement("span");
        const riskMetrics = document.createElement("div");
        const explanation = document.createElement("p");
        const moderateContingencyLabel = formatContingencyAmount(
          snapshot.riskAnalysis.moderateContingencyAmount
        );
        const severeContingencyLabel = formatContingencyAmount(
          snapshot.riskAnalysis.severeContingencyAmount
        );

        riskHeading.className = "economics-history-risk-heading";
        riskTitle.textContent = "Risk-Adjusted View";
        classification.className = "economics-history-classification";
        classification.dataset.classification =
          snapshot.riskAnalysis.serviceExposureClassification;
        classification.dataset.snapshotServiceExposure = "";
        classification.textContent = getServiceExposureLabel(
          snapshot.riskAnalysis.serviceExposureClassification
        );
        riskMetrics.className = "economics-history-risk-grid";
        riskMetrics.append(
          createEconomicsHistoryMetric(
            "Base Expected Profit",
            formatBrokerageCurrency(snapshot.riskAnalysis.baseExpectedProfit)
          ),
          createEconomicsHistoryMetric(
            `After ${moderateContingencyLabel} Contingency`,
            formatBrokerageCurrency(
              snapshot.riskAnalysis.profitAfterModerateContingency
            )
          ),
          createEconomicsHistoryMetric(
            `After ${severeContingencyLabel} Contingency`,
            formatBrokerageCurrency(
              snapshot.riskAnalysis.profitAfterSevereContingency
            )
          )
        );
        explanation.className = "economics-history-risk-explanation";
        explanation.textContent = snapshot.riskAnalysis.explanation;
        riskHeading.append(riskTitle, classification);
        riskHistory.append(riskHeading, riskMetrics, explanation);

        if (
          snapshot.riskAnalysis.modelCaution &&
          snapshot.riskAnalysis.thinMarginModel
        ) {
          const caution = document.createElement("p");

          caution.className = "economics-history-model-caution";
          caution.dataset.snapshotModelCaution = "";
          caution.textContent =
            `Model caution — ${snapshot.riskAnalysis.thinMarginModel.label}: confirm service, polishing, shipping, and condition exposure before proceeding.`;
          riskHistory.append(caution);
        }
      } else {
        const legacyMessage = document.createElement("p");

        riskHistory.classList.add("economics-history-risk--legacy");
        legacyMessage.textContent =
          "Risk-adjusted guidance was not captured for this older snapshot.";
        riskHistory.append(legacyMessage);
      }

      itemHeading.append(savedAt, recommendation);
      item.append(itemHeading, metrics, riskHistory);

      if (snapshot.brokerNote) {
        const note = document.createElement("p");

        note.className = "economics-history-note";
        note.textContent = snapshot.brokerNote;
        item.append(note);
      }

      list.append(item);
    });

    heading.append(eyebrow, title);
    panel.append(heading, list);

    return panel;
  };

  const createSummaryItem = (label: string, value: string) => {
    const item = document.createElement("div");
    const labelElement = document.createElement("span");
    const valueElement = document.createElement("strong");

    item.className = "lead-summary-item";
    labelElement.textContent = label;
    valueElement.textContent = value;
    item.append(labelElement, valueElement);

    return item;
  };

  const getLatestEconomicsStateLabel = (
    summary: LeadEconomicsSummary
  ): string => {
    if (summary.state === "not-analyzed") return "Not Analyzed";
    if (summary.state === "legacy-analysis") return "Legacy Analysis";

    return getServiceExposureLabel(summary.state);
  };

  const createLatestEconomicsMetric = (
    label: string,
    value: string,
    metricName: string
  ) => {
    const metric = createSummaryItem(label, value);

    metric.classList.add("latest-economics-metric");
    metric.dataset.latestEconomicsMetric = metricName;

    return metric;
  };

  const createLatestEconomicsPanel = (record: LeadSubmissionRecord) => {
    const summary = deriveLatestLeadEconomicsSummary(record);
    const panel = document.createElement("section");
    const heading = document.createElement("div");
    const title = document.createElement("h4");
    const state = document.createElement("span");

    panel.className = "latest-economics-panel";
    panel.dataset.latestEconomics = "";
    panel.dataset.economicsState = summary.state;
    heading.className = "latest-economics-heading";
    title.textContent = "Latest Economics";
    state.className = "latest-economics-state";
    state.dataset.classification = summary.state;
    state.textContent = getLatestEconomicsStateLabel(summary);
    heading.append(title, state);
    panel.append(heading);

    if (summary.state === "not-analyzed") {
      const message = document.createElement("p");

      message.className = "latest-economics-message";
      message.textContent = "Not Analyzed";
      panel.append(message);

      return panel;
    }

    if (summary.state === "legacy-analysis") {
      const message = document.createElement("p");

      message.className = "latest-economics-message";
      message.textContent =
        "A new economics analysis is required for current risk guidance.";
      panel.append(message);

      return panel;
    }

    const metrics = document.createElement("div");

    metrics.className = "latest-economics-grid";
    metrics.append(
      createLatestEconomicsMetric(
        "Base Expected Profit",
        formatBrokerageCurrency(summary.baseExpectedProfit),
        "base-profit"
      ),
      createLatestEconomicsMetric(
        "ROI",
        formatBrokeragePercent(summary.roiPercent),
        "roi"
      ),
      createLatestEconomicsMetric(
        "Analysis Date",
        summary.snapshotTimestamp
          ? formatDate(summary.snapshotTimestamp)
          : "Unavailable",
        "analysis-date"
      )
    );
    panel.append(metrics);

    if (summary.modelCaution) {
      const caution = document.createElement("p");
      const modelLabel = summary.modelCautionLabel
        ? ` - ${summary.modelCautionLabel}`
        : "";

      caution.className = "latest-economics-caution";
      caution.dataset.latestEconomicsModelCaution = "";
      caution.textContent =
        `Model caution${modelLabel}: confirm service, polishing, shipping, and condition exposure before proceeding.`;
      panel.append(caution);
    }

    return panel;
  };

  const createAnalyzeEconomicsButton = (record: LeadSubmissionRecord) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "economics-load-button";
    button.textContent = "Analyze Economics";
    button.addEventListener("click", () => {
      brokerageEconomicsWorkspaceController?.loadLead(record);
    });

    return button;
  };

  const createDetailsToggle = (drawer: HTMLElement) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "details-toggle";
    button.textContent = "View Details";
    button.setAttribute("aria-expanded", "false");

    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isExpanded;

      button.setAttribute("aria-expanded", String(nextExpanded));
      button.textContent = nextExpanded ? "Hide Details" : "View Details";
      drawer.hidden = !nextExpanded;
    });

    return button;
  };

  const createLeadCard = (record: LeadSubmissionRecord) => {
    const payload = record.payload ?? {};
    const leadScore = createBrokerLeadScore(record);
    const card = document.createElement("article");
    const heading = document.createElement("div");
    const titleGroup = document.createElement("div");
    const title = document.createElement("h3");
    const meta = document.createElement("p");
    const summary = document.createElement("div");
    const summaryMeta = document.createElement("div");
    const summaryActions = document.createElement("div");
    const drawer = document.createElement("section");
    const details = document.createElement("dl");

    card.className = "lead-card";
    heading.className = "lead-card-header";
    summary.className = "lead-summary";
    summaryMeta.className = "lead-summary-meta";
    summaryActions.className = "lead-summary-actions";
    drawer.className = "lead-detail-drawer";
    drawer.hidden = true;
    title.textContent = cleanValue(payload.name);
    meta.textContent = getWatchInterest(payload);

    const scoreSummaryItem = createSummaryItem(
      "Score",
      `${leadScore.score}/100 ${formatScoreTier(leadScore.tier)}`
    );

    scoreSummaryItem.dataset.leadScoreSummary = "true";
    titleGroup.append(title, meta);
    summaryMeta.append(
      scoreSummaryItem,
      createSummaryItem("Budget", cleanValue(payload.budget)),
      createSummaryItem("Timeline", cleanValue(payload.timeline)),
      createSummaryItem("Saved", formatDate(record.savedAt))
    );
    summaryActions.append(
      createStatusControl(record),
      createAnalyzeEconomicsButton(record),
      createDetailsToggle(drawer)
    );
    summary.append(summaryMeta, summaryActions);

    details.append(
      createField("Email", payload.email),
      createField("Phone", payload.phone),
      createField("Intent", formatLeadIntent(payload.intent)),
      createField("Brand", payload.brand),
      createField("Collection", payload.collection),
      createField("Reference", payload.reference),
      createField("Desired Watch", payload.desiredWatch),
      createField("Source", payload.source),
      createField("Created At", formatDate(payload.createdAt ?? undefined)),
      createField("Saved At", formatDate(record.savedAt)),
      createField("Email Delivery", getEmailStatusText(record.emailDelivery))
    );

    heading.append(titleGroup);
    drawer.append(
      createLeadScorePanel(record),
      createBrokerIntelligencePanel(payload),
      createBrokerActionsPanel(payload),
      createEconomicsHistoryPanel(record),
      details,
      createMessageBlock(payload.message),
      createTagsControl(record),
      createNotesControl(record)
    );

    if (record.emailDelivery?.reason) {
      drawer.append(
        createMessageBlock(`Email delivery: ${record.emailDelivery.reason}`)
      );
    }

    card.append(heading, summary, createLatestEconomicsPanel(record), drawer);

    return card;
  };

  const showState = (
    state: "loading" | "locked" | "empty" | "error" | "populated"
  ): void => {
    setVisible(loadingState, state === "loading");
    setVisible(lockedState, state === "locked");
    setVisible(emptyState, state === "empty");
    setVisible(errorState, state === "error");
    setVisible(leadBoard, state === "populated");
    setVisible(brokerageEconomicsAnchor, state !== "locked");
  };

  const applyFilters = (): void => {
    const filteredRecords = getFilteredSortedRecords();

    updateDashboardMetrics(filteredRecords);
    if (!leadList) return;

    leadList.replaceChildren();

    if (allLeadRecords.length === 0) {
      setVisible(filterEmpty, false);
      showState("empty");
      return;
    }

    showState("populated");
    setVisible(filterEmpty, filteredRecords.length === 0);

    filteredRecords.forEach((record) => {
      leadList.append(createLeadCard(record));
    });
  };

  const renderLeads = (records: readonly LeadSubmissionRecord[]): void => {
    allLeadRecords = getSortedLeadRecords(records);
    applyFilters();
  };

  statusFilter?.addEventListener("change", () => {
    activeStatusFilter = normalizeStatusFilter(statusFilter.value);
    applyFilters();
  });

  searchFilter?.addEventListener("input", () => {
    activeSearchQuery = searchFilter.value.trim();
    applyFilters();
  });

  economicsFilter?.addEventListener("change", () => {
    activeEconomicsFilter = isLeadEconomicsFilter(economicsFilter.value)
      ? economicsFilter.value
      : "all";
    applyFilters();
  });

  economicsSort?.addEventListener("change", () => {
    activeEconomicsSort = isLeadEconomicsSort(economicsSort.value)
      ? economicsSort.value
      : "current";
    applyFilters();
  });

  exportCsvButton?.addEventListener("click", () => {
    exportFilteredLeadsCsv();
  });

  const loadBrokerLeads = async (): Promise<void> => {
    showState("loading");

    try {
      const response = await fetch(buildBrokerApiUrl("/api/broker/leads/"), {
        headers: createBrokerApiHeaders({
          Accept: "application/json",
        }),
        cache: "no-store",
      });

      if (response.status === 401) {
        let responseBody: unknown = {};

        try {
          responseBody = await response.json();
        } catch {
          responseBody = {};
        }

        if (leadCount) leadCount.textContent = "0";
        if (lockedMessage) {
          lockedMessage.textContent = getApiErrorMessage(
            responseBody,
            "Broker Console access key is missing or invalid."
          );
        }
        showState("locked");
        return;
      }

      if (!response.ok) {
        throw new Error(`Broker leads API returned ${response.status}.`);
      }

      const records: unknown = await response.json();

      if (!Array.isArray(records)) {
        throw new Error("Broker leads API returned an unexpected response.");
      }

      renderLeads(records as LeadSubmissionRecord[]);
    } catch (error) {
      if (leadCount) leadCount.textContent = "0";
      if (errorMessage) {
        errorMessage.textContent =
          error instanceof Error
            ? error.message
            : "Unable to load broker leads.";
      }
      showState("error");
    }
  };

  const startBrokerConsole = (): void => {
    if (brokerAuthConfigured && !activeBrokerConsoleKey && !brokerAuthAllowed) {
      if (leadCount) leadCount.textContent = "0";
      if (lockedMessage) {
        lockedMessage.textContent =
          "Open this internal console with ?key=YOUR_ACCESS_KEY.";
      }
      showState("locked");
      return;
    }

    loadBrokerLeads();
  };

  brokerageEconomicsAnchor?.append(createBrokerageEconomicsPanel());
  startBrokerConsole();
</script>

