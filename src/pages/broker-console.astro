    const getMoneyValue = (name: BrokerageEconomicsMoneyInputName): number | null =>
      normalizeBrokerageNumericInputValue(moneyInputs.get(name)?.value ?? "");

    const getCalculatorInput = (): BrokerageEconomicsInput => ({
      reference: referenceInput.value,
      purchasePrice: getMoneyValue("purchasePrice"),
      estimatedMarketValue: getMoneyValue("estimatedMarketValue"),
      estimatedServiceCost: getMoneyValue("estimatedServiceCost"),
      estimatedPolishCost: getMoneyValue("estimatedPolishCost"),
      estimatedShippingCost: getMoneyValue("estimatedShippingCost"),
      estimatedInsuranceCost: getMoneyValue("estimatedInsuranceCost"),
      estimatedSellingFees: getMoneyValue("estimatedSellingFees"),
    });

    const getSnapshotSaveBlocker = (): string | null => {
      if (!loadedLeadId) return "Load a lead with Analyze Economics before saving.";

      const calculatorInput = getCalculatorInput();
      const economics = buildBrokerageEconomics(calculatorInput);

      if (
        calculatorInput.purchasePrice === null ||
        calculatorInput.estimatedMarketValue === null
      ) {
        return "Enter purchase price and estimated market value before saving.";
      }

      if (!isValidEconomicsSnapshotResult(economics)) {
        return "Enter valid economics assumptions before saving.";
      }

      if (snapshotNote.value.trim().length > economicsSnapshotNoteMaxLength) {
        return `Broker note must be ${economicsSnapshotNoteMaxLength} characters or fewer.`;
      }

      return null;
    };

    const updateSnapshotSaveState = (): void => {
      const blocker = getSnapshotSaveBlocker();

      saveSnapshotButton.disabled = Boolean(blocker) || isSavingSnapshot;

      if (!snapshotFeedbackLocked) {
        snapshotFeedback.textContent = blocker ?? "Ready to save an economics snapshot.";
        snapshotFeedback.dataset.state = blocker ? "idle" : "ready";
      }
    };

    const setMoneyInputValue = (
      name: BrokerageEconomicsMoneyInputName,
      value: number | null
    ): void => {
      const input = moneyInputs.get(name);

      if (!input) return;

      input.value = value === null ? "" : String(value);
    };

    const clearLoadedLeadContext = (): void => {
      loadedLeadId = null;
      loadedLeadModelContext = null;
      contextLabel.textContent = "";
      contextLabel.hidden = true;
    };

    const resetCalculator = (): void => {
      referenceInput.value = "";
      moneyInputs.forEach((input) => {
        input.value = "";
      });
      snapshotNote.value = "";
      snapshotFeedbackLocked = false;
      clearLoadedLeadContext();
      renderEconomics();
    };

    const loadLeadIntoCalculator = (record: LeadSubmissionRecord): void => {
      if (!record.id) {
        loadedLeadId = null;
        loadedLeadModelContext = null;
        snapshotFeedbackLocked = true;
        snapshotFeedback.textContent = "This lead cannot be analyzed because it is missing an identifier.";
        snapshotFeedback.dataset.state = "error";
        updateSnapshotSaveState();
        return;
      }

      const mappedLead = createLeadEconomicsWorkspaceInput(record);

      loadedLeadId = record.id;
      loadedLeadModelContext = record.payload ?? null;
      referenceInput.value = mappedLead.economicsInput.reference;
      setMoneyInputValue("purchasePrice", mappedLead.economicsInput.purchasePrice);
      setMoneyInputValue(
        "estimatedMarketValue",
        mappedLead.economicsInput.estimatedMarketValue
      );
      snapshotNote.value = "";
      snapshotFeedbackLocked = false;
      contextLabel.textContent = `Analyzing: ${mappedLead.contextLabel}`;
      contextLabel.hidden = false;
      renderEconomics();
      panel.scrollIntoView({ behavior: "smooth", block: "start" });
      referenceInput.focus({ preventScroll: true });
    };

    const renderEconomics = (): void => {
      const economics = buildBrokerageEconomics(getCalculatorInput());

      brokerageEconomicsOutputFields.forEach(({ name, format }) => {
        const target = outputTargets.get(name);

        if (!target) return;

        target.textContent = formatBrokerageEconomicsOutput(
          economics,
          name,
          format
        );

        if (format === "recommendation") {
          target.dataset.recommendation = economics.recommendation;
          delete target.dataset.tone;
          return;
        }

        target.dataset.tone = getBrokerageValueTone(
          economics[name] as number | null
        );
        delete target.dataset.recommendation;
      });

      const riskAnalysis = buildBrokerageEconomicsRiskAnalysis({
        baseExpectedProfit: economics.netProfit,
        modelContext: loadedLeadModelContext
          ? {
              ...loadedLeadModelContext,
              reference:
                economics.reference || loadedLeadModelContext.reference,
            }
          : null,
      });
      const moderateContingencyLabel = formatContingencyAmount(
        riskAnalysis.moderateContingencyAmount
      );
      const severeContingencyLabel = formatContingencyAmount(
        riskAnalysis.severeContingencyAmount
      );

      riskView.hidden =
        riskAnalysis.serviceExposureClassification === "incomplete";
      moderateRiskMetric.metricLabel.textContent =
        `Profit after ${moderateContingencyLabel} contingency`;
      severeRiskMetric.metricLabel.textContent =
        `Profit after ${severeContingencyLabel} contingency`;
      baseRiskMetric.metricValue.textContent = formatBrokerageCurrency(
        riskAnalysis.baseExpectedProfit
      );
      moderateRiskMetric.metricValue.textContent = formatBrokerageCurrency(
        riskAnalysis.profitAfterModerateContingency
      );
      severeRiskMetric.metricValue.textContent = formatBrokerageCurrency(
        riskAnalysis.profitAfterSevereContingency
      );
      classificationRiskMetric.metricValue.textContent =
        getServiceExposureLabel(
          riskAnalysis.serviceExposureClassification
        );
      classificationRiskMetric.metricValue.dataset.classification =
        riskAnalysis.serviceExposureClassification;
      baseRiskMetric.metricValue.dataset.tone = getBrokerageValueTone(
        riskAnalysis.baseExpectedProfit
      );
      moderateRiskMetric.metricValue.dataset.tone = getBrokerageValueTone(
        riskAnalysis.profitAfterModerateContingency
      );
      severeRiskMetric.metricValue.dataset.tone = getBrokerageValueTone(
        riskAnalysis.profitAfterSevereContingency
      );
      riskExplanation.textContent = riskAnalysis.explanation;

      if (riskAnalysis.modelCaution && riskAnalysis.thinMarginModel) {
        riskModelCaution.hidden = false;
        riskModelCaution.textContent =
          `Model caution — ${riskAnalysis.thinMarginModel.label}: confirm service, polishing, shipping, and condition exposure before proceeding.`;
      } else {
        riskModelCaution.hidden = true;
        riskModelCaution.textContent = "";
      }

      updateSnapshotSaveState();
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
    });
    form.addEventListener("input", () => {
      snapshotFeedbackLocked = false;
      renderEconomics();
    });
    resetButton.addEventListener("click", () => {
      resetCalculator();
      referenceInput.focus();
    });
    saveSnapshotButton.addEventListener("click", async () => {
      const blocker = getSnapshotSaveBlocker();

      if (blocker || !loadedLeadId) {
        snapshotFeedbackLocked = true;
        snapshotFeedback.textContent = blocker ?? "Load a lead before saving.";
        snapshotFeedback.dataset.state = "error";
        updateSnapshotSaveState();
        return;
      }

      isSavingSnapshot = true;
      snapshotFeedbackLocked = true;
      snapshotFeedback.textContent = "Saving economics snapshot...";
      snapshotFeedback.dataset.state = "saving";
      updateSnapshotSaveState();

      try {
        const updatedLead = await saveLeadEconomicsSnapshot(
          loadedLeadId,
          getCalculatorInput(),
          snapshotNote.value
        );

        replaceLeadRecord(updatedLead);
        applyFilters();
        snapshotNote.value = "";
        snapshotFeedback.textContent = "Economics snapshot saved.";
        snapshotFeedback.dataset.state = "success";
      } catch (error) {
        snapshotFeedback.textContent =
          error instanceof Error
            ? error.message
            : "Unable to save economics snapshot.";
        snapshotFeedback.dataset.state = "error";
      } finally {
        isSavingSnapshot = false;
        updateSnapshotSaveState();
      }
    });
    headingText.append(eyebrow, title);
    heading.append(headingText, description);
    actionRow.append(contextLabel, resetButton);
    snapshotNoteLabel.append(snapshotNote);
    snapshotActionRow.append(saveSnapshotButton, snapshotFeedback);
    snapshotActions.append(snapshotNoteLabel, snapshotActionRow);
    form.append(
      actionRow,
      referenceField,
      inputsGrid,
      results,
      riskView,
      snapshotActions
    );
    panel.append(heading, form);
    brokerageEconomicsWorkspaceController = Object.freeze({
      loadLead: loadLeadIntoCalculator,
      reset: resetCalculator,
    });
    renderEconomics();

    return panel;
  };
  const getApiErrorMessage = (
    responseBody: unknown,
    fallbackMessage: string
  ): string => {
    if (
      isRecord(responseBody) &&
      typeof responseBody.error === "string" &&
      responseBody.error.trim()
    ) {
      return responseBody.error;
    }

    return fallbackMessage;
  };

  const updateLeadStatus = async (
    id: string,
    status: LeadStatus
  ): Promise<LeadSubmissionRecord> => {
    const response = await fetch(buildBrokerApiUrl("/api/broker/leads/status"), {
      method: "POST",
      headers: createBrokerApiHeaders({
        "Content-Type": "application/json",
        Accept: "application/json",
      }),
      body: JSON.stringify({ id, status }),
    });
    let responseBody: unknown = {};

    try {
      responseBody = await response.json();
    } catch {
      responseBody = {};
    }

    if (!response.ok) {
      throw new Error(
        getApiErrorMessage(
          responseBody,
          `Status update failed with ${response.status}.`
        )
      );
    }

    if (!isRecord(responseBody) || !isRecord(responseBody.lead)) {
      throw new Error("Status update returned an unexpected response.");
    }

    return responseBody.lead as LeadSubmissionRecord;
  };

