  ): string => {
    if (format === "recommendation") {
      return getBrokerageRecommendationLabel(economics.recommendation);
    }

    const value = economics[name];

    return format === "percent"
      ? formatBrokeragePercent(value as number | null)
      : formatBrokerageCurrency(value as number | null);
  };

