---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Begin Your Quest | Quest Luxo" description="Request private watch sourcing, a sale, trade or valuation. Share your reference, budget and timing with Quest Luxo Luxury Advisory." canonicalPath="/begin-your-quest">
  <main id="main-content" class="quest-page">
    <section class="hero">
      <p class="eyebrow">Private Sourcing</p>
      <h1>Begin Your Quest</h1>
      <p>
        Tell Quest Luxo what you want sourced. A broker will review your request
        and confirm your requirements, quoted watch price, and sourcing timeline.
        Active sourcing begins after we receive your signed sourcing agreement
        and 10% deposit.
      </p>
    </section>

    <section class="form-panel">
      <section
        class="context-panel"
        data-brokerage-context
        hidden
        aria-live="polite"
      >
        <p class="eyebrow">Brokerage Context</p>
        <p data-brokerage-message></p>
      </section>

      <form class="lead-form" data-lead-capture-form novalidate>
        <div class="form-intro">
          <p class="eyebrow">Brokerage Intake</p>
          <h2>Tell us where to begin.</h2>
          <p>
            Share the essentials and a Quest Luxo broker will review your request
            and follow up with the next steps. Buying for a gift or milestone? Include your needed-by date, delivery region and whether your timing is flexible. Availability and delivery are confirmed before any commitment.
          </p>
          <p class="required-note">Full name and email are required. All other fields are optional.</p>
        </div>

        <div class="form-grid">
          <label>
            Full Name <span>*</span>
            <input
              type="text"
              name="name"
              placeholder="Your full name"
              autocomplete="name"
              required
            />
          </label>

          <label>
            Email <span>*</span>
            <input
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </label>

          <label>
            Phone
            <input
              type="tel"
              name="phone"
              placeholder="Your phone number"
              autocomplete="tel"
            />
          </label>

          <label>
            Desired Watch
            <input
              type="text"
              name="desiredWatch"
              placeholder="Example: Omega Speedmaster Silver Snoopy"
            />
          </label>

          <label>
            Budget Range
            <select name="budget">
              <option value="">Select a budget range</option>
              <option>Under $10,000</option>
              <option>$10k&ndash;20k</option>
              <option>$20k&ndash;50k</option>
              <option>$50k&ndash;100k</option>
              <option>$100k+</option>
              <option>Prefer not to say</option>
            </select>
          </label>

          <label>
            Timeline
            <select name="timeline">
              <option value="">Select a timeline</option>
              <option>Immediately</option>
              <option>Within 30 days</option>
              <option>1&ndash;3 months</option>
              <option>3&ndash;6 months</option>
              <option>Just researching</option>
            </select>
          </label>
        </div>

        <label>
          Message
          <textarea
            name="message"
            placeholder="Preferred configuration, condition, box/papers, trade or valuation details. For a gift: needed-by date, delivery region and timing flexibility."
          ></textarea>
        </label>

        <section class="sourcing-terms" aria-labelledby="sourcing-terms-title">
          <h3 id="sourcing-terms-title">Activating your sourcing request</h3>
          <p>Submitting this form starts an inquiry. Your sourcing request becomes active only after Quest Luxo receives your signed sourcing agreement and a deposit of 10% of the quoted watch price. The deposit is credited in full toward your final invoice if the transaction closes.</p>
          <p>Deposit return and cancellation terms are confirmed in the written sourcing agreement. <a href="/faq#faq">Review our sourcing and deposit terms</a>.</p>
        </section>

        <p id="quest-form-error" class="form-message form-message--error" data-lead-error role="alert" aria-atomic="true" tabindex="-1" hidden></p>
        <p class="form-message form-message--success" data-lead-success role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden></p>

        <button type="submit" data-lead-submit>Begin My Quest</button>
      </form>
    </section>
  </main>
</BaseLayout>

<style>
  .quest-page {
    background: #07111f;
    color: #ffffff;
    min-height: 100vh;
  }

  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 110px 24px 48px;
  }

  .eyebrow {
    color: #f0d7a0;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 18px;
  }

  h1 {
    font-size: clamp(54px, 9vw, 108px);
    line-height: 0.92;
    margin: 0 0 28px;
  }

  h2 {
    color: #173a5e;
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1;
    margin: 0 0 18px;
  }

  .hero p {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.74);
    font-size: 20px;
    line-height: 1.7;
  }

  .form-panel {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px 100px;
  }

  .context-panel {
    margin: 0 0 24px;
    padding: 24px;
    border: 1px solid rgba(212, 176, 106, 0.34);
    background: rgba(255, 255, 255, 0.055);
  }

  .context-panel[hidden] {
    display: none;
  }

  .context-panel p:last-child {
    color: rgba(255, 255, 255, 0.82);
    font-size: 20px;
    line-height: 1.6;
    margin: 0;
  }

  .lead-form {
    background: #faf9f7;
    color: #173a5e;
    border: 1px solid #e8e3d8;
    padding: 36px;
    display: grid;
    gap: 22px;
  }

  .form-intro {
    max-width: 720px;
  }

  .form-intro p:not(.eyebrow) {
    color: #4e5661;
    font-size: 18px;
    line-height: 1.7;
    margin: 0;
  }

  .form-intro .required-note {
    font-size: 14px;
    margin-top: 12px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  label {
    display: grid;
    gap: 8px;
    font-weight: 800;
  }

  label span {
    color: #b18b3f;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid #d8d1c3;
    background: #ffffff;
    color: #173a5e;
    padding: 14px;
    font: inherit;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #f0d7a0;
    outline: 3px solid #173a5e;
    outline-offset: 2px;
  }

  input[aria-invalid="true"] {
    border-color: #7b2417;
  }

  textarea {
    min-height: 150px;
    resize: vertical;
  }

  .sourcing-terms {
    border: 1px solid #d8d1c3;
    background: #ffffff;
    padding: 20px;
  }

  .sourcing-terms h3 {
    font-size: 20px;
    margin: 0 0 12px;
  }

  .sourcing-terms p {
    color: #4e5661;
    font-size: 16px;
    line-height: 1.65;
    margin: 0 0 12px;
  }

  .sourcing-terms p:last-child { margin-bottom: 0; }
  .sourcing-terms a { color: #173a5e; text-underline-offset: 3px; }
  .sourcing-terms a:focus-visible { outline: 3px solid #173a5e; outline-offset: 3px; }

  .form-message {
    border: 1px solid;
    line-height: 1.55;
    margin: 0;
    padding: 14px 16px;
  }

  .form-message[hidden] {
    display: none;
  }

  .form-message--error {
    background: #fff3f0;
    border-color: #d9a092;
    color: #7b2417;
  }

  .form-message--success {
    background: #f3f8ef;
    border-color: #a7c58d;
    color: #31501e;
  }

  button {
    background: #d4b06a;
    color: #07111f;
    border: 0;
    padding: 16px 22px;
    font-weight: 900;
    cursor: pointer;
  }

  button:hover {
    background: #c6a05b;
  }

  button:focus-visible,
  .form-message:focus-visible {
    outline: 3px solid #173a5e;
    outline-offset: 3px;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 76px;
    }

    .lead-form {
      padding: 26px;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import {
    createLeadContextSummary,
    createLeadIntakeContext,
    hasMeaningfulLeadContext,
  } from "../lib/leads/leadIntakeContext";
  import {
    createLeadCapturePayload,
    hasRequiredLeadContactFields,
  } from "../lib/leads/leadCapture.ts";

  const contextPanel = document.querySelector<HTMLElement>(
    "[data-brokerage-context]"
  );
  const messageTarget = document.querySelector<HTMLElement>(
    "[data-brokerage-message]"
  );
  const form = document.querySelector<HTMLFormElement>(
    "[data-lead-capture-form]"
  );
  const errorTarget = document.querySelector<HTMLElement>("[data-lead-error]");
  const successTarget =
    document.querySelector<HTMLElement>("[data-lead-success]");
  const submitButton =
    document.querySelector<HTMLButtonElement>("[data-lead-submit]");
  const defaultSubmitText = submitButton?.textContent || "Begin My Quest";
  const nameInput = form?.querySelector<HTMLInputElement>('input[name="name"]');
  const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
  let submitting = false;

  const params = new URLSearchParams(window.location.search);
  const leadContext = createLeadIntakeContext({
    intent: params.get("intent"),
    brand: params.get("brand"),
    collection: params.get("collection"),
    reference: params.get("reference"),
  });

  const hasContext = hasMeaningfulLeadContext(leadContext);
  const message = hasContext ? createLeadContextSummary(leadContext) : "";

  if (contextPanel && messageTarget && hasContext && message) {
    messageTarget.textContent = message;
    contextPanel.hidden = false;
  }

  const getFormValue = (formData: FormData, fieldName: string): string => {
    const value = formData.get(fieldName);

    return typeof value === "string" ? value : "";
  };

  const setSubmitting = (isSubmitting: boolean): void => {
    submitting = isSubmitting;
    form?.setAttribute("aria-busy", String(isSubmitting));
    if (!submitButton) return;

    submitButton.disabled = isSubmitting;
    submitButton.textContent = isSubmitting
      ? "Submitting..."
      : defaultSubmitText;
  };

  const showError = (message: string, invalidField?: HTMLInputElement): void => {
    if (successTarget) {
      successTarget.hidden = true;
    }

    if (errorTarget) {
      errorTarget.textContent = message;
      errorTarget.hidden = false;
      if (invalidField) {
        invalidField.setAttribute("aria-invalid", "true");
        invalidField.setAttribute("aria-describedby", errorTarget.id);
        invalidField.focus();
      } else {
        errorTarget.focus();
      }
    }
  };

  const showSuccess = (message: string): void => {
    if (errorTarget) {
      errorTarget.hidden = true;
    }

    if (successTarget) {
      successTarget.textContent = message;
      successTarget.hidden = false;
      successTarget.focus();
    }
  };

  const parseJsonResponse = async (response: Response): Promise<unknown> => {
    try {
      return await response.json();
    } catch {
      return {};
    }
  };

  const isResponseRecord = (value: unknown): value is Record<string, unknown> =>
    typeof value === "object" && value !== null;

  const getResponseError = (responseBody: unknown): string => {
    if (
      isResponseRecord(responseBody) &&
      "error" in responseBody &&
      typeof responseBody.error === "string"
    ) {
      return responseBody.error;
    }

    return "We could not submit your request. Please try again.";
  };

  const hasSuccessfulResponse = (responseBody: unknown): boolean =>
    Boolean(
      isResponseRecord(responseBody) &&
        "success" in responseBody &&
        responseBody.success === true
    );

  if (form) {
    for (const input of [nameInput, emailInput]) {
      input?.addEventListener("input", () => {
        if (input.getAttribute("aria-invalid") !== "true") return;
        input.removeAttribute("aria-invalid");
        input.removeAttribute("aria-describedby");
        if (errorTarget) errorTarget.hidden = true;
      });
    }
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting) return;
      if (errorTarget) errorTarget.hidden = true;
      if (successTarget) successTarget.hidden = true;

      for (const input of [nameInput, emailInput]) {
        input?.removeAttribute("aria-invalid");
        input?.removeAttribute("aria-describedby");
      }

      const formData = new FormData(form);
      const payload = createLeadCapturePayload({
        name: getFormValue(formData, "name"),
        email: getFormValue(formData, "email"),
        phone: getFormValue(formData, "phone"),
        intent: leadContext.intent,
        brand: leadContext.brand,
        collection: leadContext.collection,
        reference: leadContext.reference,
        desiredWatch: getFormValue(formData, "desiredWatch"),
        budget: getFormValue(formData, "budget"),
        timeline: getFormValue(formData, "timeline"),
        message: getFormValue(formData, "message"),
        source: "begin-your-quest",
      });

      if (!hasRequiredLeadContactFields(payload)) {
        showError(
          !payload.name ? "Please enter your full name." : "Please enter a valid email address.",
          (!payload.name ? nameInput : emailInput) ?? undefined
        );

        return;
      }

      setSubmitting(true);

      try {
        const response = await fetch("/api/leads/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });
        const responseBody = await parseJsonResponse(response);

        if (!response.ok || !hasSuccessfulResponse(responseBody)) {
          throw new Error(getResponseError(responseBody));
        }

        showSuccess(
          "Your request has been received. A Quest Luxo broker will review it and confirm next steps. Your sourcing request becomes active only after we receive your signed sourcing agreement and a deposit of 10% of the quoted watch price."
        );
        window.dispatchEvent(new Event("questluxo:lead-submitted"));
      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : "We could not submit your request. Please try again."
        );
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>
