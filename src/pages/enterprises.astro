---
import BaseLayout from "../layouts/BaseLayout.astro";

const businesses = [
  {
    number: "01",
    name: "Luxury Advisory",
    focus: "Luxury timepieces",
    description: "Private luxury watch advisory and sourcing for collectors. Explore our watch collections or begin a personal sourcing inquiry.",
    href: "https://questluxo.com",
    link: "Explore Luxury Advisory",
  },
  {
    number: "02",
    name: "Capital Advisory",
    focus: "Business funding & factoring",
    description: "Explore business funding and factoring opportunities with Quest Luxo Capital Advisory. Start with your business needs and capital objectives.",
    href: "https://capital.questluxo.com",
    link: "Explore Capital Advisory",
  },
  {
    number: "03",
    name: "Property Acquisitions",
    focus: "Direct property & land buying",
    description: "Connect with Quest Luxo about selling property or land directly, including mobile homes and mobile home parks.",
    href: "https://realty.questluxo.com",
    link: "Explore Property Acquisitions",
  },
];
---

<BaseLayout
  title="Quest Luxo Enterprises | Three Businesses. One Destination."
  description="Connect with Quest Luxo Luxury Advisory, Capital Advisory and Property Acquisitions. Luxury watches, business funding and factoring, and direct property and land buying."
  canonicalUrl="https://questluxo.com/enterprises"
>
  <main id="main-content" class="enterprises-hub">
    <header class="hub-intro">
      <p class="eyebrow">Three businesses. One destination.</p>
      <h1>Quest Luxo <span>Enterprises</span></h1>
      <p class="intro">Luxury timepieces. Business capital. Property acquisitions.</p>
      <p class="direction">Choose the business that fits your next move.</p>
    </header>

    <section class="businesses" aria-label="Quest Luxo businesses">
      {businesses.map((business) => (
        <article class="business-card">
          <p class="business-number" aria-hidden="true">{business.number}</p>
          <h2>{business.name}</h2>
          <p class="business-focus">{business.focus}</p>
          <p class="business-description">{business.description}</p>
          <div class="business-links">
            <a class="business-link" href={business.href}>{business.link}<span aria-hidden="true"> &rarr;</span></a>
            {business.number === "01" && <a class="quest-link" href="https://questluxo.com/begin-your-quest">Begin Your Quest</a>}
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .enterprises-hub { padding: 96px 28px 88px; background: #faf9f7; color: #173a5e; }
  .hub-intro, .businesses { max-width: 1180px; margin-inline: auto; }
  .hub-intro { margin-bottom: 48px; }
  .eyebrow { margin: 0 0 20px; color: #806027; font-size: 12px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; }
  h1 { margin: 0 0 24px; max-width: 900px; font-size: clamp(46px, 7vw, 86px); line-height: 1.02; font-weight: 500; }
  h1 span { display: block; }
  .intro { max-width: 760px; margin: 0 0 12px; color: #173a5e; font-size: clamp(20px, 3vw, 26px); line-height: 1.5; }
  .direction { margin: 0; color: #52606f; font-size: 17px; line-height: 1.6; }
  .businesses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .business-card { display: flex; flex-direction: column; padding: 30px; border: 1px solid #e0d9cc; border-top: 3px solid #d4b06a; background: #fff; }
  .business-number { margin: 0 0 24px; color: #806027; font-size: 12px; letter-spacing: 0.16em; font-weight: 800; }
  h2 { margin: 0 0 16px; font-size: clamp(28px, 3vw, 34px); line-height: 1.15; font-weight: 500; }
  .business-focus { margin: 0 0 16px; color: #173a5e; font-size: 15px; font-weight: 800; line-height: 1.5; }
  .business-description { margin: 0 0 28px; color: #52606f; font-size: 16px; line-height: 1.7; }
  .business-links { display: grid; gap: 10px; margin-top: auto; }
  .business-link, .quest-link { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; color: #173a5e; font-size: 15px; font-weight: 800; line-height: 1.5; text-underline-offset: 4px; }
  .business-link span { margin-left: 8px; }
  .quest-link { font-weight: 500; }
  a:hover { color: #806027; }
  @media (max-width: 900px) {
    .businesses { grid-template-columns: 1fr; }
    .business-card { padding: 26px; }
    .business-number { margin-bottom: 16px; }
  }
  @media (max-width: 520px) {
    .enterprises-hub { padding: 64px 22px; }
    .hub-intro { margin-bottom: 32px; }
    h1 { font-size: clamp(42px, 11.5vw, 54px); }
  }
</style>
