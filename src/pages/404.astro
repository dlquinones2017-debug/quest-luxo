---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Quest Luxo"
  description="The requested Quest Luxo page could not be found."
  canonicalPath="/404"
  robots="noindex,follow"
>
  <main id="main-content">
    <section class="not-found">
      <p class="eyebrow">404 · ROUTE NOT FOUND</p>
      <h1>This path is not in the collection directory.</h1>
      <p>
        Return to the unified watch-house directory or begin a private sourcing
        conversation.
      </p>
      <div class="actions">
        <a href="/#collections">Explore Collections</a>
        <a href="/contact">Begin Your Quest</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 62vh;
    padding: 130px 30px;
    text-align: center;
    background: #faf9f7;
  }

  .eyebrow {
    color: var(--color-accent-text);
    letter-spacing: 4px;
    font-size: 12px;
    font-weight: 800;
  }

  h1 {
    max-width: 820px;
    margin: 22px auto;
    color: #173a5e;
    font-size: clamp(42px, 7vw, 68px);
    line-height: 1.08;
  }

  .not-found > p:not(.eyebrow) {
    max-width: 680px;
    margin: 0 auto;
    color: #4e5661;
    font-size: 19px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .actions a {
    padding: 15px 24px;
    color: #ffffff;
    background: #173a5e;
    text-decoration: none;
    font-weight: 800;
  }
</style>
