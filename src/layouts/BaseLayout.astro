---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  socialImagePath?: string;
}

const {
  title = "Quest Luxo",
  description = "Quest Luxo provides private luxury timepiece advisory, collection intelligence, and discreet global sourcing.",
  canonicalPath = Astro.url.pathname,
  structuredData,
  robots = "index,follow",
  socialImagePath = "/images/quest-luxo-logo.webp",
} = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL(socialImagePath, siteUrl);
const analyticsPage = canonicalPath === "/" ? "home" : canonicalPath;
const organizationId = new URL("/#organization", siteUrl).href;
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": organizationId,
    name: "Quest Luxo",
    url: new URL("/", siteUrl).href,
    logo: new URL("/images/quest-luxo-logo.webp", siteUrl).href,
    email: "contact@questluxo.com",
    description:
      "Independent private luxury timepiece advisory and global sourcing.",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": new URL("/#website", siteUrl).href,
    name: "Quest Luxo",
    url: new URL("/", siteUrl).href,
    publisher: { "@id": organizationId },
  },
];
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const completeStructuredData = [...baseStructuredData, ...pageStructuredData];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#07111f" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Quest Luxo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Quest Luxo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(completeStructuredData).replace(/</g, "\\u003c")}
    />
  </head>

  <body data-analytics-page={analyticsPage}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --color-navy: #173a5e;
    --color-ink: #1f2933;
    --color-muted: #4e5b67;
    --color-accent: #d4b06a;
    --color-accent-text: #76540f;
    font-family: Arial, Helvetica, sans-serif;
    font-synthesis: none;
  }

  html {
    text-size-adjust: 100%;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    color: var(--color-ink);
    background: #ffffff;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  img,
  svg {
    max-width: 100%;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 12px;
    left: 12px;
    padding: 12px 16px;
    color: #ffffff;
    background: #173a5e;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  :focus-visible {
    outline: 3px solid #8a682b;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
