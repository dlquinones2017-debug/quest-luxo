---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  socialImagePath?: string;
}

const {
  title = "Quest Luxo",
  description = "Private luxury timepiece sourcing, brokerage, and acquisition advisory for discerning collectors.",
  canonicalUrl,
  canonicalPath,
  structuredData,
  robots = "index,follow",
  socialImagePath = "/images/quest-luxo-logo.webp",
} = Astro.props as Props;

const siteUrl = Astro.site ?? Astro.url.origin;
const resolvedCanonicalUrl = canonicalUrl ?? new URL(canonicalPath ?? Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(socialImagePath, siteUrl).href;
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07111f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quest Luxo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {pageStructuredData.map((entry) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(entry).replace(/</g, "\\u003c")} />
    ))}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ql-ink: #07111f;
    --ql-navy: #173a5e;
    --ql-gold: #d4b06a;
    --ql-paper: #faf9f7;
    --ql-line: #e8e3d8;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    background: var(--ql-paper);
    color: var(--ql-ink);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    text-wrap: balance;
  }

  img {
    max-width: 100%;
  }

  a,
  button,
  input,
  select,
  textarea {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 2px solid var(--ql-gold);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 1000;
    transform: translateY(-160%);
    background: #ffffff;
    color: var(--ql-ink);
    padding: 12px 16px;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
