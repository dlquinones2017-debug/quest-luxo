# Public origin used for canonical URLs and same-origin lead validation.
SITE_URL=https://www.questluxo.com
NODE_ENV=production

# Persistent Render disk mount. Must be absolute in production.
LEAD_STORAGE_DIRECTORY=/var/data/quest-luxo

# Resend-compatible email delivery.
EMAIL_PROVIDER_API_URL=https://api.resend.com/emails
EMAIL_PROVIDER_API_KEY=
LEAD_EMAIL_FROM=Quest Luxo <inquiries@questluxo.com>
LEAD_EMAIL_TO=contact@questluxo.com
PUBLIC_CONTACT_EMAIL=contact@questluxo.com

# Generate at least 32 random characters. Used only to hash abuse identifiers.
LEAD_ABUSE_HASH_SECRET=
